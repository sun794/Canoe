variables
{
  //通用定义
  int TestNoAnwser;
  enum AddressMode{FunctionalAddress, PhysicalAddress};
  enum SuppressBitFlag{SuppressBitOff=0, SuppressBitOn=1};
  enum DiagResult{DiagOK, DiagRxTimeout, DiagRxPending,DiagRxNegResponse, DiagRxPendingOver, DiagTxError, DiagRxError, DiagPramError, DiagGeneralError,UnKnownErr}; 
  
  //发送接收完成时间
  float TxTime, RxTime;
  int ReturnLen;
  
  //发送接收数据
  byte DiagTxData[0x10000];
  byte DiagRxData[0x10000];
  int DiagTxDataLen;
  int DiagRxDataLen;
  byte CurrentSubFuc;//用来存储带子功能的诊断请求发送的子功能
  byte NCheckSubFuc=0;//需要校验子功能的使能
  //10服务
  enum SessionType{DefaultSession=1, ProgrammingSession=2, ExtendedSession=3,FotaSession=0x42};
  //11服务
  enum ResetType{HardReset=1, KeyOffOnReset=2, SoftReset=3};
  //31服务
  enum RoutineControlType {StartRoutine=1, StopRoutine=2, RequestRoutineResults=3};

  //85服务
  enum DTCSettingType{DtcOn=1, DtcOff=2};
  
  //28服务
  enum CommunicationControlType{EnableRxTx=0, EnableRxDisableTx=1, DisableRxEnableTx=2, DisableRxTx=3};
  enum CommunicationType{NCM=1, NWMCM=2, NWMCN_NCM=3};
  
  //3E服务
  
    //诊断响应事件
  char DiagResponseEvent[20] = "DiagResponseEvent";
  enum DiagResult DiagResponseResult;
  
} 
/// <Services>
enum DiagResult Service10_SessionControl(enum AddressMode addressMode, enum SessionType sessionType, enum SuppressBitFlag suppressBit)
{
  diagRequest UDS_Diagnostic_Services_Generic.DiagnosticSessionControl_Process request;
  byte sessionBytes[1];
  
    //初始化
  diagInitialize(request);
  NCheckSubFuc=1;//需要校验子功能
  //填充数据
  sessionBytes[0] = sessionType;
  CurrentSubFuc=sessionBytes[0];//获取子功能
  diagSetParameterRaw(request, "diagnosticSessionType", sessionBytes, elcount(sessionBytes));
  diagSetSuppressResp(request, suppressBit);
  
  //发送数据
  if(DiagSendData(addressMode, request)!=DiagOK)
    return DiagTxError;
  
  return DiagReceiveData(request);
}


