/// <Services>
enum DiagResult Service27_SecurityAccessSeed(enum AddressMode addressMode, byte securityAccessType, byte seedData[], byte seedDataLen)
{
  enum DiagResult result;
  diagRequest UDS_Diagnostic_Services_Generic.SecurityAccess_Process request;
  byte securityAccessTypeBytes[1];
  
  //初始化
  diagInitialize(request);
  
  //设置参数
  NCheckSubFuc=1;//需要校验子功能
  securityAccessTypeBytes[0] = securityAccessType;
  CurrentSubFuc= securityAccessTypeBytes[0];
  diagSetParameterRaw(request, "securityAccessType", securityAccessTypeBytes, elcount(securityAccessTypeBytes));
  
  //发送数据
  if(DiagSendData(addressMode, request)!=DiagOK)
    return DiagTxError;

  //接收数据
  result = DiagReceiveData(request);
  if(result == DiagOK)
  {
    diagResponse request response;
    diagGetLastResponse(request, response);
    diagGetParameterRaw(response, "securitySeed", seedData, seedDataLen);
  }
  return result; 
}

/// <Services>
enum DiagResult Service27_SecurityAccessKey(enum AddressMode addressMode, byte securityAccessType, byte keyData[], byte keyDataLen)
