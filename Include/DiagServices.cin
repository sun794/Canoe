/// <Services>
enum DiagResult Service34_RequestDownload(enum AddressMode addressMode, byte dataFormatIdentifier, byte addressAndLengthFormatIdentifier,dword dataAddress, dword dataSize, word &maxNumberOfBlockLen)
{
  enum DiagResult result;
  diagRequest UDS_Diagnostic_Services_Generic.RequestDownload_Process request;
  int addressLen, dataSizeLen;
  int counter;
  
  byte addressAndSizeBytes[8];
  
  //初始化
  diagInitialize(request);
  DiagTxDataLen=0;
  DiagRxDataLen=0;
  
  addressLen = addressAndLengthFormatIdentifier >> 4;
  dataSizeLen = addressAndLengthFormatIdentifier & 0xF;
  
  DiagSetPrimitiveByte(request, 1, dataFormatIdentifier);
  DiagSetPrimitiveByte(request, 2, addressAndLengthFormatIdentifier);
  
  for(counter=0; counter<addressLen; counter++)
  {
    addressAndSizeBytes[counter] = (dataAddress >> ((addressLen-counter-1)*8)) & 0xFF;
  }
  for(counter=0; counter<dataSizeLen; counter++)
  {
    addressAndSizeBytes[counter+addressLen] = (dataSize >> ((dataSizeLen-counter-1)*8)) & 0xFF;
  }
  
  diagSetParameterRaw(request, "memorySpecification", addressAndSizeBytes, addressLen+dataSizeLen);
  
  //发送数据
  if(DiagSendData(addressMode, request)!=DiagOK)
    return DiagTxError;
  //接收数据
  result = DiagReceiveData(request);
  if(result == DiagOK)
  {
    byte bytesLenBytes[1];
    byte bytesLen;
    byte maxNumberOfBlockLengthBytes[4];
    
    diagResponse request response;
    diagGetLastResponse(request, response);
    
    diagGetParameterRaw(response, "lengthFormatIdentifier", bytesLenBytes, 1);// 74 20 -> 2
    bytesLen = bytesLenBytes[0] >> 4;
    diagGetParameterRaw(response, "maxNumberOfBlockLength", maxNumberOfBlockLengthBytes, elcount(maxNumberOfBlockLengthBytes));
    
    maxNumberOfBlockLen = 0;
    for(counter=0;counter<bytesLen;counter++)
      maxNumberOfBlockLen = maxNumberOfBlockLen*0x100 + maxNumberOfBlockLengthBytes[counter];
  }
  return result;
}


/// <Services>
enum DiagResult Service36_TransferData(enum AddressMode addressMode, byte blockSequenceCounter, byte data[], word dataLen)
{
  enum DiagResult result;
  diagRequest UDS_Diagnostic_Services_Generic.TransferData_Process request;
  int i;
  
  //初始化
  diagInitialize(request);
  DiagTxDataLen=0;
  DiagRxDataLen=0;
  
  diagResize (request, 2+dataLen);
  NCheckSubFuc=1;//需要校验子功能
  CurrentSubFuc=blockSequenceCounter;//获取blockSequenceCounter
  DiagSetPrimitiveByte(request, 0, 0x36);
  DiagSetPrimitiveByte(request, 1, blockSequenceCounter);

  for(i=0;i<dataLen;i++)
  {
    DiagSetPrimitiveByte(request, 2+i, data[i]);
  }
  
  //发送数据
  if(DiagSendData(addressMode, request)!=DiagOK)
    return DiagTxError;
  //接收数据
  result = DiagReceiveData(request);
  return result;
}


