/// <Services>
enum DiagResult Service22_ReadDataByIdentifier(enum AddressMode addressMode, word did, byte didData[], int didDataLen)
{
  diagRequest UDS_Diagnostic_Services_Generic.ReadDataByIdentifier_Process request;
  enum DiagResult result;
  byte didBytes[2];
  
  //初始化
  diagInitialize(request);
  
  //设置参数
  didBytes[0] = did >> 8;
  didBytes[1] = did & 0xFF;
  diagSetParameterRaw(request, "dataIdentifier", didBytes, elcount(didBytes));
  
  //发送数据
  if(DiagSendData(addressMode, request)!=DiagOK)
    return DiagTxError;

  //接收数据
  result = DiagReceiveData(request);
  if(result == DiagOK)
  {
    diagResponse request response;
    diagGetLastResponse(request, response);
    diagGetParameterRaw(response, "Data", didData, didDataLen);//实测这个函数无法获取到ECU返回的Data数据和长度，因此长度用了下面diagGetParameterSizeCoded去获取
    //比较大的怀疑是这里didData和didDataLen没有定义一个实际大小，所以导致取不到值，参考安全算法获取key的demo示例，里面的种子和长度是提前声明大小的
    ReturnLen=diagGetParameterSizeCoded(response, "Data")/8;//这个函数获取的是这个Data参数的bit长度，所以转换成字节长度要除以8（注意这里长度不包括SID和DID3个字节）
    diagGetPrimitiveData(response,didData,didDataLen);//抽空试试用下面这个函数看能否获取ECU返回的全部数据(这里包括了SID和DID)
  
  }
  return result;
}

/// <Services>
enum DiagResult Service2E_WriteDataByIdentifier(enum AddressMode addressMode, word did, byte didData[], int didDataLen)
{
  diagRequest UDS_Diagnostic_Services_Generic.WriteDataByIdentifier_Process request;
  byte didBytes[2];
  
    //初始化
  diagInitialize(request);
  
  //设置参数
  didBytes[0] = did >> 8;
  didBytes[1] = did & 0xFF;
  diagSetParameterRaw(request, "dataIdentifier", didBytes, elcount(didBytes));
  diagSetParameterRaw(request, "dataRecord", didData, didDataLen);
  
  //发送数据
  if(DiagSendData(addressMode, request)!=DiagOK)
    return DiagTxError;

  //接收数据
  return DiagReceiveData(request);
}
