/// <Services>
enum DiagResult Service3E_RequestTestPresent(enum AddressMode addressMode,Enum SuppressBitFlag suppressBit)
{
  enum DiagResult result;
  byte SubFuncBytes[1];
  diagRequest UDS_Diagnostic_Services_Generic.TesterPresent_Process request;
  
  //初始化
