  return DiagReceiveData(request);
}

/// <DiagControl>
enum DiagResult DiagSendData(enum AddressMode addressMode, diagRequest* sendRequest)
{
  int ret;
 
  //获取发送的原始数据和长度，用于后续比较
  DiagTxDataLen = diagGetPrimitiveData(sendRequest, DiagTxData, elcount(DiagTxData));
  //发送数据
  ret = (addressMode==FunctionalAddress) ? diagsendFunctional(sendRequest) : diagSendRequest(sendRequest);
 
  testWaitForDiagRequestSent(sendRequest, 50);
  
  TxTime = TimeNowNS()/1000000000.0; 
  
  if(ret>=0)
    return DiagOK;
  else
    return DiagTxError;
}

/// <DiagControl>
enum DiagResult DiagReceiveData(diagRequest* sendRequest)
{
  int ret;
  enum DiagResult diagResult;
  int responseCode;
  
  //diagSetP2Extended(20*1000);
  suppressbit = diagGetSuppressResp(sendRequest);
 // ret = testWaitForDiagResponse(sendRequest, diagGetP2Extended());
  if(suppressbit==0)//如果非禁止肯定响应的
       ret = testWaitForDiagResponse(sendRequest,120000);//实际是5S超时退出了，后面的超时时间是留给收到NRC 78之后，允许在P2*+timeout时间内响应，不作为超时
  else
       ret=testWaitForDiagResponse(diagGetP2Timeout());
  
  //接收的时间
  RxTime = TimeNowNS()/1000000000.0; 
  
  if(ret==0)//等待超时，判别抑制位
  {
    if(suppressbit==0)
        diagResult = DiagRxTimeout;
    else
      diagResult = DiagOK;
  }
  else if(ret==1)//接收到响应,获取并判定数据结果
  {
    diagResponse sendRequest response;
    diagGetLastResponse(sendRequest, response);
    
    DiagRxDataLen = response.GetPrimitiveData(DiagRxData, elcount(DiagRxData));//GetPrimitiveData()函数返回的是诊断请求反馈的完整Raw数据
   
    
  
   // write("接收到响应, responseCode=%d, 数据：%02X %02X", responseCode, DiagRxData[0], DiagRxData[1]);
    responseCode = diagGetResponseCode (response);
    if(responseCode == -1)//如果是正响应，这里需要注意的是DiagRxPending(0x78)协议栈也判断为正反馈
     {
      if(DiagRxData[0]!=0x7F && DiagRxData[2]!=0x78 && NCheckSubFuc==1)//由于NRC 0x78也默认为正响应，这里需要排除
      {
       if(CurrentSubFuc!=DiagRxData[1])//如果请求带子功能，这里就需要校验ECU回复的子功能
      {
       testStepFail("诊断子功能校验","0x%02X 服务 -----> ECU回复的诊断子功能为0x%02X,而诊断仪请求的子功能为0x%02X",DiagRxData[0]-0x40,DiagRxData[1],CurrentSubFuc);
       write("0x%02X 服务 -----> ECU回复的诊断子功能为0x%02X,而诊断仪请求的子功能为0x%02X",DiagRxData[0]-0x40,DiagRxData[1],CurrentSubFuc);
      }
     else
     {
       //用于调试验证，后续可以关闭
      //write("0x%02X 服务 -----> ECU回复的诊断子功能为与诊断仪请求的子功能一致,皆为0x%02X",DiagRxData[0]-0x40,DiagRxData[1]);
     }
      }
      
      diagResult = DiagOK;
    }
    else if(responseCode > 0)//NRC
    {
      write("response NRC = 0x%02x",responseCode);
      //teststepFail("","response NRC= 0x%02x",responseCode);
      diagResult = DiagRxNegResponse;}
    else//没有接收到响应
    {
      write("Request No Response!");
     // teststepFail("Request No Response!");
      diagResult = DiagRxTimeout;
    }
  }
  else  // Internal or setup error
  {
    //后面可修改成未知错误
    diagResult = DiagRxTimeout;
   
  }
  
  CurrentSubFuc=0;//初始化标志位
  NCheckSubFuc=0;//初始化标志位
  
  
  return diagResult;
}
