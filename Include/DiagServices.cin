/// <Services>
enum DiagResult Service31_RoutineControl(enum AddressMode addressMode, enum RoutineControlType routineControlType, word routineId, byte routineData[], word routineDataLen)
{
  diagRequest UDS_Diagnostic_Services_Generic.RoutineControl_Process request;
  byte routineControlTypeBytes[1];
  byte routineIdBytes[2];
  enum DiagResult result;
  
  //初始化
  diagInitialize(request);
  NCheckSubFuc=1;//需要校验子功能
  routineControlTypeBytes[0] = routineControlType;
  CurrentSubFuc=  routineControlTypeBytes[0];
  write("CurrentSubFuc==%x",CurrentSubFuc);
  routineIdBytes[0] = routineId >> 8;
  routineIdBytes[1] = routineId & 0xFF;
  
  //填充数据
  diagSetParameterRaw(request, "routineControlType", routineControlTypeBytes, elcount(routineControlTypeBytes));
  diagSetParameterRaw(request, "Routine_Identfier", routineIdBytes, elcount(routineIdBytes));
  
  if(routineDataLen > 0)
  {
    diagSetParameterRaw(request, "routineControlOptionRecord", routineData, routineDataLen);
   // write("routineDataLen=%d",routineDataLen);   
  }
  //发送数据
  if(DiagSendData(addressMode, request)!=DiagOK)
    return DiagTxError;
  if(TestNoAnwser)
  {
     testWaitForTimeout(200);//发送成功后就先等待一下
  }
  return DiagReceiveData(request);
  
