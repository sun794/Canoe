}
 
float AtoF(byte buffer[], dword len)//将串口byte信息转换为浮点数本质上就是getData+=float(buffer++);
{
  double getData;
  dword i;
  byte flag;
  dword per;
  
  getData = 0;//static
  per=1;//static
  flag=0;//static
  
  for(i=0; i<len; i++)
  {
    if('0'<=buffer[i] && buffer[i]<='9')//
    {
      getData*=10;//这里每循环增加一个字符，就进一位，直到遇到.
      getData+=(buffer[i]-0x30);//没有强制转换的话，通过2个值计算可以直接内部转换为优先级更高的浮点数                 //这个我认为理论上为float(buff[i]的算法) 一个通过计算一个利用功能直接强转换//这里-0x30实际上因为转换为byte后，需要减去'0'才能得到整形，举例，单字符'1'-'0'=1（十进制），然后浮点就看小数点在第几位了，这个处理比直接转换，数据容易失真好，如果一个浮点变成整形，那么将是直接去掉小数点后的值，而不是想x10的倍数后再变整形   ，如果一个整形变浮点数也是不能先移小数点，然后再转，一定先转了再除以倍数 
      if(flag)//1就执行自乘10倍
      {
        per*=10;//这里就是遇到小数点就开始处于10的n次方，这个算法是计算小数点的方式，第一次x10 再除以10等于增加一位但是没有进一，所以为小数点后，第二次x10小数点先右移一位，然后又除以100，左移2位，结果是比原来再多左移一位，即精度0.01，依次类推
      }                
    }
    else if(buffer[i]=='.')
    {
      flag=1;
    }   
  }
  
  getData/=per;//直到遇到了点，那么从点开始，后面每增加一个字符，从那个字符开始就缩小10倍，即小数点左移1位，2个就移2位，如a.bc=a+0.bc
 
  return getData;
}

word usMBCRC16(byte src[], int srclen)
{
  byte    ucCRCHi;
  byte    ucCRCLo;
  byte    iIndex;
  int i;
  i=0;//初始化一下
  iIndex=0;
  ucCRCHi = 0xFF;
  ucCRCLo = 0xFF;
	
   while ( srclen-- )
    {
        iIndex = ucCRCLo ^ src[i++];
        ucCRCLo =  ucCRCHi ^ aucCRCHi[iIndex];
        ucCRCHi = aucCRCLo[iIndex];
    }
    return(word)(ucCRCHi << 8 | ucCRCLo);
}



byte SendAndRead(byte port,byte src[],int srclen)
{
	byte n;
  DP_SendByte(port,src,srclen);
	//write("Sending %d bytes...",srclen);
	for(n=0;n<srclen;n++)
	{
	//	write("0x%02X ",src[n]);
	}

	return 1;
}
//控制继电器输出，导通 io:1为通道1';2为通道2
int OpenDO(int addr,int io,byte src[])
{
	int index;
  word crc;
  index =0;
	src[index++] = addr;
	src[index++] = 0x05;
	src[index++] = 0x00;
	src[index++] = io-1;//端口
	src[index++] = 0xff;//导通
	src[index++] = 0x00;
  

  crc = usMBCRC16(src,index);
	src[index++]  = crc&0xff;
	src[index++]  = crc>>8;
	return index;
}
int CloseDO(int addr,int io,byte src[])
{
	int index = 0;
  word crc;
  index =0;
	src[index++] = addr;
	src[index++] = 0x05;
	src[index++] = 0x00;
	src[index++] = io-1;//端口
	src[index++] = 0x00;//关闭
	src[index++] = 0x00;
  

	crc = usMBCRC16(src,index);
	src[index++]  = crc&0xff;
	src[index++]  = crc>>8;
	return index;
}
int ReadDO(int addr,int ionum,byte src[])//ionum指需要获取的DO口数目，不是序号
{
	int index;
  word crc;
  index=0;
	src[index++] = addr;
	src[index++] = 0x01;
	src[index++] = 0x00;
	src[index++] = 0x00;
	src[index++] = 0x00;
	src[index++] = ionum;

  crc = usMBCRC16(src,index);
	src[index++]  = crc&0xff;
	src[index++]  = crc>>8;
  if(ionum>6)
  {
    //teststep("","发送DAM继电器控制指令异常！");
    write("发送DAM继电器控制指令异常！");
		return 0;
  }
	return index;
}
int WriteDO(int addr,int info1,int info2,int info3,int info4,byte src[])
{
	int index;
  word crc ;
  index=0;
	src[index++] = addr;
	src[index++] = 0x0f;
	src[index++] = 0x00;
	src[index++] = 0x00;
	src[index++] = 0x00;
	src[index++] = 32;
	src[index++] = 4;
	src[index++] = info1;
	src[index++] = info2;
	src[index++] = info3;
	src[index++] = info4;

  crc= usMBCRC16(src,index);
	src[index++]  = crc&0xff;
	src[index++]  = crc>>8;
	return index;
}

  
int SetRelayOpen(byte portnum)//目前我们使用的DAM继电器IO口最大到6
{
	byte src[200];
  int index;
  float timetemp;
  int i;
	int srclen = 0;
  
  if(RealType==DAM)
  { 
  srclen  = OpenDO(DevAddr,portnum,src);
  if(portnum>6)
	{
    //teststepFail("","发送DAM继电器控制指令错误！");
		write("发送DAM继电器控制指令错误！");
		return 0;
	}
 
	SendAndRead(RelayPort,src,srclen);
  timetemp=timeNowFloat()/100;
 
  }
 else
 {  
  index=0;
  src[index++] = 0x00;
	src[index++] =0xF0 + (portnum & 0x0F);//连接端口
	src[index++] = 0xff;

  if(portnum>8)
	{
    ////teststepFail("","发送QYF继电器指令错误！");
		write("发送QYF继电器指令错误！");
		return 0;
	}

  SendAndRead(RelayPort,src,index);
 
   }
  //teststep("","继电器端口[%d]连接成功",portnum);
  //write("继电器端口[%d]连接成功",portnum);
	return 1;
}


int SetRelayClose(byte portnum)//目前我们使用的DAM继电器IO口最大到6
{
  
 
  int index;
  int i;
	byte src[200];
	int srclen = 0;

  if(RealType==DAM)
  {
   srclen = CloseDO(DevAddr,portnum,src);
  if(portnum>6)
	{
    ////teststepFail("","发送DAM继电器控制指令错误！");
		write("发送DAM继电器控制指令错误！");
		return 0;
	}
 
	SendAndRead(RelayPort,src,srclen);
  }
  else
  {
  index=0;
  src[index++] = 0x00;
	src[index++] = 0x0F & portnum;//断开端口
	src[index++] = 0xff;
  if(portnum>8)
	{
    ////teststepFail("","发送QYF继电器指令错误！");
		write("发送QYF继电器指令错误！");
		return 0;
	}
 
	SendAndRead(RelayPort,src,index);
 
 }
  //teststep("","继电器端口[%d]断开成功",portnum);
//  write("继电器端口[%d]断开成功",portnum);
	return 1;
}



