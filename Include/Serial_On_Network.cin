byte DP_SetCurrent(float data)
{
  char str[10]="CURR "; //设置最大电流
  char buf[100];
  word vol=0;
  float timetemp;
  byte i;
  
  for(i=0; i<5; i++)
  {
    buf[i]=str[i];
  }
  
  vol = (word)(data*1000);//这里是小数点右移三位，所以后面转换的时候要左移3位，因此在千位后就要加.
  
  if(vol>5000)
   { 
     write("当前输入限流值太大！");
     ////testStepFail("当前输入限流值太大！");
     return 0;
  }
  else
  {
    buf[i++]=(byte)(vol/1000)+0x30;//0x30为'0'字符，记住由浮点转换为整形字节数据发送串口端要+0x30，将串口端整形数据转换为浮点数的时候要-0x30,-之前要确保先转换为byte类型
    vol%=1000;
    buf[i++]='.';
    buf[i++]=(byte)(vol/100)+0x30;
    vol%=100;
    buf[i++]=(byte)(vol/10)+0x30;
    buf[i++]=(byte)(vol%10)+0x30;
    buf[i++]='\r';
    buf[i++]='\n';
 
 if(DP_Send(PowerPort,buf,i)!=1)//或者DP_send(buf,i);
  {
    ////testStepFail("","设置当前限流值= %.1fa失败",data);
    write("设置当前限流值= %.1fa失败",data);
    return 0;
  }
     //putValue(Env_ReadCurrent,data);
   // write("Current string:%s Length=%d",buf,i);//这里用strlen会有问题，除非手动补个'\0'
   timetemp=timeNowFloat()/100;
   //testStep("","设置当前限流值= :%0.1fa，时间= %.0fms",data,timetemp); 
   write("设置当前限流值= :%0.1fa，时间= %.0fms",data,timetemp);
  }
  return 1;
}
