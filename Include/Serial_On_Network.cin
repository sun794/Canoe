on timer remotemode
{
     
  if(DP_Send(PowerPort,"SYST:REM\r\n",10)==1)
    write("Into Remote mode!");
  else
    write("Fail To Into Remote mode!");
}

on timer localmode
{
 
  if(DP_Send(PowerPort,"SYST:LOC\r\n",10)==1)
  {
    write("Into Local mode!");
  }
  else
    write("Fail To Into Local mode!");
  }


on timer ClearError
{  
  
   if(DP_Send(PowerPort,"SYSTem:CLEar\r\n",14)==1)
      write("Clear Error!");
   else
      write("Fail To Clear Error!");
   
}


byte InitSerialPort(byte port)
 {
   
  // open the serial port (comes up with Windows defaults)
  if(rs232Open(port)!=1)
   {
 
    //write("An error occurred during opening of the serial port %d.",port);
    return 0;
  }
  if(rs232Configure(port,Baudrate,dataBits,stopBits,parity)!=1)
  {
   // write("An error occurred during initialization of the serial port %d.", port); 
    return 0;
  }
  #if 1
  // set buffer for reception (otherwise callback would not work)
  if(rs232Receive(port, gReceiverCallbackBuffer, kBUFFER_SIZE)!=1)//初始化的时候如果执行这句后续可以用rs232onReceive来接收串口回复的数据
  {  
   // write("An error occurred during setting the receiver buffer for serial Port %d.", port);
    return 0;
  }
  #endif
  
  return 1;
}

/// <rs232 Call back>
//这里注意CALLBACK的函数,RS一定要大写，可以看rs232Receive的使用说明的时候，关注这一细节
RS232OnReceive(dword port, byte buffer[], dword number) //这个是反馈接收节点，收到的串口数据是否正确//gReceiverCallbackBuffer  kBUFFER_SIZE参数
{
  dword i,j;
  if(number>0)//表示收到的串口回复数据长度不为0
  {
   gLastReceiveLength=number;//取每次收到的串口返回数据长度
   for(i=0;i<number;i++)
  {  
    gReceivedBuffer[i]=buffer[i];
   // write("%.0fms -> gReceivedBuffer[%d]:0x%02x",timeNowFloat()/100.0,i,gReceivedBuffer[i]);   
   }
  if(i>0)//加了个缓存的buffer,一定程度上可以解决串口数据同步的问题，但不是百分百，所以后续还是考虑只判断有无串口响应，不具体到字段有无错误
  {
    for(i=0;i<number;i++)
    {
      gReceivedBuffertemp[i]=gReceivedBuffer[i];
      if(gReceivedBuffertemp[i]>=0X7F &&gReceivedBuffertemp[i]<=0X20)
      {
       // write("RS232OnReceive %.0fms ->gReceivedBuffertemp[%d]:0x%02x",timeNowFloat()/100.0,i,gReceivedBuffertemp[i]);
      }
      else
      {
     // write("RS232OnReceive %.0fms ->gReceivedBuffertemp[%d]:%c",timeNowFloat()/100.0,i,gReceivedBuffertemp[i]); 
      }
     }
   }
  //testSupplyTextEvent(gSerialReceivedData);
  }
}
/// <rs232 Call back>
RS232OnSend(dword port, byte buffer[], dword number)
{
  long i;
  char string[256];//字符的类型
  byte SendByte[256];//字节的类型
  //testSupplyTextEvent(gSerialSendData);
  for(i=0; i<elcount(buffer); ++i)
  {
    SendByte[i] = buffer[i];
    if(SendByte[i]>=0x7F&&SendByte[i]<=0x20)//这个范围内不是单字节符或无法显示出来
    {
      // write("%.0fms -> 发送数据：SendData[%d]:0x%02X", timeNowfloat()/100.0,i,SendByte[i]);
    }
    else//这个范围内的字符是可以打印显示出来的
    {
     // write("%.0fms -> 发送数据：SendData[%d]:%c", timeNowfloat()/100.0,i,SendByte[i]); 
    }
  }
}
void InitNormalVoltage(byte port)
{
  gSeriIniTimes++;
  if(gSeriIniTimes==1)//每次测试循环只需要初始化一次
   {
     if(InitSerialPort(port)==1)
      {   
        //TeststepPass("","成功打开程控电源串口，端口号：[COM%d]",port);
        write("成功打开程控电源串口，端口号：[COM%d]!",port);
       }
      else
       { 
        //TeststepFail("","打开程控电源串口失败，端口号：[COM%d]",port);
       // write("打开程控电源串口失败，端口号：[COM%d]",port);
        return;
      }
    }
  if(DP_Send(port,"SYST:REM\r\n",10)==1)
   {
    ////Teststep("","远程控制程控电源成功!");
    write("远程控制程控电源成功!");
  }
  else
  {
    //Teststepfail("远程控制程控电源失败!");
    write("远程控制程控电源失败!");
    return;
  }
 DP_SetVoltage(12);
 if(DP_Send(port,"OUTP 1\r\n",8)==1)//输出电压
  {
    ////Teststep("","成功使能电压输出");
    write("成功使能电压输出");
  }
  else
  {
    //Teststepfail("","使能电压输出失败");
    write("使能电压输出失败");
  }
 
 //testWaitForTimeout(2000);
}
  
void RestorePowerSupplyLocalControl(byte port)
{
  gSeriIniTimes++;
  if(gSeriIniTimes==1)//每次测试循环只需要初始化一次
   {
     if(InitSerialPort(port)==1)
      {   
       // TeststepPass("","成功打开程控电源串口，端口号：[COM%d]",port);
        write("成功打开程控电源串口，端口号：[COM%d]",port);
       }
      else
       { 
        // TeststepFail("","打开程控电源串口失败，端口号：[COM%d]",port);
        write("打开程控电源串口失败，端口号：[COM%d]",port);
        return;
      }
   }
  DP_SetVoltage(POWER_OFF);
  if(DP_Send(port,"OUTP 0\r\n",8)==1)//关闭电压输出
  {
  //  ////Teststep("","关闭电源电压输出");
    write("关闭电源电压输出");
  }
  else
  {
   // //Teststepfail("","关闭电源电源输出失败");
    write("关闭电源电源输出失败");
  }
  
  
  if(DP_Send(port,"SYST:LOC\r\n",10)==1)
   {
   // //Teststep("","恢复成本地控制模式");
    write("恢复成本地控制模式");
  }
  else
  {
   // //Teststepfail("设置成本地控制模式失败");
    write("设置成本地控制模式失败");
    return;
  }
    
}

int InitRelayPortOpen(byte port,enum RelayType type) //目前我们使用的继电器DAM IO口最大到6 QYF最大到8
{
  int index = 0;
  int i;
  word crc;
  byte src[100];
  index =0;
  RealType=type;//继电器的类型 type 1:QYF  type 0 :DAM
  gRelayIniTimes++;
  RelayPort=port;
  if(gRelayIniTimes==1)//每次测试循环只需要初始化一次
   {
     if(InitSerialPort(port)==1)
      {   
      //  TeststepPass("","成功打开继电器串口，端口号：[COM%d]",port);
        write("成功打开继电器串口，端口号：[COM%d]",port);
       }
      else
       { 
        // TeststepFail("","打开继电器串口失败，端口号：[COM%d]",port);
         write("打开继电器串口失败，端口号：[COM%d]",port);
         return 0;
      }
  }
  if(RealType==DAM)
  {
  	src[index++] = DevAddr;
  	src[index++] = 0x0F;//ALL
  	src[index++] = 0x00;//起始地址高位
  	src[index++] = 0x00;//起始地址低位
  	src[index++] = 0x00;//控制继电器端口数量高位，一般这里默认为0，我们不需要使用那么多端口的继电器
  	src[index++] = PortNumber;//控制继电器端口数量低位，如果是青果的6路继电器，那么这里设置为06
    if(0<PortNumber&&PortNumber<=8)
    {  
      src[index++] = 0x01;//表示需要1个字节
      src[index++] = 0xFF;//闭合（每个bit表示一路继电器端口开闭，比如bit0=1,就是端口1闭合，因此一个字节表示8个端口）
      }
    else if(8<PortNumber&&PortNumber<=16)
    {
      src[index++] = 0x02; //表示需要2个字节
      src[index++] = 0xFF;//闭合
      src[index++] = 0xFF;//闭合
    }
    else if(16<PortNumber &&PortNumber<=24)
    {
      src[index++] = 0x03; //表示需要3个字节
      src[index++] = 0xFF;//闭合
      src[index++] = 0xFF;//闭合
      src[index++] = 0xFF;//闭合
    }
 
  	crc = usMBCRC16(src,index);
  	src[index++]  = crc&0xff;
  	src[index++]  = crc>>8;
    SendAndRead(port,src,index);
    write("11111111111111111111111111111");
    
   }
 
 else //QYF继电器指令的串口返回数据有点奇怪的点在于，第一次的请求，返回值都为0x00
   {
    src[index++] = 0x00;
    src[index++] = 0xf9;//连接全部端口
    src[index++] = 0xff;
    SendAndRead(port,src,index);
  
  }
  //testWaitForTimeout(1000);
  write("连接继电器所有端口成功");
 // testStep("","连接继电器所有端口成功");
  return 1;
}

int InitRelayPortClose(byte port,enum RelayType type) //目前我们使用的继电器DAM IO口最大到6 QYF最大到8
{
  int index = 0;
  int i;
  word crc;
  byte src[100];
  index =0;

  RealType=type;//继电器的类型 type 1:QYF  type 0 :DAM
  gRelayIniTimes++;
  RelayPort=port;
  if(gRelayIniTimes==1)//每次测试循环只需要初始化一次
   {
     if(InitSerialPort(port)==1)
      {   
        //TeststepPass("","成功打开继电器串口，端口号：[COM%d]",port);
        write("成功打开继电器串口，端口号：[COM%d]",port);
       }
      else
       { 
        // TeststepFail("","打开继电器串口失败，端口号：[COM%d]",port);
         write("打开继电器串口失败，端口号：[COM%d]",port);
         return 0;
      }
  }
  if(RealType==DAM)
  {
  	src[index++] = DevAddr;
  	src[index++] = 0x0F;//ALL
  	src[index++] = 0x00;
  	src[index++] = 0x00;
  	src[index++] = 0x00;
  	src[index++] = PortNumber;//端口数量，如果是青果的6路继电器，那么这里设置为06
   if(0<PortNumber&&PortNumber<=8)
    {  
      src[index++] = 0x01;//表示需要1个字节
      src[index++] = 0x00;//断开（每个bit表示一路继电器端口开闭，比如bit0=0,就是端口1断开，因此一个字节表示8个端口）
      }
    else if(8<PortNumber&&PortNumber<=16)
    {
      src[index++] = 0x02; //表示需要2个字节
      src[index++] = 0x00;//断开
      src[index++] = 0x00;//断开
    }
    else if(16<PortNumber &&PortNumber<=24)
    {
      src[index++] = 0x03; //表示需要3个字节
      src[index++] = 0x00;//断开
      src[index++] = 0x00;//断开
      src[index++] = 0x00;//断开
    }
   
  	crc = usMBCRC16(src,index);
  	src[index++]  = crc&0xff;
  	src[index++]  = crc>>8;
    SendAndRead(port,src,index);
  
   }
  else
   {
	  src[index++] = 0x00;
	  src[index++] = 0x09;//断开全部端口
	  src[index++] = 0xff;
    SendAndRead(port,src,index);
  
   }
  //testWaitForTimeout(1000);
  //teststep("","断开继电器所有端口成功");
  write("断开继电器所有端口成功");
  return 1;
}





byte DP_Send(byte port,char str[],byte len)
{
  byte buffer[100];
  byte i;
 
  for(i=0; i<len; i++)
  {
    buffer[i] = (byte)(str[i]);
  }
  
  if(0==rs232Send(port, buffer, len))
  {
    write("An error occurred during write of block of data to the serial Port %d.", port);
    return 0;
  } 
  
  return 1;
}
 
byte DP_SendByte(byte port,byte str[],byte len)
{
  byte i;
 
  
  if(0==rs232Send(port, str, len))
  {
    write("An error occurred during write of block of data to the serial Port %d.", port);
    return 0;
  } 

  return 1;
}
byte DP_SetVoltage(float data)//将设置电压和设置电流都模块化，只需要输入电压值就行
{
  char str[7]="VOLT ";
  char buf[100];
  word vol=0;
  byte i;
  float timetemp;
  for(i=0; i<5; i++)
  {
    buf[i]=str[i];
  }
  
  vol = (word)(data*100);//乘以100去掉小数点最后再换算回去，一般都是0.01的精度，所以小数点后面提取的时候就左移2位加上去
  
  if(vol>2400)//24V相当于是*100，单位是V
   {
    write("当前输入电压太高！");
    //testStepFail("当前输入电压太高！");
    return 0; 
      }
  else
  {
    buf[i++]=(byte)(vol/1000)+0x30;//这里是千位精度提取千位，因为是整形数除以它的精度就可以取最高位整  0x30其实表示的是0字符，其实可以不加
    vol%=1000;//提取百十位
    buf[i++]=(byte)(vol/100)+0x30;//这里是百位的精度，同上，对百位取整
    vol%=100;//提取十个位数
    buf[i++]='.';//字符.
    buf[i++]=(byte)(vol/10)+0x30;//十位数取精度，这个是取整
    buf[i++]=(byte)(vol%10)+0x30;//个位数取精度，这个是取剩下的余
    buf[i++]='\r';
    buf[i++]='\n';
    if(DP_Send(PowerPort,buf,i)!=1)
    {
      //testStepFail("","设置当前电压= %0.1fv 失败",data);
      write("设置当前电压:%0.1fv失败",data);
      return 0;
    }
    timetemp=timeNowFloat()/100000.0;
    //testStep("","设置当前电压= %0.1fv ，时间= %.0fms",data,timetemp);
    write("设置当前电压= %0.1fv，时间= %.0fs",data,timetemp);
   // putValue(Env_ReadVoltage,data);
  }
    return 1;
}
 
