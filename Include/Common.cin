/// <Busload>
void busloadplus(long plus_num)
{
  float busload_msg_cyc;
  float busload_msg_cyc2;
  float busload_msg_cyc3;
  float busload_msg_cyc4;
  float busload_msg_cyc5;
  
  if(plus_num<=20&&plus_num>=0){
    
    busload_msg_cyc = 20/plus_num;
    setTimerCyclic(t_busload1,busload_msg_cyc);
    canceltimer(t_busload2);
    canceltimer(t_busload3);
    canceltimer(t_busload4);
    canceltimer(t_busload5);
  }
  if(plus_num<=40&&plus_num>20){
    
    busload_msg_cyc = 1;
    busload_msg_cyc2 = 20/(plus_num-20);
    setTimerCyclic(t_busload1,busload_msg_cyc);
    setTimerCyclic(t_busload2,busload_msg_cyc2);
    canceltimer(t_busload3);
    canceltimer(t_busload4);
    canceltimer(t_busload5);
  }
  if(plus_num<=60&&plus_num>40){
    
    busload_msg_cyc = 1;
    busload_msg_cyc2 = 1;
    busload_msg_cyc3 = 20/(plus_num-40);
    setTimerCyclic(t_busload1,busload_msg_cyc);
    setTimerCyclic(t_busload2,busload_msg_cyc2);
    setTimerCyclic(t_busload3,busload_msg_cyc3);
    canceltimer(t_busload4);
    canceltimer(t_busload5);
  }
  if(plus_num<=80&&plus_num>60){
    
    busload_msg_cyc = 1;
    busload_msg_cyc2 = 1;
    busload_msg_cyc3 = 1;
    busload_msg_cyc4 = 20/(plus_num-60);
    setTimerCyclic(t_busload1,busload_msg_cyc);
    setTimerCyclic(t_busload2,busload_msg_cyc2);
    setTimerCyclic(t_busload3,busload_msg_cyc3);
    setTimerCyclic(t_busload4,busload_msg_cyc4);
    canceltimer(t_busload5);    
  }
  if(plus_num>80&&plus_num<100)
  {
    busload_msg_cyc = 1;
    busload_msg_cyc2 = 1;
    busload_msg_cyc3 = 1;
    busload_msg_cyc4 = 1;
    busload_msg_cyc5 = 20/(plus_num-80);
    setTimerCyclic(t_busload1,busload_msg_cyc);
    setTimerCyclic(t_busload2,busload_msg_cyc2);
    setTimerCyclic(t_busload3,busload_msg_cyc3);
    setTimerCyclic(t_busload4,busload_msg_cyc4);
    setTimerCyclic(t_busload5,busload_msg_cyc5);
  }
}

/// <Busload>
void CancelBusloadTest()
{
  cancelTimer(t_busload1);
  cancelTimer(t_busload2);
  cancelTimer(t_busload3);
  cancelTimer(t_busload4);
  cancelTimer(t_busload5);
  cancelTimer(t_busload6);
}

/// <Busload>
long check_channel_busload (int test_chn)
{
  long chn_busload;
  switch(test_chn)
  {
    case 1:
      chn_busload = can1.busload;
      break;
    case 2:
      chn_busload = can2.busload;
      break;
    case 3:
      chn_busload = can3.busload;
      break;
    case 4:
      chn_busload = can4.busload;
      break;
    case 5:
      chn_busload = can5.busload;
      break;
    case 6:
      chn_busload = can6.busload;
     break;
    default:
     break;
  }
  
  return chn_busload;
}


/// <Converter>
// hex格式转bcd格式
word HexToBcd(word hexData)
{
	word bcdData;
	bcdData = ((hexData / 10) << 4) + (hexData % 10);
	return bcdData;
}


/// <Converter>
void FormatAddressAndSize(dword address, dword size, byte data[])
{
  data[0] = 0x44;
  data[1] = (address>>24) & 0xFF;
  data[2] = (address>>16) & 0xFF;
  data[3] = (address>>8) & 0xFF;
  data[4] = (address) & 0xFF;
  data[5] = (size>>24) & 0xFF;
  data[6] = (size>>16) & 0xFF;
  data[7] = (size>>8) & 0xFF;
  data[8] = (size) & 0xFF;
}

void FormatDwordToBytes(dword sourceData, byte data[])
{
  data[0] = (sourceData>>24) & 0xFF;
  data[1] = (sourceData>>16) & 0xFF;
  data[2] = (sourceData>>8) & 0xFF;
  data[3] = sourceData & 0xFF;
}


//将16进制数字符转换成字符类型字符串（如显示版本号）
int CharToString(byte data[], dword dataLen, int startPos, char strHex[])
{
  int i;
  char strTemp[60];
  int len;
   
  strncpy(strHex,"",elcount(strHex));
  len = dataLen - startPos;
  
  if(len <= 0)
  {
    snprintf(strHex, elCount(strHex), "格式错误，请检查语法！ ");
    return 0;
  }
  else if(len <= 100)
  {
    for(i=startPos;i<dataLen;i++)
    {
      snprintf(strTemp, elCount(strTemp), "%c", data[i]);
      strncat(strHex, strTemp, elCount(strHex));
    }
  }
  
  return len;
}
int BytesToHexString(byte data[], dword dataLen, int startPos, char strHex[])
{
  int i;
  char strTemp[60];
  int len;
   
  strncpy(strHex,"",elcount(strHex));
  len = dataLen - startPos;
  
  if(len <= 0)
  {
    snprintf(strHex, elCount(strHex), "格式错误，请检查语法！ ");
    return 0;
  }
  else if(len <= 25)
  {
    for(i=startPos;i<dataLen;i++)
    {
      snprintf(strTemp, elCount(strTemp), "%02X ", data[i]);
      strncat(strHex, strTemp, elCount(strHex));
    }
  }
  else //如果后面的数据太多，就只显示前面20个数据和最后5个数据，总体显示数据还是为25个字节
  {
    for(i=startPos;i<startPos+20;i++)
    {
      snprintf(strTemp, elCount(strTemp), "%02X ", data[i]);
      strncat(strHex, strTemp, elCount(strHex));
    }
    snprintf(strTemp, elcount(strTemp), "... ...");
    strncat(strHex, strTemp, elCount(strHex));
    for(i=dataLen-5;i<dataLen;i++)
    {
      snprintf(strTemp, elCount(strTemp), "%02X ", data[i]);
      strncat(strHex, strTemp, elCount(strHex));
    }
  }
  snprintf(strTemp, elcount(strTemp), " [%u，0x%X字节] ", len, len);//在最后显示整体数据长度即可
  strncat(strHex, strTemp, elCount(strHex));
  return len;
}


/// <CaplOutPutPanel>
void CaplPutValueToControl(char panel[], char control[], char val[])
{
  putValueToControl(panel,control, val);

}

// 给16进制字符串添加前缀，并判断合法性，如果不合法返回0，反之返回1
long checkStrHex(char strHexSrc[], char strHexDes[])
{
//  if(str_match_regex(strHexSrc, "\b(?:0[xX])?[0-9a-fA-F]+\b") == 0)
//  {
//    write("%s 不是有效的十六进制数", strHexSrc);
//    return 0;
//  }
  if(strstr(strHexSrc, "0x")<0 || strstr(strHexSrc, "0X")<0)
    snprintf(strHexDes,elCount(strHexDes),"0x%s",strHexSrc); 
  else
    snprintf(strHexDes,elCount(strHexDes),"%s",strHexSrc); 
  return 1;
}

/// <Converter>
//将一个16进制的字符串转换成一个long型数据 long: signed, 4 Byte
long hexStringToLong(char strHex[])
{
  char strHex0x[11];
  if(checkStrHex(strHex, strHex0x) == 0)
    return 0;
  return atol(strHex0x);
}

/// <Converter>
//将一个16进制的字符串转换成一个int64型数据 int64: signed, 8 Byte
int64 hexStringToInt64(char strHex[])
{
  char strHex0x[19];
  if(checkStrHex(strHex, strHex0x) == 0)
    return 0;
  return _atoi64(strHex0x);
}

/// <Delay>
void TestStepWaitOutput(char step[], dword ms)
{
  testStep(step, "等待 %d ms", ms);
  testWaitForTimeout(ms);
}

/// <Converter>
dword SumFromArray(dword data[], dword dataLen)
{
  dword i, sum;
  sum = 0;
  for(i=0;i<dataLen;i++)
  {
    sum += data[i];
  }
  return sum;
}

