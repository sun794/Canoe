/// <Compare>
int CompareArrays(byte arr1[], byte arr2[],int size)
  {
    int i;
    for (i = 0; i < size; i++) 
    {
        if (arr1[i] != arr2[i]) 
        {
            return 1; // 返回-1表示数组不相等
        }
    }
    return 0; // 返回0表示数组相等
  }
  
int GetDUTSendAppMsgInfo(char TestEcuNode[]) //输入ECU的节点名称
{
  message * MessageTemp;
  int i,msgid;
  dword  searchRange=0x7ff;
 
  for(i=0;i<cNodeCycMsgNum;i++)   //Array Initialization
  {
    gIdOfNodeSendCycMsg[i] = 0;
    gDLCOfNodeSendCycMsg[i] = 0;
    gCycOfNodeSendCycMsg[i] = 0;
    gOccurofNodeSendCycMsg[i] =0;
  }

    gNumOfNodeSendCycMsg=0;
  //  MessageTemp.can = @sysvar::CommonSysVar::CANChn;      //指定 所查询的dbc所在的通道  TODO
    for(msgid=0;msgid<searchRange;msgid++)//search message in ID range 0x00~0x7ff
    {
      MessageTemp.id = msgid;
      //筛选ECU_NODE下的tx的message的条件，GenMsgCycleTime！=0可以直接排除掉诊断报文，GenMsgSendType=0表示类型在dbc里面为cycle，这个参数类型为枚举变量，cycle是首个枚举元素，因此是0
      if (strncmp(DBLookup(MessageTemp).Transmitter,TestEcuNode,50)==0 && DBLookup(MessageTemp).GenMsgCycleTime != 0 && DBLookup(MessageTemp).GenMsgSendType==0)
      {
        gIdOfNodeSendCycMsg[gNumOfNodeSendCycMsg] = msgid;
        gDLCOfNodeSendCycMsg[gNumOfNodeSendCycMsg] = DBLookup(MessageTemp).DLC;
        gCycOfNodeSendCycMsg[gNumOfNodeSendCycMsg] = DBLookup(MessageTemp).GenMsgCycleTime;
       // write("gIdOfNodeSendCycMsg[%d]=0x%X",gNumOfNodeSendCycMsg, gIdOfNodeSendCycMsg[gNumOfNodeSendCycMsg]);
        gNumOfNodeSendCycMsg++;     
         
      }
    }
    if(gNumOfNodeSendCycMsg==0)
    {
      teststepfail("","从DBC上检索该ECU的应用报文失败!---->gNumOfNodeSendCycMsg = %d",gNumOfNodeSendCycMsg);
      return 0;
    }
    testStep("","成功从DBC找到ECU发送报文信息!");
    return 1;
}
  
int CheckEcuSendMsg(char TestEcuNode[])
{
  int i;
  
   if(GetDUTSendAppMsgInfo(TestEcuNode)==1)//初始测试节点信息，主要是为了将ECU会发送的报文ID信息都获取出来并赋值给gIdOfNodeSendCycAppMsg数组
  {
    
    for(i=0;i<gNumOfNodeSendCycMsg;i++)
     {
      if(testWaitForMessage(gIdOfNodeSendCycMsg[i],2000)==0)
       {
         write("2S内未收到ECU报文ID =0x%03X 通讯异常！",gIdOfNodeSendCycMsg[i]);
         testStepFail("","2S内未收到ECU报文ID =0x%03X 通讯异常！",gIdOfNodeSendCycMsg[i]);
         return 0;
       }
      else
      {
       // testStepPass("","成功收到ECU报文ID =0x%03X 通讯正常！",gIdOfNodeSendCycMsg[i]);
        write("成功收到ECU报文ID =0x%03X 通讯正常！",gIdOfNodeSendCycMsg[i]);
      }
    }
}
  testStepPass("","成功收到ECU的全部报文，通讯正常！");
  write("成功收到ECU的全部报文，通讯正常！");
  return 1;
}