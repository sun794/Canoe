  long  gDLCOfNodeSendCycMsg[cNodeCycMsgNum];
  long  gCycOfNodeSendCycMsg[cNodeCycMsgNum];
  long  gOccurofNodeSendCycMsg[cNodeCycMsgNum];
  
}





