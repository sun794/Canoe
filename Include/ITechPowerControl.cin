int ITECH_CmdProc2(int port, char command[], char response[])
{
  int ret;
  byte cmd[256];
  memcpy(cmd, command, strlen(command));
  ret = SerialSendData(port, cmd, strlen(command));
  if(ret != 0)
  {
    write("%g: Failed to send \"%s\" on port %d. code = %d", timeNow()/100.0, command, port, ret);
    return -1;
  }
  #if TEST_NODE
  ret = SerialReceiveData(port, response, elCount(response), 5000);
  if(ret < 1)
  {
    write("%g: No reponse to \"%s\" on port %d. code = %d", timeNow()/100.0, command, port, ret);
    return -2;
  }
  else
  {
    write("%g: Reponse \"%s\" to \"%s\" on port %d. length = %d", timeNow()/100.0, response, command, port, ret);
    response[ret - 1] = 0;
  }
  #endif
  return 0;
}

int ITECH_CmdProc(int port, char command[])
{
  int ret;
  byte cmd[256];
  memcpy(cmd, command, strlen(command));
  ret = SerialSendData(port, cmd, strlen(command));
  if(ret != 0)
  {
    write("Failed to send \"%s\" on port %d. code = %d", timeNow()/100.0, command, port, ret);
    return -1;
  }
  #if TEST_NODE
  testWaitForTimeout(40);
  #endif
  return 0;
}

export int ITECH_Init(int port)
{
  int ret;
  char response[256];
  ret = SerialInit(port, 9600, 8, 1, 0, 0, '\n');
  if(ret != 0)
    return -1;
  
  ret = ITECH_CmdProc(port, "SYST:REMote \n");
  
  #if TEST_NODE
  if(ret != 0 || strncmp(response, "SYST:REMote \n", elCount(response)) != 0)
  {
    write("Cannot change to remote mode");
    return -1;
  }
  ITECH_CmdProc(port, "FUNC:GEN:SEL VOLTAGE");
  #endif
  return 0;
}

export int ITECH_SetVoltage(int port, float voltage)
{
  char command[64];
  char response[256];
  char command2[64];
  int ret;
  float volt;
  snprintf(command, elcount(command), "VOLTage %g \n",  voltage);
  ret = ITECH_CmdProc(port, command);
  if(ret != 0)
    return ret;
  #if 0
  //check voltage setting 
  ret = ITECH_CmdProc(port, "VOLTage? \n");
  if(ret != 0)
    return ret;
  volt = atodbl(response);
  if(abs(volt - voltage) > 0.1)
  {
    write("Voltage setting error");
    return -2;
  }
  #endif
  return 0;
}

export int ITECH_SetMaxCurrent(int port, float current)
{
  char command[64];
  char response[256];
  int ret;
  float curr;
  snprintf(command, elcount(command), "CURRent %g \n",  current);
  ret = ITECH_CmdProc(port, command);
  if(ret != 0)
    return ret;
  #if 0
  //check current setting 
  ret = ITECH_CmdProc(port, "CURRent? \n");
  if(ret != 0)
    return ret;
  curr = atodbl(response);
  if(abs(curr - current) > 0.1)
  {
    write("Current setting error");
    return -3;
  }
  #endif
  return 0;
}

export int ITECH_GetPower(int port, float &voltage, float &current)
{
  char command[64];
  char response[256];
  int ret;
  ret = ITECH_CmdProc2(port, "MEASure:VOLTage? \n",response);
  
  #if TEST_NODE
  if(ret != 0)
  {
    write("Failed to get output voltage of ITECH power on port %d.", port);
    return -2;
  }
  voltage = atodbl(response);
  #endif
  
  ret = ITECH_CmdProc2(port, "MEASure:CURRent? \n",response);
  #if TEST_NODE
  if(ret != 0)
  {
    write("Failed to get output current of ITECH power on port %d.", port);
    return -3;
  }
  current = atodbl(response);
  #endif
  
  write("ITECHPowwrsail.cin::voltage=%f,cur=%f",voltage,current);
  return 0;
}

export int ITECH_OpenPower(int port)
{
  char command[64];
  char response[256];
  ITECH_CmdProc(port, "OUTPut 1 \n");
  #if 0
  ITECH_CmdProc(port, "OUTPut? \n");
  if(strncmp(response, "ON", elCount(response)) != 0)
  {
    write("Failed to set output on for ITECH power on port %d. \"%s\"", port, response);
    return -4;
  }
  #endif
  return 0;
}

export int ITECH_ClosePower(int port)
{
  char response[256];
  ITECH_CmdProc(port, "OUTPut 0 \n");
  #if 0
  ITECH_CmdProc(port, "OUTPut? \n");
  if(strncmp(response, "OFF", elCount(response)) != 0)
  {
    write("Failed to set output off for ITECH power on port %d. \"%s\"", port, response);
    return -5;
  }
  #endif
  
  return 0;
}


byte InitSerialPort(byte port)
 {
   
  // open the serial port (comes up with Windows defaults)
  if(rs232Open(port)!=1)
   {
 
    write("An error occurred during opening of the serial port %d.",port);
    return 0;
  }
  if(rs232Configure(port,Baudrate,dataBits,stopBits,parity)!=1)
  {
    write("An error occurred during initialization of the serial port %d.", port); 
    return 0;
  }
  #if 1
  // set buffer for reception (otherwise callback would not work)
  if(rs232Receive(port, gReceiverCallbackBuffer, kBUFFER_SIZE)!=1)//初始化的时候如果执行这句后续可以用rs232onReceive来接收串口回复的数据
  {  
    write("An error occurred during setting the receiver buffer for serial Port %d.", port);
    return 0;
  }
  #endif
  
  return 1;
}



int InitRelayPortOpen(byte port,enum RelayType type) //目前我们使用的继电器DAM IO口最大到6 QYF最大到8
{
  int index = 0;
  int i;
  word crc;
  byte src[100];
  index =0;
  RealType=type;//继电器的类型 type 1:QYF  type 0 :DAM
  gRelayIniTimes++;
  if(gRelayIniTimes==1)//每次测试循环只需要初始化一次
   {
     if(InitSerialPort(port)==1)
      {   
        TeststepPass("","成功打开继电器串口，端口号：[COM%d]",port);
        write("成功打开继电器串口，端口号：[COM%d]",port);
       }
      else
       { 
         TeststepFail("","打开继电器串口失败，端口号：[COM%d]",port);
         write("打开继电器串口失败，端口号：[COM%d]",port);
         return 0;
      }
  }
  if(RealType==DAM)
  {
  	src[index++] = DevAddr;
  	src[index++] = 0x0F;//ALL
  	src[index++] = 0x00;//起始地址高位
  	src[index++] = 0x00;//起始地址低位
  	src[index++] = 0x00;//控制继电器端口数量高位，一般这里默认为0，我们不需要使用那么多端口的继电器
  	src[index++] = PortNumber;//控制继电器端口数量低位，如果是青果的6路继电器，那么这里设置为06
    if(0<PortNumber&&PortNumber<=8)
    {  
      src[index++] = 0x01;//表示需要1个字节
      src[index++] = 0xFF;//闭合（每个bit表示一路继电器端口开闭，比如bit0=1,就是端口1闭合，因此一个字节表示8个端口）
      }
    else if(8<PortNumber&&PortNumber<=16)
    {
      src[index++] = 0x02; //表示需要2个字节
      src[index++] = 0xFF;//闭合
      src[index++] = 0xFF;//闭合
    }
    else if(16<PortNumber &&PortNumber<=24)
    {
      src[index++] = 0x03; //表示需要3个字节
      src[index++] = 0xFF;//闭合
      src[index++] = 0xFF;//闭合
      src[index++] = 0xFF;//闭合
    }
 
  	crc = usMBCRC16(src,index);
  	src[index++]  = crc&0xff;
  	src[index++]  = crc>>8;
    SendAndRead(port,src,index);
    if(testWaitForTextEvent(gSerialSendData,2000))
    {
     // write("串口指令发送成功");
    
    if(testWaitForTextEvent(gSerialReceivedData,2000))
    {
     // write("接收到已发出的DAM继电器控制指令的串口返回数据");
      for(i=0;i<gLastReceiveLength-2;i++)//这里减2主要是减去了2个CRC校验值的比对，为了兼容QG和DAM的全开全断指令串口返回值的比对
      {
        if(gReceivedBuffertemp[i]!=DAMAllRespData[i])
        {
          write("连接DAM继电器全部端口异常，%.0fms -> 接收数据：ReceivedData[%d]:0x%02X",timeNowfloat()/100.0,i,gReceivedBuffertemp[i]);
          testStepFail("","连接DAM继电器全部端口异常，%.0fms -> 接收数据：ReceivedData[%d]:0x%02X",timeNowfloat()/100.0,i,gReceivedBuffertemp[i]);
          return 0;
        }
      }
     }
    else
    {
     write("未接收到发出控制指令的串口返回数据，请检查DAM继电器状态");
     testStepFail("未接收到发出控制指令的串口返回数据，请检查DAM继电器状态");
     return 0;
    }
    }
    else
    {
      write("串口指令发送失败");
      testStepFail("串口指令发送失败");
      return 0;
    }
  }
 else //QYF继电器指令的串口返回数据有点奇怪的点在于，第一次的请求，返回值都为0x00
   {
  
    src[index++] = 0x00;
    src[index++] = 0xf9;//连接全部端口
    src[index++] = 0xff;
    SendAndRead(port,src,index);
   if(testWaitForTextEvent(gSerialSendData,2000))
    {
   //   write("串口指令发送成功");
    if(testWaitForTextEvent(gSerialReceivedData,2000))
    {
      //write("接收到已发出的QYF继电器控制指令的串口返回数据");
     #if 1 //使用条件编译，目前调试发现QYF的继电器串口返回数据偶尔会异常，因此这样具体判断串口返回字段会有问题，而DAM相对稳定
      for(i=0;i<gLastReceiveLength;i++)
      {
        
        if(gReceivedBuffertemp[i]!=QYFAllRespData[i])
        {
          write("连接QYF继电器全部端口异常，%.0fms -> 接收数据：ReceivedData[%d]:0x%02X",timeNowfloat()/100.0,i,gReceivedBuffertemp[i]);
          testStepFail("","连接QYF继电器全部端口异常，%.0fms -> 接收数据：ReceivedData[%d]:0x%02X",timeNowfloat()/100.0,i,gReceivedBuffertemp[i]);
          return 0;
        }        
      }
      #endif
    }
    else
    {
     testStepFail("未接收到发出控制指令的串口返回数据，请检查QYF继电器状态");
     write("未接收到发出控制指令的串口返回数据，请检查QYF继电器状态");
     return 0;
    }
   }
   else
    {
      testStepFail("串口指令发送失败");
      write("串口指令发送失败");
      return 0;
    }
  }
  testWaitForTimeout(1000);
  write("连接继电器所有端口成功");
  testStep("","连接继电器所有端口成功");
  return 1;
}

int InitRelayPortClose(byte port,enum RelayType type) //目前我们使用的继电器DAM IO口最大到6 QYF最大到8
{
  int index = 0;
  int i;
  word crc;
  byte src[100];
  index =0;

  RealType=type;//继电器的类型 type 1:QYF  type 0 :DAM
  gRelayIniTimes++;
  
  if(gRelayIniTimes==1)//每次测试循环只需要初始化一次
   {
     if(InitSerialPort(port)==1)
      {   
        TeststepPass("","成功打开继电器串口，端口号：[COM%d]",port);
        write("成功打开继电器串口，端口号：[COM%d]",port);
       }
      else
       { 
         TeststepFail("","打开继电器串口失败，端口号：[COM%d]",port);
         write("打开继电器串口失败，端口号：[COM%d]",port);
         return 0;
      }
  }
  if(RealType==DAM)
  {
  	src[index++] = DevAddr;
  	src[index++] = 0x0F;//ALL
  	src[index++] = 0x00;
  	src[index++] = 0x00;
  	src[index++] = 0x00;
  	src[index++] = PortNumber;//端口数量，如果是青果的6路继电器，那么这里设置为06
   if(0<PortNumber&&PortNumber<=8)
    {  
      src[index++] = 0x01;//表示需要1个字节
      src[index++] = 0x00;//断开（每个bit表示一路继电器端口开闭，比如bit0=0,就是端口1断开，因此一个字节表示8个端口）
      }
    else if(8<PortNumber&&PortNumber<=16)
    {
      src[index++] = 0x02; //表示需要2个字节
      src[index++] = 0x00;//断开
      src[index++] = 0x00;//断开
    }
    else if(16<PortNumber &&PortNumber<=24)
    {
      src[index++] = 0x03; //表示需要3个字节
      src[index++] = 0x00;//断开
      src[index++] = 0x00;//断开
      src[index++] = 0x00;//断开
    }
   
  	crc = usMBCRC16(src,index);
  	src[index++]  = crc&0xff;
  	src[index++]  = crc>>8;
    SendAndRead(port,src,index);
   if(testWaitForTextEvent(gSerialSendData,2000))
   {
 //   write("串口指令发送成功");
    if(testWaitForTextEvent(gSerialReceivedData,2000))
    {
      //write("接收到已发出的DAM继电器控制指令的串口返回数据");
      for(i=0;i<gLastReceiveLength-2;i++)//这里减2主要是减去了2个CRC校验值的比对，为了兼容QG和DAM的全开全断指令串口返回值的比对
      {
        if(gReceivedBuffertemp[i]!=DAMAllRespData[i])
        {
          write("断开DAM继电器全部端口异常，%.0fms -> 接收数据：ReceivedData[%d]:0x%02X",timeNowfloat()/100.0,i,gReceivedBuffertemp[i]);
          testStepFail("","断开DAM继电器全部端口异常，%.0fms -> 接收数据：ReceivedData[%d]:0x%02X",timeNowfloat()/100.0,i,gReceivedBuffertemp[i]);
          return 0;
        }
      }
     }
    else
    {
     testStepFail("未接收到发出控制指令的串口返回数据，请检查DAM继电器状态");
     write("未接收到发出控制指令的串口返回数据，请检查DAM继电器状态");
     return 0;
    }
  }
   else
    {
      testStepFail("串口指令发送失败");
      write("串口指令发送失败");
      return 0;
    }
   }
  else
   {
	  src[index++] = 0x00;
	  src[index++] = 0x09;//断开全部端口
	  src[index++] = 0xff;
    SendAndRead(port,src,index);
   if(testWaitForTextEvent(gSerialSendData,2000))
   {
   // write("串口指令发送成功");
    if(testWaitForTextEvent(gSerialReceivedData,2000))
    {
     // write("接收到已发出的QYF继电器控制指令的串口返回数据");
     #if 1//使用条件编译，目前调试发现QYF的继电器串口返回数据偶尔会异常，因此这样具体判断串口返回字段会有问题，而DAM相对稳定
      for(i=0;i<gLastReceiveLength;i++)
      {
       
        if(gReceivedBuffertemp[i]!=QYFAllRespData[i])
        {
         write("断开QYF继电器全部端口异常，%.0fms -> 接收数据：ReceivedData[%d]:0x%02X",timeNowfloat()/100.0,i,gReceivedBuffertemp[i]);
         testStepFail("","断开QYF继电器全部端口异常，%.0fms -> 接收数据：ReceivedData[%d]:0x%02X",timeNowfloat()/100.0,i,gReceivedBuffertemp[i]);
         return 0;
        }
      }
     #endif
     }
    else
    {
     testStepFail("未接收到发出控制指令的串口返回数据，请检查QYF继电器状态");
     write("未接收到发出控制指令的串口返回数据，请检查QYF继电器状态");
     return 0;
    }
  }
  else
    {
      testStepFail("串口指令发送失败");
      write("串口指令发送失败");
      return 0;
    }
   }
  testWaitForTimeout(1000);
  teststep("","断开继电器所有端口成功");
  write("断开继电器所有端口成功");
  return 1;
}


byte DP_SendByte(byte port,byte str[],byte len)
{
  byte i;
 
  
  if(0==rs232Send(port, str, len))
  {
    write("An error occurred during write of block of data to the serial Port %d.", port);
    return 0;
  } 

  return 1;
}

word usMBCRC16(byte src[], int srclen)
{
  byte    ucCRCHi;
  byte    ucCRCLo;
  byte    iIndex;
  int i;
  i=0;//初始化一下
  iIndex=0;
  ucCRCHi = 0xFF;
  ucCRCLo = 0xFF;
	
   while ( srclen-- )
    {
        iIndex = ucCRCLo ^ src[i++];
        ucCRCLo =  ucCRCHi ^ aucCRCHi[iIndex];
        ucCRCHi = aucCRCLo[iIndex];
    }
    return(word)(ucCRCHi << 8 | ucCRCLo);
}



byte SendAndRead(byte port,byte src[],int srclen)
{
	byte n;
  DP_SendByte(port,src,srclen);
	//write("Sending %d bytes...",srclen);
	for(n=0;n<srclen;n++)
	{
	//	write("0x%02X ",src[n]);
	}

	return 1;
}
//控制继电器输出，导通 io:1为通道1';2为通道2
int OpenDO(int addr,int io,byte src[])
{
	int index;
  word crc;
  index =0;
	src[index++] = addr;
	src[index++] = 0x05;
	src[index++] = 0x00;
	src[index++] = io-1;//端口
	src[index++] = 0xff;//导通
	src[index++] = 0x00;
  

  crc = usMBCRC16(src,index);
	src[index++]  = crc&0xff;
	src[index++]  = crc>>8;
	return index;
}
int CloseDO(int addr,int io,byte src[])
{
	int index = 0;
  word crc;
  index =0;
	src[index++] = addr;
	src[index++] = 0x05;
	src[index++] = 0x00;
	src[index++] = io-1;//端口
	src[index++] = 0x00;//关闭
	src[index++] = 0x00;
  

	crc = usMBCRC16(src,index);
	src[index++]  = crc&0xff;
	src[index++]  = crc>>8;
	return index;
}
int ReadDO(int addr,int ionum,byte src[])//ionum指需要获取的DO口数目，不是序号
{
	int index;
  word crc;
  index=0;
	src[index++] = addr;
	src[index++] = 0x01;
	src[index++] = 0x00;
	src[index++] = 0x00;
	src[index++] = 0x00;
	src[index++] = ionum;

  crc = usMBCRC16(src,index);
	src[index++]  = crc&0xff;
	src[index++]  = crc>>8;
  if(ionum>6)
  {
    teststep("","发送DAM继电器控制指令异常！");
    write("发送DAM继电器控制指令异常！");
		return 0;
  }
	return index;
}
int WriteDO(int addr,int info1,int info2,int info3,int info4,byte src[])
{
	int index;
  word crc ;
  index=0;
	src[index++] = addr;
	src[index++] = 0x0f;
	src[index++] = 0x00;
	src[index++] = 0x00;
	src[index++] = 0x00;
	src[index++] = 32;
	src[index++] = 4;
	src[index++] = info1;
	src[index++] = info2;
	src[index++] = info3;
	src[index++] = info4;

  crc= usMBCRC16(src,index);
	src[index++]  = crc&0xff;
	src[index++]  = crc>>8;
	return index;
}

  


int SetRelayClose(byte portnum)//目前我们使用的DAM继电器IO口最大到6
{
  
 
  int index;
  int i;
	byte src[200];
	int srclen = 0;

  if(RealType==DAM)
  {
   srclen = CloseDO(DevAddr,portnum,src);
  if(portnum>6)
	{
    teststepFail("","发送DAM继电器控制指令错误！");
		write("发送DAM继电器控制指令错误！");
		return 0;
	}
 
	SendAndRead(RelayControlCom,src,srclen);
 if(testWaitForTextEvent(gSerialSendData,2000))
  {
  // write("串口指令发送成功");
   if(testWaitForTextEvent(gSerialReceivedData,2000))
  {
  // write("接收到已发出的DAM继电器控制指令的串口返回数据");
//   for(i=0;i<gLastReceiveLength;i++)
//   {
//    if(src[i]!=gReceivedBuffertemp[i])
//    {
//     write("断开当前DAM继电器端口[%d]异常,%.0fms -> 接收数据：ReceivedData[%d]:0x%02X",portnum,timeNowfloat()/100.0,i,gReceivedBuffertemp[i]);
//     testStepFail("","断开当前DAM继电器端口[%d]异常,%.0fms -> 接收数据：ReceivedData[%d]:0x%02X",portnum,timeNowfloat()/100.0,i,gReceivedBuffertemp[i]);
//     return 0;
//    }
//   }
  }
  else
  {
   testStepFail("未接收到已发出控制指令的串口返回数据，请检查DAM继电器状态");
   write("未接收到已发出控制指令的串口返回数据，请检查DAM继电器状态");
   return 0;
   } 
  }
  else
    {
      testStepFail("串口指令发送失败");
      write("串口指令发送失败");
      return 0;
    }
  }
  else
  {
  index=0;
  src[index++] = 0x00;
	src[index++] = 0x0F & portnum;//断开端口
	src[index++] = 0xff;
  if(portnum>8)
	{
    teststepFail("","发送QYF继电器指令错误！");
		write("发送QYF继电器指令错误！");
		return 0;
	}
 
	SendAndRead(RelayControlCom,src,index);
 if(testWaitForTextEvent(gSerialSendData,2000))
  {
  // write("串口指令发送成功");
  if(testWaitForTextEvent(gSerialReceivedData,2000))
  {
  // write("接收到已发出的QYF继电器控制指令的串口返回数据");
  #if 0//使用条件编译，目前调试发现QYF的继电器串口返回数据偶尔会异常，因此这样具体判断串口返回字段会有问题，而DAM相对稳定
   for(i=0;i<gLastReceiveLength;i++)
   {
    if(gReceivedBuffertemp[i]!=QYFSigleCloseRespData[i])
    {
      write("断开当前QYF继电器端口[%d]异常,%.0fms -> 接收数据：ReceivedData[%d]:0x%02X",portnum,timeNowfloat()/100.0,i,gReceivedBuffertemp[i]);
      testStepFail("","断开当前QYF继电器端口[%d]异常,%.0fms -> 接收数据：ReceivedData[%d]:0x%02X",portnum,timeNowfloat()/100.0,i,gReceivedBuffertemp[i]);
      return 0;
    }
   }
  #endif
  }
 else
  {
   testStepFail("未接收到已发出控制指令的串口返回数据，请检查QYF继电器状态");
   write("未接收到已发出控制指令的串口返回数据，请检查QYF继电器状态");
   return 0;
  } 
  }
 else
  {
    testStepFail("串口指令发送失败");
    write("串口指令发送失败");
    return 0;
  }
 }
  teststep("","继电器端口[%d]断开成功",portnum);
  write("继电器端口[%d]断开成功",portnum);
	return 1;
}
