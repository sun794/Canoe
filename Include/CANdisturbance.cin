variables
{
  enum LineDisturbance
  {
    CANHshortCANL,
    CANLshortGND,
    CANHcutCANL,
    CANLcutCANH,
    CANHshortUbat
  };  
  
  int startsampletest;//为了防止测试其他非采样点用例时触发该系统变量，导致异常增加该标志
  const float TICK_LENGTH = 6.25; //One tick is 6.25 ns long

  
  enum CANFramePhase
  {
    eInvalidPhase = -1,
    eArbitrationPhase = 0,
    eDataPhase = 1
  };
  
  struct CANDisturbanceSettings
  {
    int   TicksOneTimeQuanta;
    int   TicksOneBitTime;
    float Baudrate;
    int   Tseg1;
    int   Tseg2;
    enum  CANFramePhase Phase;
  };
  
   struct FieldDefinition
  {
    sysvarString * sysVarName;
    int offsetStream;
    int offsetInField;
    int length;
    int fieldIndex;
  };
  
  struct SamplePointTestMeasurementData
  {
    double MeasuredSamplePoint;
    double CalculatedSP       ;
    double SamplePointMin     ;
    double SamplePointMax     ;
    double TqError            ;
    double TqSyncInPercent    ;
    int TicksRemained         ;
    int TicksAll              ;
    int Tseg1                 ;
    int Tseg2                 ;
    int TqAll                 ;
  };
  
  enum SegmentValue
  {
    eInvalidSegmentValue         = -1,
    eDominantSegmentValue        = 0,
    eRecessiveSegmentValue       = 1,
    eRecessiveStressSegmentValue = 2
  };
  
}

/// <BitTime_TickConvertions>
//*************************************************************************************************
//  Function name : CommonCANDisturbanceLibrary_Get_ArbitrationPhase_Bit_Ticks(long deviceID)
//  ------------------------------------------------------------------------------------------------
//  Description   : This function calcuate the needed number of ticks for one bit within the 
//                  arbitration phase for the CAN Disturbance Interface. 
//  ------------------------------------------------------------------------------------------------
//  Parameter     : deviceID                the CAN Disturbance Identifier
//  ------------------------------------------------------------------------------------------------
//  Returncode    : return (1 = success/ 0 = failure)
//**************************************************************************************************
void CommonCANDisturbanceLibrary_Get_BitTiming_Settings_For(long deviceID, enum  CANFramePhase Phase, struct CANDisturbanceSettings settings)
{
  dword       channelNo;
  CANSettings arbSettings;
  CANSettings dbrSettings;
  
  channelNo = CommonCANDisturbanceLibrary_Get_ChannelNo(deviceID);
  canFdGetConfiguration(channelNo, arbSettings, dbrSettings);
  
  if(dbrSettings.baudrate == 0.0)
  {
    Phase = eArbitrationPhase;
  }
  
  switch(Phase)
  {
    case eArbitrationPhase:
      settings.Baudrate = arbSettings.baudrate;
      settings.TicksOneTimeQuanta = ((1e9 / arbSettings.baudrate) / (arbSettings.tseg1 + arbSettings.tseg2 + 1)) / TICK_LENGTH;
      settings.TicksOneBitTime = (1e9 / arbSettings.baudrate) / TICK_LENGTH;
      settings.Tseg1 = arbSettings.tseg1;
      settings.Tseg2 = arbSettings.tseg2;
      settings.Phase = eArbitrationPhase;
      break;
    case eDataPhase:
      settings.Baudrate = dbrSettings.baudrate;
      settings.TicksOneTimeQuanta = ((1e9 / dbrSettings.baudrate) / (dbrSettings.tseg1 + dbrSettings.tseg2 + 1)) / TICK_LENGTH;
      settings.TicksOneBitTime = (1e9 / dbrSettings.baudrate) / TICK_LENGTH;
      settings.Tseg1 = dbrSettings.tseg1;
      settings.Tseg2 = dbrSettings.tseg2;
      settings.Phase = eDataPhase;
      break;
  }
}

/// <FrameTriggerDefined>
//*************************************************************************************************
//  Function name : CommonCANDisturbanceLibrary_Deactivate_Configured_Trigger()
//  ------------------------------------------------------------------------------------------------
//  Description   : This function is used for disable the active configured trigger condition 
//                  of the CAN Disturbance Interface. 
//  ------------------------------------------------------------------------------------------------
//  Parameter     : busOffCounter         counter, which specifies how often a BusOff should occur
//                  msgOccurence          flag, which indicates, whether messages should occur
//                                        during BusOff waiting phase
//                  msgId                 message id of the message, which should be destroyed
//  ------------------------------------------------------------------------------------------------
//  Returncode    : return (1 = success/ 0 = failure)
//**************************************************************************************************
void CommonCANDisturbanceLibrary_Deactivate_Configured_Trigger(int deviceID)
{
  long ret;

  if(CommonCANDisturbanceLibrary_Get_Trigger_State(deviceID) != 0)
  {
    ret = canDisturbanceTriggerDisable(deviceID);
  }
}


/// <FrameTriggerDefined>
//*************************************************************************************************
//  Function name : CommonCANDisturbanceLibrary_BusOff_ID_Independed(long deviceID)
//  ------------------------------------------------------------------------------------------------
//  Description   : This function is used to configure the CAN Disturbance Interface for a all IDs
//                  ,which had to be destroy. All CAN or CAN FD message, will be disturbed.
//  ------------------------------------------------------------------------------------------------
//  Parameter     : deviceID                the CAN Disturbance Identifier
//  ------------------------------------------------------------------------------------------------
//  Returncode    : return (1 = success/ 0 = failure)
//**************************************************************************************************
byte CommonCANDisturbanceLibrary_BusOff_ID_Independed(long deviceID)
{
  byte result;
  long ret;
  long flags;
  word ticksPerBit;
  message *              msg;
  canDisturbanceSequence seq;
  canDisturbanceFrameTrigger trg;
  canDisturbanceTriggerRepetitions rep;
  struct CANDisturbanceSettings seqSettings;
  //------------------------------------------------------------------------
  //Rest the sequence
  //------------------------------------------------------------------------  
  seq.clear();
  result = 1;
  //------------------------------------------------------------------------
  
  //------------------------------------------------------------------------
  //Configure trigger execution times
  //------------------------------------------------------------------------
  rep.Cycles = 1;
  rep.HoldOffCycles = 0;
  rep.HoldOffRepetitions = 0;
  rep.Repetitions = 32;
  //------------------------------------------------------------------------
  
  //------------------------------------------------------------------------
  // Output one dominant bit
  //------------------------------------------------------------------------
  CommonCANDisturbanceLibrary_Get_BitTiming_Settings_For(deviceID, eArbitrationPhase, seqSettings);
  ticksPerBit = seqSettings.TicksOneBitTime;
  write("ticksPerBit %d", ticksPerBit);
  seq.AppendToSequence(ticksPerBit, 'd');
  //------------------------------------------------------------------------
  
  //------------------------------------------------------------------------
  //Configure trigger position
  //------------------------------------------------------------------------
  trg.SetMessage(msg, deviceID, 0); //Set all fields to don't care
  trg.TriggerFieldType = @CanDisturbance::Enums::FieldType::CRC;
  trg.TriggerFieldOffset = 21;
  flags = sysvar::CanDisturbance::Enums::TriggerEnable::TriggerIfBitMissing;
  //------------------------------------------------------------------------
  
  
  //------------------------------------------------------------------------
  // configure and active trigger condition
  //------------------------------------------------------------------------  
  ret = canDisturbanceTriggerEnable(deviceID, trg, seq, rep, flags);
  //------------------------------------------------------------------------
  
  if (ret != 1)
  {
     result = 0;
  }
  
  return result;
}

/// <FrameTriggerDefined>
//*************************************************************************************************
//  Function name : CommonCANDisturbanceLibrary_BusOff_ID(long deviceID, dword msgId)
//  ------------------------------------------------------------------------------------------------
//  Description   : This function is used to configure the CAN Disturbance Interface for a specific ID
//                  ,which had to be destroy. Behind the ID could be a CAN or CAN FD message.
//  ------------------------------------------------------------------------------------------------
//  Parameter     : deviceID              the CAN Disturbance Identifier
//                  msgId                 message id of the message, which should be destroyed
//  ------------------------------------------------------------------------------------------------
//  Returncode    : return (1 = success/ 0 = failure)
//**************************************************************************************************
byte CommonCANDisturbanceLibrary_BusOff_ID(long deviceID, dword msgId)
{
  byte                             result;
  long                             ret;
  long                             flags;
  word                             ticksPerBit;
  message *                        msg;
  canDisturbanceFrameTrigger       frameTrigger;
  canDisturbanceTriggerRepetitions reps;
  canDisturbanceSequence           rawSequence;
  struct CANDisturbanceSettings    seqSettings;

  rawSequence.clear();
  flags = 0;
  
  reps.Cycles = 1;
  reps.Repetitions = 32;
  reps.HoldOffRepetitions = 0;
  reps.HoldOffCycles = 0;

  result = 1;
  
  CommonCANDisturbanceLibrary_Get_BitTiming_Settings_For(deviceID, eArbitrationPhase, seqSettings);
  ticksPerBit = seqSettings.TicksOneBitTime;
  ret = rawSequence.AppendToSequence(ticksPerBit, 'd');
  
  if (ret != 1)
  {
    result = 0;
  }
  else
  {
    flags = @CanDisturbance::Enums::ValidityMaskFlags::IDBase
            | @CanDisturbance::Enums::ValidityMaskFlags::IDExtended
            | @CanDisturbance::Enums::ValidityMaskFlags::IDE;
    
    msg.id = msgId;
    frameTrigger.TriggerFieldOffset = 21;
    frameTrigger.TriggerFieldType = @CanDisturbance::Enums::FieldType::CRC;
    ret = frameTrigger.SetMessage(msg, deviceID, flags);
    
    if (ret != 1)
    {
      result = 0;
    }
    else
    {
      flags = sysvar::CanDisturbance::Enums::TriggerEnable::TriggerIfBitMissing;
      ret = canDisturbanceTriggerEnable(deviceID, frameTrigger, rawSequence, reps, flags);
      if (ret != 1)
      {
        result = 0;
      }
    }
  }

  return result;
}

/// <FrameTriggerDefined>
//*************************************************************************************************
//  Function name : CommonCANDisturbanceLibrary_DisturbAllECUMessageswithoutNMH(long deviceID, dword startID, dword endID)
//  ------------------------------------------------------------------------------------------------
//  Description   : This function is used to configure the CAN Disturbance Interface for a specific ID
//                  ,which had to be destroy. Behind the ID could be a CAN or CAN FD message.
//  ------------------------------------------------------------------------------------------------
//  Parameter     : deviceID              The CAN Disturbance Identifier
//                  minMsgID              Start Id of message range
//                  maxMsgID              End   Id of message range
//  ------------------------------------------------------------------------------------------------
//  Returncode    : return (1 = success/ 0 = failure)
//**************************************************************************************************
byte CommonCANDisturbanceLibrary_DisturbAllECUMessageswithoutNMH(int deviceID, dword startID, dword endID)
{
  byte result;
  canDisturbanceSequence seq;
  canDisturbanceFrameTrigger trg;
  canDisturbanceTriggerRepetitions rep;
  message 1 msg;
  long triggerEnableFlags = 0;
  long ret;
  int count;
  dword mask;

  result = 1;
  seq.clear();

  rep.Cycles = 1;
  rep.HoldOffCycles = 0;
  rep.HoldOffRepetitions = 0;
  rep.Repetitions = 0;
  
  // Output one dominant bit
  //seq.AppendToSequence(ticksPerBit, 'd');

  trg.SetMessage(msg, deviceID, 0);

  if (startID & 0x80000000)   //extended ID
  {
    trg.IDE = 1;
    mask = 0x10000000;
  } 
  else //standard ID
  {
    trg.IDE = 0;
    mask = 0x400;
  }

  for (count = 10; count >=0; count--) 
  {
    if ((startID & mask) == (endID & mask)) 
    {
      if (startID & mask) 
      {
        trg.IDBase[count] = 1;
      }
      else 
      {
        trg.IDBase[count] = 0;
      }
    } 
    else 
    {
      trg.IDBase[count] = -1;
    }
    
    mask = mask >> 1;
  }

  if (startID & 0x80000000) 
  {
    //extended ID
    for (count = 17; count >=0; count--) 
    {
      if ((startID & mask) == (endID & mask)) 
      {
        if (startID & mask) 
        {
          trg.IDExtended[count] = 1;
        } 
        else 
        {
          trg.IDExtended[count] = 0;
        }
      } 
      else 
      {
        trg.IDExtended[count] = -1;
      }
      
      mask = mask >> 1;
    }
  }

  trg.TriggerFieldType = @CanDisturbance::Enums::FieldType::CRC;
  trg.TriggerFieldOffset = 21;
  
  triggerEnableFlags |= sysvar::CanDisturbance::Enums::TriggerEnable::TriggerDirectionRx;
  triggerEnableFlags |= sysvar::CanDisturbance::Enums::TriggerEnable::InvertedTrigger;
  triggerEnableFlags |= sysvar::CanDisturbance::Enums::TriggerEnable::TriggerIfBitMissing;
  
  ret = canDisturbanceTriggerEnable(deviceID, trg, seq, rep, triggerEnableFlags);
  
  if (ret != 1)
  {
    result = 0;
  }
  
  return result;
}

/// <GenericSysVarAccessToDeviceValues>
int CommonCANDisturbanceLibrary_Get_Trigger_State(int deviceID)
{
  char sysVarNameSpace[1024];
  long value;
  long result;
  snprintf(sysVarNameSpace, elCount(sysVarNameSpace), "CANDisturbanceInterface%d::Trigger", deviceID);
  
  result = sysGetVariableInt(sysVarNameSpace, "State", value);
  
  if(result == 0)
  {
    return value;
  }
  
  return -1;
}

