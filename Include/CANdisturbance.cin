/// <FrameTrigger>
//------------------------------------------------------------------------------------
//Write the field definition 
//
//@param field - the index value of the field [in]
//@param def   - the struct definition for the field parameter [inout]
//@return      - the start position of the field within the stream without stuff bits
//------------------------------------------------------------------------------------
int CommonCANDisturbanceLibrary_Get_FieldDefinition_For(int field, struct FieldDefinition def)
{
  int returnValue;
  
  returnValue = -1;
  
  switch(field)
  {
    case 0:
      def.offsetInField = 0;
      def.offsetStream  = 0;
      def.length = 1;      
      returnValue = 0;
      break;
    case 1:       
      def.offsetInField = 0;
      def.offsetStream  = 1;
      def.length = 11;      
      returnValue = 1;
      break;
    case 2:       
      def.offsetInField = 0;
      def.offsetStream =14;
      def.length = 18;
      returnValue = 32;
      break;
    case 3:       
      def.offsetStream = 12;
      def.offsetInField = 0;
      def.length = 1;
      returnValue = 12;
      break;
    case 4: 
      def.offsetStream = 13;
      def.offsetInField = 0;
      def.length = 1;
      returnValue = 13;
      break;
    case 5: 
      def.offsetStream = 32;
      def.offsetInField = 0;
      def.length = 1;
      returnValue = 32;
      break;
    case 6: 
      def.offsetStream = 33;
      def.offsetInField = 0;
      def.length = 1;
      returnValue = 33;
      break;
      break;
    case 7: 
      def.offsetStream = 34;
      def.offsetInField = 0;
      def.length = 1;
      returnValue = 34;
      break;
    case 8: 
      def.offsetStream = 35;
      def.offsetInField = 0;
      def.length = 1;
      returnValue = 35;
      break;
    case 9: 
      def.offsetStream = 36;
      def.offsetInField = 0;
      def.length = 1;
      returnValue = 36;
      break;
    case 10:
      def.offsetStream = 37;
      def.offsetInField = 0;
      def.length = 4;
      returnValue = 37;
      break;
    case 75:
      def.offsetStream = 41 + 8 * 64;
      def.offsetInField = 0;
      def.length = 4;
      returnValue = 41 + 8 * 64;
      break;
    case 76:
      def.offsetStream = 41 + 8 * 64 + 4;
      def.offsetInField = 0;
      def.length = 21;
      returnValue = 41 + 8 * 64 + 4;
      break;
    case 77:
      def.offsetStream = 41 + 8 * 64 + 4 + 21;
      def.offsetInField = 0;
      def.length = 1;
      returnValue = 41 + 8 * 64 + 4 + 21;      
      break;
    case 78:
      def.offsetStream = 41 + 8 * 64 + 4 + 21 + 1;
      def.offsetInField = 0;
      def.length = 1;
      returnValue = 41 + 8 * 64 + 4 + 21 + 1;            
      break;
    case 79:
      def.offsetStream = 41 + 8 * 64 + 4 + 21 + 2;
      def.offsetInField = 0;
      def.length = 1;
      returnValue = 41 + 8 * 64 + 4 + 21 + 1 + 2;            
      break;
    default:
      break;
  }
  
  if(field >= 11 && field <= 74)
  {
    def.offsetStream  = 41 + 8 * (field - 11);
    def.offsetInField = 8 * (field - 11);
    def.length = 8;
    returnValue = 41 + 8 * (field - 11);
  }
  
  if(returnValue < 0)
  {
    def.fieldIndex = @sysvar::CanDisturbance::Enums::FieldType::Invalid;
  }
  else
  {
    def.fieldIndex = field;
  }
  
  return returnValue;
  
}

/// <FrameTrigger>
//------------------------------------------------------------------------------------
//Set the current value to frame trigger value 
//
//@param fieldType      - the enumeration type of CanDisturbance::Enums::FieldType  [in]
//@param valueAsString  - the value as string for the trigger field (e.g. "0x100x") [in]
//@param frameTrigger   - the frame trigger object                                  [in]
//@return               - return 1 if field set was possible, otherwise -1          [out]
////------------------------------------------------------------------------------------
int CommonCANDisturbanceLibrary_Set_FrameTrigger_Field(int fieldType, char valueAsString[], canDisturbanceFrameTrigger frameTrigger)
{
  struct FieldDefinition fieldDef;
  long result;
  result = CommonCANDisturbanceLibrary_Get_FieldDefinition_For(fieldType, fieldDef);
  
  if(result > 0)
  {
    result = CommonCANDisturbanceLibrary_Set_FrameTrigger_Field(fieldDef, valueAsString, frameTrigger);
  }
  else
  {
    result = -1;
  }
  
  return result;
}


/// <FrameTrigger>
//------------------------------------------------------------------------------------
//Set the current value to frame trigger value 
//
//@param fieldDef       - the struct definition for the field parameter             [in]
//@param valueAsString  - the value as string for the trigger field (e.g. "0x100x") [in]
//@param framTrigger    - the frame trigger object                                  [in]
//@return               - return 1 if field set was possible, otherwise -1          [out]
////------------------------------------------------------------------------------------
int CommonCANDisturbanceLibrary_Set_FrameTrigger_Field(struct FieldDefinition fieldDef, char valueAsString[], canDisturbanceFrameTrigger frameTrigger)
{
  char value[2];
  long result;
  
  result = 1;
  
  switch(fieldDef.fieldIndex)
  {
    case 1:       
      CommonCANDisturbanceLibrary_Convert_String_Value_To_Trigger_Value(fieldDef, valueAsString, frameTrigger.IDBase);
      break;
    case 2:       
      CommonCANDisturbanceLibrary_Convert_String_Value_To_Trigger_Value(fieldDef, valueAsString, frameTrigger.IDExtended);
      break;
    case 3:       
      CommonCANDisturbanceLibrary_Convert_String_Value_To_Trigger_Value(fieldDef, valueAsString, value);
      frameTrigger.RemoteBase = value[0];
      break;
    case 4: 
      CommonCANDisturbanceLibrary_Convert_String_Value_To_Trigger_Value(fieldDef, valueAsString, value);
      frameTrigger.IDE = value[0];
      break;
    case 5:       
      CommonCANDisturbanceLibrary_Convert_String_Value_To_Trigger_Value(fieldDef, valueAsString, value);
      frameTrigger.RemoteExtended = value[0];
      break;
    case 6: 
      CommonCANDisturbanceLibrary_Convert_String_Value_To_Trigger_Value(fieldDef, valueAsString, value);
      frameTrigger.FDF = value[0];
      break;
    case 7: 
      CommonCANDisturbanceLibrary_Convert_String_Value_To_Trigger_Value(fieldDef, valueAsString,  value);
      frameTrigger.Reserved = value[0];
      break;
    case 8: 
      CommonCANDisturbanceLibrary_Convert_String_Value_To_Trigger_Value(fieldDef, valueAsString, value);
      frameTrigger.BRS = value[0];
      break;
    case 9: 
      CommonCANDisturbanceLibrary_Convert_String_Value_To_Trigger_Value(fieldDef, valueAsString, value);
      frameTrigger.ESI = value[0];
      break;
    case 10:
      CommonCANDisturbanceLibrary_Convert_String_Value_To_Trigger_Value(fieldDef, valueAsString, frameTrigger.DLC);
      break;
    case 75:
      CommonCANDisturbanceLibrary_Convert_String_Value_To_Trigger_Value(fieldDef, valueAsString, frameTrigger.StuffCount);
      break;
    case 76:
      CommonCANDisturbanceLibrary_Convert_String_Value_To_Trigger_Value(fieldDef, valueAsString, frameTrigger.CRC);
      break;
    case 77:
      CommonCANDisturbanceLibrary_Convert_String_Value_To_Trigger_Value(fieldDef, valueAsString, value);
      frameTrigger.CRCDelimiter = value[0];
      break;
    case 78:
      CommonCANDisturbanceLibrary_Convert_String_Value_To_Trigger_Value(fieldDef, valueAsString, value);
      frameTrigger.AckSlot = value[0];
      break;
    case 79:
      CommonCANDisturbanceLibrary_Convert_String_Value_To_Trigger_Value(fieldDef, valueAsString, value);
      frameTrigger.AckDelimiter = value[0];
      break;
    case 80:
      break;
    default:
      if(fieldDef.fieldIndex >= 11 && fieldDef.fieldIndex <= 74)
      {
        CommonCANDisturbanceLibrary_Convert_String_Value_To_Trigger_Value(fieldDef, valueAsString, frameTrigger.Payload);
      }
      else
      {
        result = -1;
      }
      break;
  }
  
  return result;
}

/// <FrameTrigger>
////------------------------------------------------------------------------------------
////Set the current sys var to the char buffer  
//
////@param field      - the struct definition for the field parameter [in]
////@param fieldValue - the frame trigger value [out]
////------------------------------------------------------------------------------------
void CommonCANDisturbanceLibrary_Convert_String_Value_To_Trigger_Value(struct FieldDefinition field, char valueToWrite[], char fieldValue[])
{
  int  currLength;
  int  i;
  
  currLength = strlen(valueToWrite);
  
  for(i = 0; i < field.length ; ++i)
  {
    if( i < currLength)
    {
       fieldValue[field.length - 1 - i + field.offsetInField] = valueToWrite[i] == '0' ? 0 : valueToWrite[i] == 'x' ? -1 : 1; 
    }
    else
    {
      fieldValue[field.length - 1 - i + field.offsetInField] = -1;
    }
  }
}

/// <SamplePointTest>
////------------------------------------------------------------------------------------
////Calculate the sample point by ticks (most cases measured) and calcuate the possible 
////sample point that is configurabe for a baudrate with a given prescaler and quarz frequency.
////
////@param baudrate        - the baudrate the sample point was measured [in]
////@param prescaler       - the prescaler which defines the possible sample points [in]
////@param quarzFrequency  - the quarz frequency used for the CAN clock [in]
////@param data            - containes the measured sample point and the calculated bit timings [inout]
////@param ticksRemained   - count of remained ticks of the shorten bit [in]
////@param ticksAll        - count of ticks before the bit was shorten [in]
////@return - 1 if calculation was possible, otherwise 0
////------------------------------------------------------------------------------------
int CommonCANDisturbanceLibrary_Calculate_SamplePoint_For(float baudrate, int prescaler, int quarzFrequency, struct SamplePointTestMeasurementData data, int ticksRemained, int ticksAll)
{
  int result;
  //--------------------------------------------------------------------------------------------
  //Measurment errors
  //--------------------------------------------------------------------------------------------
  float tqSyncInPercent;  //tqSync error, because sampling is done in the middle of the tq
  float tqError;          //time of one tq based on prescaler
  
  //--------------------------------------------------------------------------------------------
  //Calculated values and values needed to calculate "correct" sample point
  //--------------------------------------------------------------------------------------------  
  int    tqAllForPrescaler;    // Count of possible TQs based on prescaler
  float  bitTime;              // bit time depends on baudrate in ns
  int    tqAll;                // Calculated count of TQs by calculated TSEG1 and TSEG2
  float  calculatedSP;         // sample point calculated by TSEG1 and TSEG2 value
  float  spPoint;              // Sample point measured by ticks 
  int    newTseg1;             // Tseg1 calculated by the measured sample point with prescaler eq 1 and 80 MHz
  int    newTseg2;             // Tseg2 calculated by the measured sample point with prescaler eq 1 and 80 MHz
  double timeInBit;            // VH601 time in bit
  double timeInBit2;           // Calc time based on prescaler and quarzFrequncy
  double timeInBitDiff;        // Diff time between prescaler and VH6501 measurement
  double prescalerTQTime;      // Time of one TQ for the prescaler based on quarzFrequency
  //--------------------------------------------------------------------------------------------
  result          = 1;
  bitTime         = (1000000000.0 / baudrate);
  prescalerTQTime = 1.0 / quarzFrequency * 1000 * prescaler; //in ns
  
  //-------------------------------------------------------------------------------------------------------------------------------
  //Calc sample point the error frame was seen  
  //-------------------------------------------------------------------------------------------------------------------------------
  spPoint    = ticksRemained * 1.0 / ticksAll;
  data.MeasuredSamplePoint = spPoint * 100;
  
  //-------------------------------------------------------------------------------------------------------------------------------
  //Calc the difference of measured sample point and sample point based on prescaler
  //-------------------------------------------------------------------------------------------------------------------------------
  timeInBit     = ticksRemained * TICK_LENGTH;     //VH601 time in bit
  newTseg1      = timeInBit / prescalerTQTime;  //Calc TSEG1 (inclusive SYNC-Field)
  timeInBit2    = newTseg1 * prescalerTQTime;   //Calc time based prescaler TQ
  timeInBitDiff = timeInBit - timeInBit2;       //Calc diff time between measurement and calculated sample point based on prescaler
  
  tqError  = prescalerTQTime * 100 / bitTime;
  newTseg1 = spPoint * bitTime / prescalerTQTime;
  newTseg2 = (newTseg1 + 1.0) / spPoint - newTseg1-1;
  tqAll    = newTseg1 + newTseg2 + 1;
  
  tqAllForPrescaler = (bitTime / prescalerTQTime);
  
  if(tqAllForPrescaler * prescalerTQTime != bitTime)
  {
    write("Prescaler not possible %d", prescaler);
    result = -1;
  }
  else
  {
    write("tqAll =%d tqAllForPrescalerOne =%d",tqAll, tqAllForPrescaler);
    
    if(tqAll != tqAllForPrescaler)
    {
     int delta;
     delta = tqAll - tqAllForPrescaler;
     write("delta =%d", delta);
     newTseg1 += delta;
     newTseg2 = tqAllForPrescaler - newTseg1-1;
     tqAll    = newTseg1 + newTseg2 + 1;
    }
    write("tqAll =%d tqAllForPrescalerOne =%d",tqAll, tqAllForPrescaler);
    //-------------------------------------------------------------------------------------------------------------------------------
    
    //-------------------------------------------------------------------------------------------------------------------------------
    //Calc Tq difference for sample point, because sample point is inital within TQ / 2
    //Is only for vector interfaces or if ECU also sample in the middle of the TQ
    //-------------------------------------------------------------------------------------------------------------------------------
    tqSyncInPercent = 1 * 100.0 / tqAll / 2;
    //-------------------------------------------------------------------------------------------------------------------------------
    
    //-------------------------------------------------------------------------------------------------------------------------------
    //Set measured and calcualted data 
    //-------------------------------------------------------------------------------------------------------------------------------
    calculatedSP = (newTseg1 + 1.0) / (newTseg1 + newTseg2 + 1.0);
    
    data.CalculatedSP    = calculatedSP * 100;
    data.SamplePointMin  = data.CalculatedSP  - tqError;
    data.SamplePointMax  = data.CalculatedSP;
    data.TqError         = tqError;
    data.TqSyncInPercent = tqSyncInPercent;
    data.TicksRemained   = ticksRemained;
    data.TicksAll        = ticksAll;
    data.Tseg1           = newTseg1;
    data.Tseg2           = newTseg2;
    data.TqAll           = tqAll;
    //-------------------------------------------------------------------------------------------------------------------------------
  }
  
  return result;
}

/// <SamplePointTest>
////------------------------------------------------------------------------------------
////Shorten a defined bit within a frame sequence field
////
////@param field          - the field which contains the bit to shorten [in]
////@param bitPosition    - the bit number of the bit within the field (0 - first bit; n - last bit) [in]
////@param ticksToShorten - number of ticks the bit should be shorten [in]
////@return - 1 bit was possible to shorten, otherwise 0
////------------------------------------------------------------------------------------
int CommonCANDisturbanceLibrary_Shorten_Bit(canDisturbanceFrameSequenceField field, int bitPosition, int ticksToShorten)
{
  int result;
  
  result = 1;
  
  if(field.BitSequence[bitPosition].segmentLength[0] - ticksToShorten < 5)
  {
    result = 0;
  }
  else
  {
    field.BitSequence[bitPosition].segmentLength[0] = field.BitSequence[bitPosition].segmentLength[0] - ticksToShorten;
  }
  
  return result;
}

/// <SamplePointTest>
////------------------------------------------------------------------------------------
////Shorten a defined bit within a frame sequence field
////
////@param field           - the field which contains the bit to shorten [in]
////@param bitPosition     - the bit number of the bit within the field (0 - first bit; n - last bit) [in]
////@param ticksToLengthen - number of ticks the bit should be lengthen [in]
////@return - 1 bit was possible to lengthen, otherwise 0
////------------------------------------------------------------------------------------
int CommonCANDisturbanceLibrary_Lengthen_Bit(canDisturbanceFrameSequenceField field, int bitPosition, int ticksToLengthen)
{
  int result;
  
  result = 1;
  
  if(field.BitSequence[bitPosition].segmentLength[0] + ticksToLengthen > 65535)
  {
    result = 0;
  }
  else
  {
    field.BitSequence[bitPosition].segmentLength[0] = field.BitSequence[bitPosition].segmentLength[0] + ticksToLengthen;  
  }
  
  return result;
}

/// <SamplePointTest>
////------------------------------------------------------------------------------------
////Flip a bit to the opposit of the current bit value e.g. dominant -> recessive or recessvie -> dominant
////
////@param field            - the field which contains the bit to shorten [in]
////@param bitPosition      - the bit number of the bit within the field (0 - first bit; n - last bit) [in]
////@param overrideDominant - If the flipped value is recessive and domiant value should be overwrite a dominant set to 1, otherwise 0 [in]
////@return - 1 if bit was flipped otherwise 0
////------------------------------------------------------------------------------------
int CommonCANDisturbanceLibrary_Flip_Bit(canDisturbanceFrameSequenceField field, int bitPosition, int overrideDominant)
{
  int result;
  
  result = 1;
  
  if(bitPosition < 0 || bitPosition >= field.FieldLength)
  {
    result = 0;  
  }
  else
  {
    if(field.BitSequence[bitPosition].segmentValue[0] == 'd')
    {
      field.BitSequence[bitPosition].segmentValue[0] = overrideDominant == 1 ? 'R' : 'r';  
    }
    else
    {
      field.BitSequence[bitPosition].segmentValue[0] = 'd';  
    }
  }
  
  return result;
}

/// <SamplePointTest>
////------------------------------------------------------------------------------------
////Set a specific bit value for a bit within a field
////
////@param field       - the field which contains the bit to shorten [in]
////@param bitPosition - the bit number of the bit within the field (0 - first bit; n - last bit) [in]
////@param segValue    - the value should be set  [in]
////@return - 1 if bit was flipped otherwise 0
////------------------------------------------------------------------------------------
int CommonCANDisturbanceLibrary_Set_Bit_Value_To(canDisturbanceFrameSequenceField field, int bitPosition, enum SegmentValue segValue)
{
  int result;
  
  result = 1;
  
  if(bitPosition < 0 || bitPosition >= field.FieldLength)
  {
    result = 0;  
  }
  else
  {
    switch(segValue)
    {
      case eInvalidSegmentValue: result = 0; break;
      case eDominantSegmentValue: field.BitSequence[bitPosition].segmentValue[0] = 'd'; break;
      case eRecessiveSegmentValue: field.BitSequence[bitPosition].segmentValue[0] = 'r'; break;
      case eRecessiveStressSegmentValue: field.BitSequence[bitPosition].segmentValue[0] = 'R'; break;
    }
  }
  return result;
}


/// <AnalogDisturbance>
//CANH_CANL反接故障
void InjectCANH_CANL_ReverseFault()
{
   @sysvar::CANDisturbanceInterface1::Switches::CANh_CANl_Swap::Value = 1;//Reverse
   teststep("","CANH_CANL_Reverse故障");
}
/// <AnalogDisturbance>
//移除CANH_CANL反接故障
void RemoveCANH_CANL_ReverseFault()
{
   @sysvar::CANDisturbanceInterface1::Switches::CANh_CANl_Swap::Value = 0;//normal
   teststep("","移除CANH_CANL_Reverse故障");
}
/// <AnalogDisturbance>
//CANH_Vbat故障
