/// <GenericSysVarAccessToDeviceValues>
int CommonCANDisturbanceLibrary_Get_Trigger_Source(int deviceID, char sourceAsString[])
{
  char sysVarNameSpace[1024];
  long value;
  long result;

  snprintf(sysVarNameSpace, elCount(sysVarNameSpace), "CANDisturbanceInterface%d::Trigger", deviceID);
  result = sysGetVariableInt(sysVarNameSpace, "Source", value);
  
  if(result == 0)
  {
    sysGetVariableDescriptionForValue(sysVarNameSpace, "Source", value, sourceAsString, elCount(sourceAsString));
    return value;
  }
  
  return -1;
}

