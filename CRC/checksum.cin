//用于奇瑞捷途D01项目的应用报文CRC校验 
//SAE J1850 CRC-8 是一种常用于汽车通信协议的循环冗余校验（CRC）算法
//以下多项式固定为可输入的变量
byte J1850_CRC8_Poly_cheery(byte buffer[], byte length, byte CRC8_Poly)
{
  byte checksum,i,j;
 //byte CRC8_Poly = 0x1D;
  checksum = 0x00;
 //CRC8_Poly = 0x1D;
  for(i=0; i<length; i++)
  {
    checksum = checksum ^ buffer[i];

    for( j=0; j<8; j++ )
    {
      if(checksum & 0x80)
      {
        checksum = ((checksum << 1) ^ CRC8_Poly);  // POLY = 0x2F
      }
      else
      {
        checksum = (checksum << 1);
      }
    }
  }
  checksum = checksum ^ 0x00;
  return checksum;
}


byte E2E_CRC8_Table(byte data[],byte d_length,byte initial_value)
{
  int i;
  byte crc8;
  
  // crc8 = initial_value; // crc 计算的初始值
  crc8 = 0xff; // crc 计算的初始值
  
  for (i = 1; i < d_length + 1; i++)                     
  {
    crc8 = Crc8Table[crc8 ^ data[i]];
  }  
  crc8 = crc8 ^ 0xff;
  return crc8;
}

//
byte E2E_CRC8_Table_0(byte data[],byte d_length,byte initial_value)
{
  int i;
  byte crc8;
  
  // crc8 = initial_value; // crc 计算的初始值
  crc8 = 0xff; // crc 计算的初始值
  
  for (i = 0; i < d_length ; i++)                     
  {
    crc8 = Crc8Table[crc8 ^ data[i]];
  }  
  crc8 = crc8 ^ 0x00;
  return crc8;
}

// 适用于ox3B 报文，data 长度为64byte,CRC数据在中间24位置处
byte E2E_CRC8_Table_3B(byte data[],byte d_length,byte initial_value)
{
  int i;
  byte crc8;
  
  // crc8 = initial_value; // crc 计算的初始值
  crc8 = 0xff; // crc 计算的初始值
   
  for (i = 0; i < 24; i++)                     
  {
    crc8 = Crc8Table[crc8 ^ data[i]];
  } 
  
  for (i = 25; i < d_length + 1; i++)                     
  {
    crc8 = Crc8Table[crc8 ^ data[i]];
  } 
  crc8 = crc8 ^ 0xff;
  return crc8;
}


