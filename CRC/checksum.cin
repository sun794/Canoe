word ssh_crc16_cheery(byte buffer[], byte length)
{
  word wCRCin;
  word wCPoly=0x1021;
  dword i,j;
  byte wChar = 0; 
  j=0;
  wCRCin=gc_dwCRC16InitValue;
  
  while(length--) 
  {
    wChar =buffer[j++]; 
    wCRCin ^= (wChar << 8); 
    for(i = 0; i < 8; i++) 
    { 
      if(wCRCin & 0x8000) 
      { 
        wCRCin = (wCRCin << 1) ^ wCPoly; 
      } 
      else 
      { 
        wCRCin = wCRCin << 1; 
      } 
    } 
  }
  wCRCin=wCRCin ^ 0x0000;
  return wCRCin;
}


word calculateCRC16(byte data[], int length)
{
  word crc = 0xFFFF; // 初始值
  int i, j;
  for (i = 0; i < length; i++)
  {
    crc ^= (word)data[i] << 8;
    for (j = 0; j < 8; j++)
    {
      if (crc & 0x8000)
        crc = (crc << 1) ^ 0x1021;
      else
      crc = crc << 1;
    }
  }
  // 输入取反
  crc ^= 0xFFFF;
  return crc;
}

// 计算CRC的函数
word calculateInvertedCRC16(byte data[], int length)
{
  // 对输入数据进行取反操作
  // byte invertedData[length];
  int i;
  word crc;
  for (i = 0; i < length; i++)
  {
    data[i] = ~data[i];
  }

  // 计算CRC
  crc = calculateCRC16(data, 13);
  // 对输出进行取反
  crc ^= 0xFFFF;
  
  return crc;
}


