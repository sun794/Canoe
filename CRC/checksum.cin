void crc32b_init(void)
{
  long bytee;
  dword crc;
  byte bit;
  for ( bytee = 0; bytee < 256; bytee++)
  {
    crc = (dword)bytee; // reflected form
    
    for ( bit = 0; bit < 8; bit++)
      if (crc & 1)
        crc = (crc >> 1) ^ CRC32_REVERSE; // reflected Form
      else
      crc = (crc >> 1);
      
      CRC32_TABLE[bytee] = crc;
  }
    //write("CRC32_TABLE=%d=%d=%d",CRC32_TABLE[0],CRC32_TABLE[125],CRC32_TABLE[255]); 
}

dword crc32b_table_reflect(dword nLength, byte pData[])
{
  dword i;
  dword crc ; // Optimization: crc = CRC32_INIT;
  
  crc=-1;
  
  //write("crc=%d",crc);
  for(i=0;i<nLength;i++)
  {
    //write("pData=%d",pData[i]);
    crc = CRC32_TABLE[(crc ^ pData[i]) & 0xFF] ^ (crc >> 8);
       
  }
  
//while (nLength-- > 0)
//crc = CRC32_TABLE[(crc ^ *pData++) & 0xFF] ^ (crc >> 8); // reflect: >> 8
  
  return ~crc; // Optimization: crc ^= CRC32_DONE
}

byte crc8b_table_reflect(dword nLength, byte pData[])
{
  int tmp = 0x00;
  dword i;
  byte crc = 0x00;
  
  for(i=0;i<nLength;i=i+1)
  {
    tmp = tmp+pData[i];
  }
  crc = ~((byte)tmp);
  
  return crc;
}


word crc16b_table_reflect( word inicrc,dword nLength, byte pData[])
{
  dword i;
  int tmp;
  word crc ; // Optimization: crc = CRC32_INIT;
  crc = inicrc;
  //write("crc=%d",crc);
  
  for(i=0;i<nLength;i++)
  {
    //write("pData=%d",pData[i]);
    tmp = (crc>>8)^pData[i];
    crc = (crc<<8)^crctable[tmp];  
  }

//while (nLength-- > 0)
//crc = CRC32_TABLE[(crc ^ *pData++) & 0xFF] ^ (crc >> 8); // reflect: >> 8
  
  return crc; // Optimization: crc ^= CRC32_DONE
}

word crc16bstart_table_reflect(dword nLength, byte pData[])
{
  dword i;
  int tmp;
  word crc ; // Optimization: crc = CRC32_INIT; 
  crc = FlashCrc;
  //write("crc=%d",crc);
  for(i=0;i<nLength;i++)
  {
    //write("pData=%d",pData[i]);
    tmp = (crc>>8)^pData[i];
    crc = (crc<<8)^crctable[tmp];    
  }

//while (nLength-- > 0)
// crc = CRC32_TABLE[(crc ^ *pData++) & 0xFF] ^ (crc >> 8); // reflect: >> 8
  
  return crc; // Optimization: crc ^= CRC32_DONE
}


word crc16bend_table_reflect( byte data[],int length)
{
  int i;
  word crc = 0xFFFF; // 初始值，可以根据需要调整  
  
  for ( i = 0; i < length; i++) {  
  // 使用查找表并更新CRC值  
    crc = (crc << 8) ^ crctable[((crc >> 8) ^ data[i]) & 0xFF];  
  }
  
  return crc; // Optimization: crc ^= CRC32_DONE
}

//
//以下部分实现counter 进行0~15( 0-0X0F)的累加
byte E2E_Counter_0_F(byte data[],byte c_pos)
{
  // calculate counter
  int Counter;       
  Counter = data[c_pos] & 0x0F;
  Counter++;
  if(Counter > 15)
    Counter = Counter - 16;
  
  Counter = (data[c_pos] & 0xF0)+ Counter;
  return  Counter;
}


//以下部分实现counter 进行0~14的累加 
byte E2E_Counter_0_E(byte data[],byte c_pos)
{
  // calculate counter
  int Counter;       
  Counter = data[c_pos] & 0x0F;
  Counter++;
  if(Counter > 14)
    Counter = Counter - 15;
  
  Counter = (data[c_pos] & 0xF0)+ Counter;
  return  Counter;
}

//定义checksum 函数
//以下函数是实现针对7byte 处理
// ((Byte0+Byte1+….+Byte6) AND 0xFF) XOR 0xFF
word checksum_sum_7B(byte data[])
{
  byte get_data[7];
  word checksum_sum_7B_result = 0;
  int i=0;
	for(i=0;i< 7;i++)
  {
    get_data[i] = data[i];
  }
  
  checksum_sum_7B_result = (((get_data[0 ] + get_data[1 ]  + get_data[2 ]  + get_data[3 ]  + get_data[ 4]  + get_data[ 5] + get_data[ 6] )&0xff) ^ 0xff);
  //write ("the checksum is %lx",result);
  
  return checksum_sum_7B_result;
}
