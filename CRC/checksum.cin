    // 初始化数据 
 //byte data[13]={0x00 ,0x10 ,0x00 ,0x00 ,0x00 ,0x03 ,0x06 ,0x05 ,0x00 ,0x78 ,0x05 ,0x88 ,0x13 }; 
 
  crc16 = crc16bend_table_reflect(data,13);  
