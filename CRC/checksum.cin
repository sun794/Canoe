dword ssh_crc32(byte pdata[], dword dSize_u32,dword oldcrc)
{
  dword i;
  
  for (i = 0; i < dSize_u32; i++)
  {
    oldcrc = TableCRC32[(oldcrc ^ pdata[i]) & 0xff] ^ (oldcrc >> 8);
  }
  return oldcrc;
}

dword ssh_crc32_only(byte pdata[], dword dSize_u32)
{
  dword i, crc32;
  crc32=gc_dwCRC32InitValue;
  
  for (i = 0; i < dSize_u32; i++)
  {
    crc32 = TableCRC32[(crc32 ^ pdata[i]) & 0xff] ^ (crc32 >> 8);
  }
    return crc32;
}

 
dword ssh_crc16(byte pdata[], dword dSize_u16,word oldcrc) //这种是每包的CRC用于下一包计算
{
  long i;
  word tmp;
 
  for (i = 0; i < dSize_u16; i++)
  {
    tmp =(oldcrc>>8)^pdata[i];
    oldcrc=(oldcrc<<8)^awCRC16Table_CITT[tmp];
  }
  //write("oldcrc=0x%x",oldcrc);
  return oldcrc;
}


dword ssh_crc16_only(byte pdata[], dword dSize_u16)  //用固定CRC去计算当前的CRC
{
  long i;
  int tmp;
  word crc16;
  crc16= gc_dwCRC16InitValue;
  
for (i = 0; i < dSize_u16; i++)
  {
    tmp =(crc16>>8)^pdata[i];
    crc16=(crc16<<8)^awCRC16Table_CITT[tmp];
  }
  return crc16;
}


  
 byte ssh_crc8(byte data[],byte d_length,byte oldcrc)
 {
    int i;
 
    for (i = 0; i < d_length; i++)                     
    {
      oldcrc = Crc8Table[ oldcrc ^ data[i]];
    }  
     oldcrc = oldcrc^ 0xff;

    return  oldcrc;
  }

  byte ssh_crc8_only(byte data[],byte d_length)
{
    int i;
    byte crc8;
     
    crc8 =initCRC8Value ; // crc 计算的初始值
   
    for (i = 0; i < d_length; i++)                     
    {
        crc8 = Crc8Table[crc8 ^ data[i]];
    }  
    crc8 = crc8 ^ 0xff;

    return crc8;
}


//用于奇瑞项目的应用报文CRC校验 
//SAE J1850 CRC-8 是一种常用于汽车通信协议的循环冗余校验（CRC）算法
//以下多项式固定为polynomial = 0x1D  # SAE J1850 使用的多项式 0x1D
byte J1850_CRC8_cheery(byte buffer[], byte length)
{
  byte checksum,i,j;
  byte CRC8_Poly = 0x1D;
  checksum = 0x00;
  CRC8_Poly = 0x1D;
  
  for(i=0; i<length; i++)
  {
    checksum = checksum ^ buffer[i];

    for( j=0; j<8; j++ )
    {
      if(checksum & 0x80)
      {
        checksum = ((checksum << 1) ^ CRC8_Poly);  // POLY = 0x2F
      }
      else
      {
        checksum = (checksum << 1);
      }
    }
  }
  checksum = checksum ^ 0x00;
  return checksum;
}

//用于奇瑞捷途项目的应用报文CRC校验 
//SAE J1850 CRC-8 是一种常用于汽车通信协议的循环冗余校验（CRC）算法
//以下多项式固定为可输入的变量
//byte J1850_CRC8_Poly_cheery(byte buffer[], byte length, byte CRC8_Poly)
//{
//  
