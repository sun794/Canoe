  // ================== DTC aging DTC老化测试相关变量 ==================
  message 0x743 dtcDiagTxMsg;
  msTimer dtcFaultObserveTimer;
  msTimer dtcUdsTimer;
  msTimer dtcSleepVerifyStartTimer;

  // 老化状态说明：只描述当前正在等哪一步响应，用于防止旧响应或串响应误推进流程。
  // WAIT_14_CLEAR：等待14清故障响应；WAIT_FAULT_OBSERVE：故障注入后的观察窗口。
  // WAIT_190209：读取DTC列表；WAIT_1906_BASE：读取基线老化计数；WAIT_1906_AFTER_WAKE：每轮唤醒后读取老化计数。
  const int DTC_STATE_IDLE                    = 0;
  const int DTC_STATE_WAIT_14_CLEAR          = 2;
  const int DTC_STATE_WAIT_FAULT_OBSERVE     = 3;
  const int DTC_STATE_WAIT_190209            = 5;
  const int DTC_STATE_WAIT_1906_BASE         = 6;
  const int DTC_STATE_WAIT_1906_AFTER_WAKE   = 8;

  // 唤醒目的说明：BUILD_DTC用于第一次制造DTC；READ_AGING用于后续每轮读取老化计数或最终确认。
  const int DTC_PURPOSE_BUILD_DTC  = 0;
  const int DTC_PURPOSE_READ_AGING = 1;

  // 诊断请求类型说明：dtcPendingReq记录当前正在等待哪个UDS服务的响应。
  // 收到0x7C3响应后，会按这个值分发到14、19 02 09或19 06的处理函数。
  const int DTC_REQ_NONE   = 0;
  const int DTC_REQ_14     = 2;
  const int DTC_REQ_190209 = 3;
  const int DTC_REQ_1906   = 4;

  // 运行状态变量：这些变量决定老化流程处于哪一轮、是否已制造DTC、是否进入最终清除确认。
  byte dtcTestRunning = 0;
  byte dtcWakePurpose = DTC_PURPOSE_BUILD_DTC;
  byte dtcDtcBuilt = 0;
  byte dtcFinalClearCheckPending = 0;
  byte dtcClearVerifyPending = 0;
  byte dtcAgingNormalStopRequested = 0;
  int dtcState = DTC_STATE_IDLE;
  int dtcPendingReq = DTC_REQ_NONE;
  byte dtcP2Extended = 0;
  byte dtcLastNrc = 0x00;

  // 老化目标配置：目标DTC、扩展记录号、当前老化计数字节位置，以及不匹配时是否只观察。
  // DTC_AGING_OBSERVE_ONLY=1只打印警告继续跑；=0打印错误并停止测试。
  dword dtcTargetDtc = 0xC12987;
  byte dtcExtRecordNum = 0x02;
  int dtcCurrentAgingPos = 1;
  const int DTC_AGING_OBSERVE_ONLY = 0;
  const int DTC_AGING_NEED_TIMES = 10;
  const int DTC_AGING_TOTAL_LOOP_TIMES = 11;

  // 老化计数记录：completed表示当前大循环内已读取19 06的轮次，loopFinish表示完整大循环次数。
  // baseline为第一次19 06读到的基线计数，current为当前响应中解析出的老化计数。
  int dtcCompletedAgingCycles = 0;
  int dtcLoopFinishCount = 0;
  byte dtcBaselineCurrentAging = 0xFF;
  byte dtcCurrentAgingValue = 0xFF;
  byte dtcTargetDtcFound = 0;
  byte dtcTargetDtcStatus = 0x00;
  byte dtcSleepVerifyActive = 0;
  byte dtcSleepIllegalMessageDetected = 0;
  dword dtcSleepIllegalMessageId = 0x000;
  // 时间参数：唤醒稳定后再发诊断；休眠等待后再唤醒；P2/P2*用于UDS响应超时判定。
  const int DTC_WAKE_STABLE_MS = 1000;
  const long DTC_SLEEP_WAIT_MS = 15000;
  const int DTC_SLEEP_VERIFY_WINDOW_MS = 2000;
  const int DTC_FAULT_INJECT_MS = 5000;
  const int DTC_FAULT_OBSERVE_MS = 8000;
  const int DTC_UDS_P2_MS = 1000;
  const int DTC_UDS_P2_STAR_MS = 5000;
  const int DTC_ISOTP_N_CR_MS = 1000;

  // ISO-TP接收缓存：用于把单帧或多帧0x7C3诊断响应组完整后再交给UDS解析。
  byte dtcIsoTpBuf[512];
  int dtcIsoTpLen = 0;
  int dtcIsoTpPos = 0;
  int dtcIsoTpTargetLen = 0;
  byte dtcIsoTpWaitingCf = 0;
  byte dtcIsoTpNextSn = 1;

  // 19 06扩展记录缓存：保存正响应中DTC状态后的扩展记录数据，用来读取当前老化计数字节。
  byte dtc1906Data[256];
  int dtc1906DataLen = 0;
  char dtcLogText[512];


  // 压力测试状态缓存供当前测试用例轮询写入HTML报告。
  const int DTC_FAULT_PRESSURE_STATUS_INFO = 0;
  const int DTC_FAULT_PRESSURE_STATUS_PASS = 1;
  const int DTC_FAULT_PRESSURE_STATUS_FAIL = 2;

  char gDtcFaultPressureStatusText[1024];
  long gDtcFaultPressureStatusResult = DTC_FAULT_PRESSURE_STATUS_INFO;
  long gDtcFaultPressureStatusSequence = 0;
  int dtcAgingStopKeepLastStatus = 0;
}

// ================== Electrical inspection 相关函数 ==================
// 压力测试不创建独立日志文件，也不向 Write 窗口输出逐周期过程日志。
void StressWriteLog(char logStr[])
{
}

// 功能：向Stresstest面板输出一行文字，缺少换行时自动补换行。
void StressPutPanelLine(char logStr[])
{
  char panelText[1024];
  int logLen;

  logLen = strlen(logStr);
  if ((logLen > 0) &&
      ((logStr[logLen - 1] == 0x0A) || (logStr[logLen - 1] == 0x0D)))
  {
    snprintf(panelText, elCount(panelText), "%s", logStr);
  }
  else
  {
    snprintf(panelText, elCount(panelText), "%s\n", logStr);
  }

  putValueToControl("Stresstest", "CAPL Output View 1", panelText);
}

// Pushes one pressure-test process result to the active test case for HTML reporting.
void DtcFaultControllerPublishPressureStatus(int statusResult, char statusText[])
{
  snprintf(gDtcFaultPressureStatusText,
           elCount(gDtcFaultPressureStatusText),
           "%s",
           statusText);
  gDtcFaultPressureStatusResult = statusResult;
  gDtcFaultPressureStatusSequence++;

}

// 功能：将字符串输出到 CANoe Panel 的指定控件
void ElecPutToPanel(char val[])
{
  StressPutPanelLine(val);
}

