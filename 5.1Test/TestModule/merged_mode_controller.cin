/*@!Encoding:936*/
includes
{
  #include "ITechPowerControl.cin"
}

variables
{
  // 当前激活的测试模式
  const int MODE_NONE            = 0;      // 无模式
  const int MODE_ELECTRICAL      = 1;      // 电检模式
  const int MODE_MSG_CYCLE       = 2;      // 消息周期监控模式
  const int MODE_SUSPEND_RESUME  = 3;      // 测试模式
  const int MODE_DTC_AGING       = 4;      // DTC老化测试模式

  int gActiveMode = MODE_NONE;             // 全局当前模式

  // 公共动作层变量：用于把休眠唤醒压测和DTC老化共用的电源/Arming/0x601动作集中管理。
  // pwrOwner表示当前是谁在使用公共动作层，pwrAction表示正在执行唤醒还是休眠。
  // ================== Common power cycle 公共休眠唤醒动作层 ==================
