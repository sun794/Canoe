// Restore all DTC-related inputs after every VXT testcase.
void SetDtcReportDisplayTitle(char displayTitle[])
{
  snprintf(gDtcReportDisplayTitle, elcount(gDtcReportDisplayTitle), "%s",
    displayTitle);
}

void DtcReportCaseTitle(char defaultTitle[], char defaultDescription[])
{
  if(gDtcReportDisplayTitle[0] != 0)
    testCaseTitle(defaultTitle, gDtcReportDisplayTitle);
  else
    testCaseTitle(defaultTitle, defaultDescription);
}
void RestoreDtcCaseAfterExecution()
{
  RestoreAllDtcMessageSources();
  gDtcCaseBaselineSource = 0;
  gDtcReadRecoverySource = 0;
  gDtcReportDisplayTitle[0] = 0;
}

// ===== 公共DTC判定与恢复时序 =====
// 故障窗口结束后读取一次19 02 09，等待300 ms完成首次状态判定；
// 随后恢复正常报文并确认连续3帧，等待5 ms后再次读取恢复状态。
int GetDtcRecoveryFrameCycleMs(int recoverySource)
{
  if((recoverySource == kDtcRecoverySourceFlzcu1) ||
     (recoverySource == kDtcRecoverySourceFrzcu1) ||
     (recoverySource == kDtcRecoverySourceRzcu2) ||
     (recoverySource == kDtcRecoverySourceOnebox3))
    return 20;

  if((recoverySource == kDtcRecoverySourceOnebox1) ||
     (recoverySource == kDtcRecoverySourceSas1) ||
     (recoverySource == kDtcRecoverySourceAcu2) ||
     (recoverySource == kDtcRecoverySourceAcu3))
    return 10;

  if(recoverySource == kDtcRecoverySourceVcuCom10)
    return 10;

  if((recoverySource == kDtcRecoverySourceRrcr2) ||
     (recoverySource == kDtcRecoverySourceFlzcu9))
    return 100;

  if(recoverySource == kDtcRecoverySourceIccCom8)
    return 500;

  return 0;
}

void GetDtcRecoveryMessageName(int recoverySource, char messageName[])
{
  if(recoverySource == kDtcRecoverySourceFlzcu1)
    snprintf(messageName, elcount(messageName), "FLZCU_1 (0x23B)");
  else if(recoverySource == kDtcRecoverySourceFrzcu1)
    snprintf(messageName, elcount(messageName), "FRZCU_1 (0x2AB)");
  else if(recoverySource == kDtcRecoverySourceRzcu2)
    snprintf(messageName, elcount(messageName), "RZCU_2 (0x2BB)");
  else if(recoverySource == kDtcRecoverySourceOnebox1)
    snprintf(messageName, elcount(messageName), "ONEBOX_1 (0x098)");
  else if(recoverySource == kDtcRecoverySourceOnebox3)
    snprintf(messageName, elcount(messageName), "ONEBOX_3 (0x22B)");
  else if(recoverySource == kDtcRecoverySourceSas1)
    snprintf(messageName, elcount(messageName), "SAS_1 (0x132)");
  else if(recoverySource == kDtcRecoverySourceAcu2)
    snprintf(messageName, elcount(messageName), "ACU_2 (0x031)");
  else if(recoverySource == kDtcRecoverySourceAcu3)
    snprintf(messageName, elcount(messageName), "ACU_3 (0x021)");
  else if(recoverySource == kDtcRecoverySourceRrcr2)
    snprintf(messageName, elcount(messageName), "RRCR_2 (0x4F7)");
  else if(recoverySource == kDtcRecoverySourceIccCom8)
    snprintf(messageName, elcount(messageName), "ICC_COM_8 (0x510)");
  else if(recoverySource == kDtcRecoverySourceVcuCom10)
    snprintf(messageName, elcount(messageName), "VCU_COM_10 (0x038)");
  else if(recoverySource == kDtcRecoverySourceFlzcu9)
    snprintf(messageName, elcount(messageName), "FLZCU_9 (0x49D)");
  else
    snprintf(messageName, elcount(messageName), "未知来源%d", recoverySource);
}

int GetDtcRecoverySourceForCommunicationLoss(int faultSource)
{
  if(faultSource == 0) return kDtcRecoverySourceOnebox1;
  if(faultSource == 1) return kDtcRecoverySourceSas1;
  if(faultSource == 2) return kDtcRecoverySourceAcu3;
  if(faultSource == 3) return kDtcRecoverySourceRrcr2;
  if(faultSource == 4) return kDtcRecoverySourceIccCom8;
  if(faultSource == 5) return kDtcRecoverySourceFlzcu1;
  if(faultSource == 6) return kDtcRecoverySourceVcuCom10;
  return 0;
}

int GetDtcRecoverySourceForLeftZone(int source)
{
  if(source == 1) return kDtcRecoverySourceFlzcu1;
  if(source == 2) return kDtcRecoverySourceFlzcu9;
  if(source == 3) return kDtcRecoverySourceFrzcu1;
  if(source == 4) return kDtcRecoverySourceRzcu2;
  return 0;
}

int GetDtcRecoverySourceForOnebox(int source)
{
  if((source == 1) || (source == 3)) return kDtcRecoverySourceOnebox1;
  if((source == 2) || (source == 4) || (source == 5))
    return kDtcRecoverySourceOnebox3;
  return 0;
}

int GetDtcRecoverySourceForAcu(int source)
{
  if(source == 1) return kDtcRecoverySourceAcu2;
  if(source == 2) return kDtcRecoverySourceAcu3;
  return 0;
}

// Map legacy ONEBOX testcase source values to the shared CRC boundary sources.
int GetOneboxCrcBoundarySource(int source)
{
  if(source == 1)
    return 4;
  if(source == 2)
    return 5;
  if(source == 3)
    return 10;
  if(source == 4)
    return 11;
  if(source == 5)
    return 12;

  return 0;
}
// Map legacy ONEBOX testcase source values to the shared COUNT boundary sources.
int GetOneboxCounterBoundarySource(int source)
{
  if(source == 1)
    return 4;
  if(source == 2)
    return 5;

  return 0;
}
int GetDtcRecoverySourceForCrc(int source)
{
  if(source == 1) return kDtcRecoverySourceFlzcu1;
  if(source == 2) return kDtcRecoverySourceFrzcu1;
  if(source == 3) return kDtcRecoverySourceRzcu2;
  if((source == 4) || (source == 10)) return kDtcRecoverySourceOnebox1;
  if((source == 5) || (source == 11) || (source == 12)) return kDtcRecoverySourceOnebox3;
  if(source == 6) return kDtcRecoverySourceSas1;
  if(source == 7) return kDtcRecoverySourceAcu2;
  if(source == 8) return kDtcRecoverySourceAcu3;
  if(source == 9) return kDtcRecoverySourceRrcr2;
  if(source == 13) return kDtcRecoverySourceVcuCom10;
  return 0;
}

int WaitForDtcRecoveryFrames(int recoverySource, int targetFrameCount,
                             char stepName[])
{
  char messageName[64];
  int cycleMs;
  int timeoutMs;

  cycleMs = GetDtcRecoveryFrameCycleMs(recoverySource);
  GetDtcRecoveryMessageName(recoverySource, messageName);
  if((cycleMs <= 0) || (targetFrameCount <= 0))
  {
    testStepFail(stepName, "恢复报文来源=%d或目标帧数=%d无效。",
                 recoverySource, targetFrameCount);
    return 0;
  }

  // 首次59 02响应的300 ms判定等待期间，恢复帧监控可能已完成。
  // 保留已累计的帧数，不重新置零，保证确认第3帧后立即进入下一步。
  if((gDtcRecoveryFrameSource == recoverySource) &&
     (gDtcRecoveryFrameTargetCount == targetFrameCount) &&
     (gDtcRecoveryFrameCount >= targetFrameCount))
  {
    gDtcRecoveryFrameMonitorActive = 0;
  }
  else if((!gDtcRecoveryFrameMonitorActive) ||
          (gDtcRecoveryFrameSource != recoverySource) ||
          (gDtcRecoveryFrameTargetCount != targetFrameCount))
  {
    gDtcRecoveryFrameSource = recoverySource;
    gDtcRecoveryFrameCount = 0;
    gDtcRecoveryFrameTargetCount = targetFrameCount;
    gDtcRecoveryFrameMonitorActive = 1;
  }

  timeoutMs = (cycleMs * (targetFrameCount + 2)) + 100;
  if(gDtcRecoveryFrameCount < targetFrameCount)
    testWaitForTextEvent(gDtcRecoveryFrameCompleteEvent, timeoutMs);
  gDtcRecoveryFrameMonitorActive = 0;
  gDtcPostFaultRecoveryMonitorStarted = 0;

  if(gDtcRecoveryFrameCount < targetFrameCount)
  {
    testStepFail(stepName, "%s在%d ms内仅收到%d/%d帧正常报文。",
                 messageName, timeoutMs, gDtcRecoveryFrameCount, targetFrameCount);
    return 0;
  }

  testStepPass(stepName, "%s已收到%d帧正常报文。",
               messageName, gDtcRecoveryFrameCount);
  return 1;
}

int ConfirmDtcCaseBaseline()
{
  if(gDtcCaseBaselineSource <= 0)
  {
    testStepFail("DTC基准报文", "未配置关联报文来源。");
    return 0;
  }

  return WaitForDtcRecoveryFrames(gDtcCaseBaselineSource,
                                  kDtcCaseBaselineFrameTargetCount,
                                  "DTC基准报文");
}

int BeginDtcCase(int recoverySource)
{
  RestoreAllDtcMessageSources();
  gDtcCaseBaselineSource = recoverySource;
  gDtcReadRecoverySource = recoverySource;
  if(!ConfirmDtcCaseBaseline())
    return 0;

  return ClearAllDtcs();
}

// Compatibility helper for legacy T1V testcases that configure recovery directly.
void ConfigureDtcReadRecovery(int recoverySource)
{
  gDtcReadRecoverySource = recoverySource;
}
void StartDtcPostFaultRecoveryAfterFinalDtcResponse()
{
  int recoverySource;

  if(!gDtcStartRecoveryOnFinalResponse)
    return;

  recoverySource = gDtcReadRecoverySource;
  if(recoverySource <= 0)
  {
    testStepFail("DTC恢复", "未配置恢复报文来源。");
    return;
  }

  // 首次故障态DTC读取完成后立即恢复正常报文。
  RestoreAllDtcMessageSources();
  gDtcReadRecoverySource = recoverySource;
  gDtcRecoveryFrameSource = recoverySource;
  gDtcRecoveryFrameCount = 0;
  gDtcRecoveryFrameTargetCount = kDtcRecoveryFrameTargetCount;
  gDtcRecoveryFrameMonitorActive = 1;
  gDtcPostFaultRecoveryMonitorStarted = 1;
}

// 发送19 02 09并接收最终59 02响应；判定等待由调用方按时序选择。
int ReadCurrentDtc190209Response(byte responseBytes[], int responseBufferLength,
                                 char stepName[])
{
  byte requestBytes[3];
  int responseLength;
  int waitResult;
  int pendingCount;
  long sendResult;
  diagRequest* request;
  diagResponse request response;

  diagSetTarget("T1V_G_RLCR");
  requestBytes[0] = 0x19;
  requestBytes[1] = 0x02;
  requestBytes[2] = 0x09;
  DiagResize(request, elcount(requestBytes));
  DiagSetPrimitiveData(request, requestBytes, elcount(requestBytes));
  sendResult = diagSendRequest(request);
  if(sendResult < 0)
  {
    testStepFail(stepName, "19 02 09发送失败，结果=%ld。", sendResult);
    return 0;
  }

  testWaitForDiagRequestSent(request, 100);
  for(pendingCount = 0; pendingCount < 5; pendingCount++)
  {
    waitResult = testWaitForDiagResponse(request, 1000);
    if(waitResult != 1)
      continue;

    diagGetLastResponse(request, response);
    responseLength = diagGetPrimitiveData(response, responseBytes,
                                          responseBufferLength);
    if((responseLength >= 3) && (responseBytes[0] == 0x7F) &&
       (responseBytes[1] == 0x19) && (responseBytes[2] == 0x78))
      continue;

    if((responseLength >= 3) && (responseBytes[0] == 0x59) &&
       (responseBytes[1] == 0x02))
    {
      testStep(stepName,
               "已解析19 02 09最终59 02肯定响应：59 02 %02X。",
               responseBytes[2]);
      if(!gDtcSkipReadResponseJudgeDelay)
        testWaitForTimeout(kDtcResultJudgeDelayMs);
      return responseLength;
    }

    if((responseLength >= 3) && (responseBytes[0] == 0x7F) &&
       (responseBytes[1] == 0x19))
    {
      testStepFail(stepName, "19 02 09被拒绝，NRC=0x%02X。",
                   responseBytes[2]);
      return 0;
    }
  }

  testStepFail(stepName, "19 02 09在5000 ms内未返回最终59 02。");
  return 0;
}

int IsDtcStatusAllowed(int actualStatus, int expectedStatus,
                       int allowPendingStatus)
{
  if(expectedStatus < 0)
    return 1;
  if(actualStatus == expectedStatus)
    return 1;
  return allowPendingStatus && (expectedStatus == kDtcFaultStatus) &&
         (actualStatus == kDtcFaultPendingStatus);
}

// 在已接收的59 02响应中查找目标DTC，并同时校验状态字节和关联通讯丢失DTC。
int CheckDtcInCurrentResponse(dword expectedDtc, int expectDtc,
                              int expectedStatus, int allowPendingStatus,
                              dword absentDtc)
{
  byte responseBytes[512];
  int responseLength;
  int index;
  dword actualDtc;

  responseLength = ReadCurrentDtc190209Response(
    responseBytes, elcount(responseBytes), "读取当前DTC");
  if(responseLength <= 0)
    return 0;

  for(index = 3; (index + 3) < responseLength; index += 4)
  {
    actualDtc = ((dword)responseBytes[index] << 16) |
                ((dword)responseBytes[index + 1] << 8) |
                responseBytes[index + 2];

    if((absentDtc != 0) && (actualDtc == absentDtc))
    {
      testStepFail("读取当前DTC",
                   "检测到非预期通讯丢失DTC 0x%06X，状态=0x%02X。",
                   absentDtc, responseBytes[index + 3]);
      return 0;
    }

    if(actualDtc != expectedDtc)
      continue;

    if(!expectDtc)
    {
      testStepFail("读取当前DTC", "检测到非预期DTC 0x%06X，状态=0x%02X。",
                   expectedDtc, responseBytes[index + 3]);
      return 0;
    }

    if(!IsDtcStatusAllowed(responseBytes[index + 3], expectedStatus,
                           allowPendingStatus))
    {
      if(allowPendingStatus && (expectedStatus == kDtcFaultStatus))
        testStepFail("读取当前DTC",
                     "DTC 0x%06X状态=0x%02X，期望0x01或0x09。",
                     expectedDtc, responseBytes[index + 3]);
      else
        testStepFail("读取当前DTC",
                     "DTC 0x%06X状态=0x%02X，期望0x%02X。",
                     expectedDtc, responseBytes[index + 3], expectedStatus);
      return 0;
    }

    testStepPass("读取当前DTC", "DTC 0x%06X状态=0x%02X。",
                 expectedDtc, responseBytes[index + 3]);
    return 1;
  }

  if(expectDtc)
  {
    testStepFail("读取当前DTC", "期望DTC 0x%06X未找到。",
                 expectedDtc);
    return 0;
  }

  testStepPass("读取当前DTC", "DTC 0x%06X未找到。", expectedDtc);
  return 1;
}

dword GetCommunicationLossDtcForRecoverySource(int recoverySource)
{
  if((recoverySource == kDtcRecoverySourceOnebox1) ||
     (recoverySource == kDtcRecoverySourceOnebox3))
    return kDtcOneboxMessageLoss;
  if(recoverySource == kDtcRecoverySourceSas1)
    return kDtcSasMessageLoss;
  if((recoverySource == kDtcRecoverySourceAcu2) ||
     (recoverySource == kDtcRecoverySourceAcu3))
    return kDtcAcuMessageLoss;
  if(recoverySource == kDtcRecoverySourceRrcr2)
    return kDtcRrcrMessageLoss;
  if(recoverySource == kDtcRecoverySourceIccCom8)
    return 0xC24587;
  if((recoverySource == kDtcRecoverySourceFlzcu1) ||
     (recoverySource == kDtcRecoverySourceFlzcu9) ||
     (recoverySource == kDtcRecoverySourceFrzcu1) ||
     (recoverySource == kDtcRecoverySourceRzcu2))
    return kDtcLeftZoneMessageLoss;
  if(recoverySource == kDtcRecoverySourceVcuCom10)
    return kDtcVcuCommunicationLoss;
  return 0;
}
int CheckRecoveredDtcWithStatus09Retry(dword expectedDtc, dword communicationLossDtc)
{
  byte responseBytes[512];
  int responseLength;
  int index;
  int actualStatus;
  int recoverySource;
  dword actualDtc;

  // 恢复状态读取不再固定等待判定时间，避免快周期报文多恢复。
  gDtcSkipReadResponseJudgeDelay = 1;
  responseLength = ReadCurrentDtc190209Response(
    responseBytes, elcount(responseBytes), "恢复状态读取");
  gDtcSkipReadResponseJudgeDelay = 0;
  if(responseLength <= 0)
    return 0;

  actualStatus = -1;
  for(index = 3; (index + 3) < responseLength; index += 4)
  {
    actualDtc = ((dword)responseBytes[index] << 16) |
                ((dword)responseBytes[index + 1] << 8) |
                responseBytes[index + 2];
    if((communicationLossDtc != 0) && (actualDtc == communicationLossDtc))
    {
      testStepFail("恢复状态读取", "检测到非预期通讯丢失DTC 0x%06X。",
                   communicationLossDtc);
      return 0;
    }
    if(actualDtc == expectedDtc)
    {
      actualStatus = responseBytes[index + 3];
      break;
    }
  }

  if(actualStatus < 0)
  {
    testStepFail("恢复状态读取", "未找到目标DTC 0x%06X。", expectedDtc);
    return 0;
  }
  if(actualStatus == kDtcRecoveredStatus)
  {
    testWaitForTimeout(1);
    testStepPass("恢复状态读取", "DTC 0x%06X恢复状态=0x08。", expectedDtc);
    return 1;
  }
  if(actualStatus != kDtcFaultStatus)
  {
    testStepFail("恢复状态读取", "DTC 0x%06X恢复状态=0x%02X，期望0x08。",
                 expectedDtc, actualStatus);
    return 0;
  }

  recoverySource = gDtcReadRecoverySource;
  testStepWarning("故障恢复",
                  "第3帧恢复报文后的首次19 02 09仍为0x09；将额外等待%d帧并复读，仅记录诊断响应，当前实现仍判定失败。",
                  kDtcPostFaultRecoveryRetryFrameTargetCount);
  if(!WaitForDtcRecoveryFrames(recoverySource,
                               kDtcPostFaultRecoveryRetryFrameTargetCount,
                               "DTC恢复补充帧（仅记录）"))
    return 0;

  gDtcSkipReadResponseJudgeDelay = 1;
  responseLength = ReadCurrentDtc190209Response(
    responseBytes, elcount(responseBytes), "恢复状态复读（仅记录）");
  gDtcSkipReadResponseJudgeDelay = 0;
  if(responseLength <= 0)
    return 0;

  testWaitForTimeout(1);
  testStepFail("故障恢复",
               "第3帧恢复报文后的首次19 02 09仍为0x09；补充帧后的复读不参与状态判定，按当前逻辑判定失败。");
  return 0;
}
// 公共时序：故障态读取不额外等待；收到最终响应后恢复报文，连续确认3帧正常后等待5 ms复读。
// 此流程只负责读取与结果判定，不调整周期发送配置。
int CheckDtcAndRecoveryFlow(dword expectedDtc, dword communicationLossDtc)
{
  int result;
  int faultResult;

  gDtcSkipReadResponseJudgeDelay = 1;
  faultResult = CheckDtcInCurrentResponse(expectedDtc, 1, kDtcFaultStatus, 1,
    communicationLossDtc);
  gDtcSkipReadResponseJudgeDelay = 0;
  gDtcStartRecoveryOnFinalResponse = 1;
  StartDtcPostFaultRecoveryAfterFinalDtcResponse();
  gDtcStartRecoveryOnFinalResponse = 0;
  gDtcSkipReadResponseJudgeDelay = 0;
  if(!WaitForDtcRecoveryFrames(gDtcReadRecoverySource,
                               kDtcRecoveryFrameTargetCount,
                               "DTC恢复"))
    return 0;

  testWaitForTimeout(5);
  result = CheckRecoveredDtcWithStatus09Retry(expectedDtc, communicationLossDtc);
  return faultResult && result;
}

// 按恢复报文来源自动匹配需要排除的通讯丢失DTC。
int CheckCurrentDtc(dword expectedDtc)
{
  dword communicationLossDtc;

  communicationLossDtc =
    GetCommunicationLossDtcForRecoverySource(gDtcReadRecoverySource);
  return CheckDtcAndRecoveryFlow(expectedDtc, communicationLossDtc);
}

// 显式指定需要排除的通讯丢失DTC，并记录故障帧完成后立即读取。
int CheckCurrentDtcAndNoCommunicationLoss(dword expectedDtc,
  dword communicationLossDtc, char messageName[])
{
  PrepareDtcReadAfterFaultFrames(messageName);
  return CheckDtcAndRecoveryFlow(expectedDtc, communicationLossDtc);
}
int CheckCurrentDtcAbsent(dword expectedDtc)
{
  return CheckDtcInCurrentResponse(expectedDtc, 0, -1, 0, 0);
}

int CheckCommunicationLossDtc(dword expectedDtc)
{
  return CheckDtcInCurrentResponse(expectedDtc, 1, -1, 0, 0);
}

// 仅在BeginDtcCase已确认关联报文连续5帧正常后清除DTC，避免基准不稳定影响结果。
int ClearAllDtcs()
{

  byte requestBytes[4];
  byte responseBytes[16];
  int responseLength;
  int waitResult;
  int pendingCount;
  int clearAttempt;
  long sendResult;
  diagRequest* request;
  diagResponse request response;

  InitReportAndLog("DtcFault_report");
  diagSetTarget("T1V_G_RLCR");
  requestBytes[0] = 0x14;
  requestBytes[1] = 0xFF;
  requestBytes[2] = 0xFF;
  requestBytes[3] = 0xFF;

  for(clearAttempt = 1; clearAttempt <= kDtcClearRetryCount; clearAttempt++)
  {
    DiagResize(request, elcount(requestBytes));
    DiagSetPrimitiveData(request, requestBytes, elcount(requestBytes));
    sendResult = diagSendRequest(request);
    if(sendResult < 0)
      waitResult = -1;
    else
    {
      testWaitForDiagRequestSent(request, 100);
      for(pendingCount = 0; pendingCount < 6; pendingCount++)
      {
        waitResult = testWaitForDiagResponse(request, 5000);
        if(waitResult != 1)
          break;

        diagGetLastResponse(request, response);
        responseLength = diagGetPrimitiveData(response, responseBytes,
                                              elcount(responseBytes));
        if(responseLength <= 0)
        {
          waitResult = -2;
          break;
        }

        if((responseLength == 3) && (responseBytes[0] == 0x7F) &&
           (responseBytes[1] == 0x14) && (responseBytes[2] == 0x78))
          continue;

        if((responseLength == 1) && (responseBytes[0] == 0x54))
        {
          testStepPass("清除DTC", "14 FF FF FF响应=54。");
          testStep("清除DTC", "14服务收到54后等待%d ms再进行故障注入。",
                   kDtcClearCompleteWaitMs);
          testWaitForTimeout(kDtcClearCompleteWaitMs);
          return 1;
        }

        testStepFail("清除DTC", "非预期14服务响应，长度=%d，首字节=0x%02X。",
                     responseLength, responseBytes[0]);
        return 0;
      }

      if(pendingCount >= 6)
      {
        testStepFail("清除DTC", "14 FF FF FF持续等待30秒未完成。");
        return 0;
      }
    }

    if(clearAttempt < kDtcClearRetryCount)
    {
      testStepWarning("清除DTC", "14服务通讯未就绪，%d ms后重试（%d/%d）。",
                      kDtcClearRetryDelayMs, clearAttempt + 1,
                      kDtcClearRetryCount);
      testWaitForTimeout(kDtcClearRetryDelayMs);
    }
  }

  testStepFail("清除DTC", "14 FF FF FF重试%d次后仍失败。",
               kDtcClearRetryCount);
  return 0;
}

// ===== 普通通讯丢失：关闭仿真源保持指定时长，再由公共恢复流程恢复 =====
int SetCommunicationLossFault(int faultSource, int enabled, int durationMs)
{
  if(faultSource == 0)
  {
    @sysvar::Vehicle_input::Message_MissingTime::ONEBOX_1_0x98 = durationMs;
    @sysvar::Vehicle_input::MSG::ONEBOX_1_0x98 = enabled;
  }
  else if(faultSource == 1)
  {
    @sysvar::Vehicle_input::Message_MissingTime::SAS_1_0x132 = durationMs;
    @sysvar::Vehicle_input::MSG::SAS_1_0x132 = enabled;
  }
  else if(faultSource == 2)
  {
    @sysvar::Vehicle_input::Message_MissingTime::ACU_3_0x021 = durationMs;
    @sysvar::Vehicle_input::MSG::ACU_3_0x021 = enabled;
  }
  else if(faultSource == 3)
  {
    @sysvar::Vehicle_input::Message_MissingTime::RRCR_2_0x4F7 = durationMs;
    @sysvar::Vehicle_input::MSG::RRCR_2_0x4F7 = enabled;
  }
  else if(faultSource == 4)
  {
    @sysvar::Vehicle_input::Message_MissingTime::ICC_COM_8_0x510 = durationMs;
    @sysvar::Vehicle_input::MSG::ICC_COM_8_0x510 = enabled;
  }
  else if(faultSource == 5)
  {
    @sysvar::Vehicle_input::Message_MissingTime::FLZCU_1_0x23B = durationMs;
    @sysvar::Vehicle_input::MSG::FLZCU_1_0x23B = enabled;
  }
  else if(faultSource == 6)
  {
    @sysvar::Vehicle_input::Message_MissingTime::VCU_COM_10_0x38 = durationMs;
    @sysvar::Vehicle_input::MSG::VCU_COM_10_0x38 = enabled;
  }
  else
  {
    return 0;
  }

  return 1;
}

void GetCommunicationLossMessageName(int faultSource, char messageName[])
{
  if(faultSource == 0)
    snprintf(messageName, elcount(messageName), "ONEBOX_1（0x098，来源0）");
  else if(faultSource == 1)
    snprintf(messageName, elcount(messageName), "SAS_1（0x132，来源1）");
  else if(faultSource == 2)
    snprintf(messageName, elcount(messageName), "ACU_3（0x021，来源2）");
  else if(faultSource == 3)
    snprintf(messageName, elcount(messageName), "RRCR_2（0x4F7，来源3）");
  else if(faultSource == 4)
    snprintf(messageName, elcount(messageName), "ICC_COM_8（0x510，来源4）");
  else if(faultSource == 5)
    snprintf(messageName, elcount(messageName), "FLZCU_1（0x23B，来源5）");
  else if(faultSource == 6)
    snprintf(messageName, elcount(messageName), "VCU_COM_10（0x038，来源6）");
  else
    snprintf(messageName, elcount(messageName), "未知来源%d", faultSource);
}

dword GetCommunicationLossDtc(int faultSource)
{
  if(faultSource == 0)
    return 0xC12987;
  if(faultSource == 1)
    return 0xC13187;
  if(faultSource == 2)
    return 0xC15187;
  if(faultSource == 3)
    return 0xD16987;
  if(faultSource == 4)
    return 0xC24587;
  if(faultSource == 5)
    return 0xC14187;

  if(faultSource == 6)
    return kDtcVcuCommunicationLoss;
  return 0;
}

int GetCommunicationLossCycleTimeMs(int faultSource)
{
  if((faultSource == 0) || (faultSource == 1) || (faultSource == 2))
    return 10;
  if(faultSource == 6)
    return 10;
  if(faultSource == 5)
    return 20;
  if(faultSource == 3)
    return 100;
  if(faultSource == 4)
    return 500;

  return 0;
}

// 通讯丢失注入前先确认连续5帧正常报文，实测周期写入报告；
// 这样丢失起点和恢复帧均能基于真实总线周期判断。
int WaitForCommunicationLossStabilization(int faultSource, char messageName[])
{
  int expectedCycleMs;
  int timeoutMs;

  expectedCycleMs = GetCommunicationLossCycleTimeMs(faultSource);
  if(expectedCycleMs <= 0)
  {
    testStepFail("正常报文稳定",
                 "%s未配置报文周期。", messageName);
    return 0;
  }

  if(!SetCommunicationLossFault(faultSource, 0, 0))
  {
    testStepFail("正常报文稳定",
                 "无法恢复%s报文发送。", messageName);
    return 0;
  }

  gCommunicationLossStabilizationActive = 1;
  gCommunicationLossStabilizationSource = faultSource;
  gCommunicationLossStabilizationFrameCount = 0;
  gCommunicationLossStabilizationReady = 0;
  gCommunicationLossPreviousTimestampMs = 0.0;
  gCommunicationLossObservedCycleMs = 0.0;
  timeoutMs = expectedCycleMs * (kCommunicationLossStabilizationFrameCount + 2);

  testStep("正常报文稳定",
           "%s配置周期=%d ms；清除DTC后等待连续%d帧正常报文。",
           messageName, expectedCycleMs, kCommunicationLossStabilizationFrameCount);
  if(!gCommunicationLossStabilizationReady)
    testWaitForTextEvent(gDtcFaultCommLossStabilizedEvent, timeoutMs);

  gCommunicationLossStabilizationActive = 0;
  if(!gCommunicationLossStabilizationReady)
  {
    testStepFail("正常报文稳定",
                 "%s在%d ms内仅收到%d/%d帧正常报文，未开始丢失注入。",
                 messageName,
                 timeoutMs,
                 gCommunicationLossStabilizationFrameCount,
                 kCommunicationLossStabilizationFrameCount);
    return 0;
  }

  testStepPass("正常报文稳定",
               "%s连续%d帧正常发送确认，实测周期=%.3f ms；开始制造通讯丢失。",
               messageName,
               kCommunicationLossStabilizationFrameCount,
               gCommunicationLossObservedCycleMs);
  return 1;
}

// 为兼容现有T1V用例的日志分组保留该适配函数。
void SelectDtcLoggingGroup(int groupId)
{
  if(groupId == 0)
    snprintf(gDtcLoggingGroupName, elcount(gDtcLoggingGroupName), "00_DTC会话");
  else if(groupId == 1)
    snprintf(gDtcLoggingGroupName, elcount(gDtcLoggingGroupName), "01_C12987_集成制动控制器通讯丢失");
  else if(groupId == 2)
    snprintf(gDtcLoggingGroupName, elcount(gDtcLoggingGroupName), "02_C13187_电动助力转向控制器通讯丢失");
  else if(groupId == 3)
    snprintf(gDtcLoggingGroupName, elcount(gDtcLoggingGroupName), "03_C15187_气囊控制器通讯丢失");
  else if(groupId == 4)
    snprintf(gDtcLoggingGroupName, elcount(gDtcLoggingGroupName), "04_D16987_后右角雷达通讯丢失");
  else if(groupId == 5)
    snprintf(gDtcLoggingGroupName, elcount(gDtcLoggingGroupName), "05_C24587_信息计算中心通讯丢失");
  else if(groupId == 6)
    snprintf(gDtcLoggingGroupName, elcount(gDtcLoggingGroupName), "06_C14187_左区域控制器通讯丢失");
  else if(groupId == 7)
    snprintf(gDtcLoggingGroupName, elcount(gDtcLoggingGroupName), "07_C14087_VCU控制器失去通讯");
  else if(groupId == 8)
    snprintf(gDtcLoggingGroupName, elcount(gDtcLoggingGroupName), "08_C44381_VCU控制器网络信号无效");
  else if(groupId == 9)
    snprintf(gDtcLoggingGroupName, elcount(gDtcLoggingGroupName), "09_C41881_集成制动控制器车速信号无效");
  else if(groupId == 10)
    snprintf(gDtcLoggingGroupName, elcount(gDtcLoggingGroupName), "10_C42081_电动助力转向控制器网络信号无效");
  else if(groupId == 11)
    snprintf(gDtcLoggingGroupName, elcount(gDtcLoggingGroupName), "11_C45281_气囊纵向加速度信号无效");
  else if(groupId == 12)
    snprintf(gDtcLoggingGroupName, elcount(gDtcLoggingGroupName), "12_C44481_左区域控制器网络信号无效");
  else if(groupId == 13)
    snprintf(gDtcLoggingGroupName, elcount(gDtcLoggingGroupName), "13_D43681_后右角雷达网络信号无效");
  else if(groupId == 15)
    snprintf(gDtcLoggingGroupName, elcount(gDtcLoggingGroupName), "15_压力测试");
  else
    gDtcLoggingGroupName[0] = 0;
}

void SelectDtcLoggingGroupForCommunicationLoss(int faultSource)
{
  if(faultSource == 0)
    SelectDtcLoggingGroup(1);
  else if(faultSource == 1)
    SelectDtcLoggingGroup(2);
  else if(faultSource == 2)
    SelectDtcLoggingGroup(3);
  else if(faultSource == 3)
    SelectDtcLoggingGroup(4);
  else if(faultSource == 4)
    SelectDtcLoggingGroup(5);
  else if(faultSource == 5)
    SelectDtcLoggingGroup(6);
  else if(faultSource == 6)
    SelectDtcLoggingGroup(7);
  else
    SelectDtcLoggingGroup(-1);
}

void SelectDtcLoggingGroupForCrc(int crcSource)
{
  if((crcSource >= 1) && (crcSource <= 3))
    SelectDtcLoggingGroup(12);
  else if((crcSource == 4) || (crcSource == 5) ||
          ((crcSource >= 10) && (crcSource <= 12)))
    SelectDtcLoggingGroup(9);
  else if(crcSource == 6)
    SelectDtcLoggingGroup(10);
  else if((crcSource == 7) || (crcSource == 8))
    SelectDtcLoggingGroup(11);
  else if(crcSource == 9)
    SelectDtcLoggingGroup(13);
  else if(crcSource == 13)
    SelectDtcLoggingGroup(8);
  else
    SelectDtcLoggingGroup(-1);
}

void SelectDtcLoggingGroupForCounter(int counterSource)
{
  if(counterSource == 14)
    SelectDtcLoggingGroup(8);
  else
    SelectDtcLoggingGroupForCrc(counterSource);
}
// 普通通讯丢失用例按设定时间停发；精确阈值验证请使用下方Boundary实现。


// 通讯丢失阈值通用流程：清DTC -> 确认正常周期 -> 从最后正常帧开始停发 ->
// 到目标总线时间发送一帧正确恢复报文 -> 观察500 ms -> 读取19 02 09判定DTC。
void Impl_Dtc_CommunicationLossBoundary_Run(int faultSource, int durationMs,
                                           int expectDtc)
{
  dword expectedDtc;
  float actualLossMs;
  char messageName[64];
  char caseDescription[160];
  char expectedState[48];

  GetCommunicationLossMessageName(faultSource, messageName);
  expectedDtc = GetCommunicationLossDtc(faultSource);
  if((expectedDtc == 0) || (durationMs <= 0) ||
     ((expectDtc != 0) && (expectDtc != 1)))
  {
    testStepFail("通讯丢失阈值配置",
                 "不支持的来源=%d、持续时间=%d ms或DTC期望=%d。",
                 faultSource, durationMs, expectDtc);
    return;
  }

  if(expectDtc)
    snprintf(expectedState, elcount(expectedState), "应存在");
  else
    snprintf(expectedState, elcount(expectedState), "不应存在");

  snprintf(caseDescription, elcount(caseDescription),
           "%s通讯丢失%d ms：DTC 0x%06X，%s。",
           messageName, durationMs, expectedDtc, expectedState);
  DtcReportCaseTitle("DTC通讯丢失阈值", caseDescription);
  if(!BeginDtcCase(GetDtcRecoverySourceForCommunicationLoss(faultSource)))
    return;

  // 0x4F7使用专用原始报文恢复逻辑，单独校验其最后正常帧和恢复帧时间差。
  if(faultSource == 3)
  {
    ResetRrcr2BoundaryTiming();
    gLastRRCR2Valid = 0;
    if(!WaitForCommunicationLossStabilization(faultSource, messageName))
      return;
    if(!gLastRRCR2Valid)
    {
      testStepFail("总线时间注入",
                   "未收到正常0x4F7报文，无法以总线时间为基准制造通讯丢失。");
      return;
    }

    gRrcr2BoundaryRequestedDurationMs = durationMs;
    gRrcr2BoundaryArm = 1;
    testStep("故障注入",
             "等待下一帧正常0x4F7后立即停发；恢复帧目标时间=最后正常帧+%d ms。",
             durationMs);

    if(!gRrcr2BoundaryInjectionActive)
      testWaitForTextEvent(gDtcFaultRrcr2InjectionStartedEvent, 500);
    if(!gRrcr2BoundaryInjectionActive)
    {
      ResetRrcr2BoundaryTiming();
      testStepFail("总线时间注入",
                   "等待0x4F7最后正常帧超时，未启动总线时间定时器。");
      return;
    }

    if(!gRrcr2BoundaryRecoveryFrameSent)
      testWaitForTextEvent(gDtcFaultRrcr2RecoverySentEvent, durationMs + 100);
    if(!gRrcr2BoundaryRecoveryFrameSent)
    {
      ResetRrcr2BoundaryTiming();
      testStepFail("总线时间注入",
                   "0x4F7恢复帧未在目标总线时间发送。");
      return;
    }

    if(gRrcr2BoundaryUnexpectedFrameCount > 0)
    {
      testStepFail("丢失窗口帧监控",
                   "0x4F7丢失窗口内检测到%d帧报文；首帧时间戳=%.3f ms。",
                   gRrcr2BoundaryUnexpectedFrameCount,
                   gRrcr2BoundaryFirstUnexpectedFrameTimestampMs);
      return;
    }
    testStepPass("丢失窗口帧监控",
                 "0x4F7从最后正常帧到恢复帧之间未检测到报文。");

    actualLossMs = gRrcr2BoundaryRecoveryTimestampMs -
                   gRrcr2BoundaryLastFrameTimestampMs;
    if((actualLossMs < (durationMs - kRrcr2BoundaryTimingToleranceMs)) ||
       (actualLossMs > (durationMs + kRrcr2BoundaryTimingToleranceMs)))
    {
      testStepFail("总线时间校验",
                   "最后正常帧=%.3f ms，恢复帧=%.3f ms，实测丢失=%.3f ms；目标=%d +/- %.1f ms。",
                   gRrcr2BoundaryLastFrameTimestampMs,
                   gRrcr2BoundaryRecoveryTimestampMs,
                   actualLossMs,
                   durationMs,
                   kRrcr2BoundaryTimingToleranceMs);
      return;
    }
    testStepPass("总线时间校验",
                 "最后正常帧=%.3f ms，恢复帧=%.3f ms，实测丢失=%.3f ms；目标=%d +/- %.1f ms。",
                 gRrcr2BoundaryLastFrameTimestampMs,
                 gRrcr2BoundaryRecoveryTimestampMs,
                 actualLossMs,
                 durationMs,
                 kRrcr2BoundaryTimingToleranceMs);

    // 恢复帧发出后仍等待500 ms，让ECU完成故障去抖和DTC状态更新后再读取。
    testWaitForTimeout(kDtcFaultObserveTimeMs);
    if(expectDtc)
      CheckCommunicationLossDtc(expectedDtc);
    else
      CheckCurrentDtcAbsent(expectedDtc);

    testStep("故障恢复",
             "0x4F7已在目标总线时间恢复，IL周期发送已重新启用。");
    return;
  }

  // 其余报文共用通讯丢失状态机：等待下一帧正常报文到达后才真正开始停发。
  ResetCommunicationLossBoundaryTiming();
  ResetCommunicationLossBoundarySourceFrame(faultSource);
  if(!WaitForCommunicationLossStabilization(faultSource, messageName))
    return;
  if(!HasCommunicationLossBoundarySourceFrame(faultSource))
  {
    testStepFail("总线时间注入",
                 "%s未收到可用于恢复的正常报文。", messageName);
    return;
  }

  gCommunicationLossBoundarySource = faultSource;
  gCommunicationLossBoundaryRequestedDurationMs = durationMs;
  gCommunicationLossBoundaryArm = 1;
  testStep("故障注入",
           "%s：等待下一帧正常报文后立即停发；恢复帧目标时间=最后正常帧+%d ms。",
           messageName, durationMs);
  if(!gCommunicationLossBoundaryInjectionActive)
    testWaitForTextEvent(gDtcFaultCommLossInjectionStartedEvent,
                          GetCommunicationLossCycleTimeMs(faultSource) * 2 + 100);
  if(!gCommunicationLossBoundaryInjectionActive)
  {
    ResetCommunicationLossBoundaryTiming();
    testStepFail("总线时间注入",
                 "%s最后正常帧等待超时，未启动总线时间定时器。", messageName);
    return;
  }

  if(!gCommunicationLossBoundaryRecoveryFrameSent)
    testWaitForTextEvent(gDtcFaultCommLossRecoverySentEvent,
                          durationMs + GetCommunicationLossCycleTimeMs(faultSource) * 2 + 100);
  if(!gCommunicationLossBoundaryRecoveryFrameSent)
  {
    testStepFail("总线时间注入",
                 "%s恢复帧未能在停发后的%d ms内发送；停发后仍观察到%d帧，最后帧时间戳=%.3f ms。",
                 messageName,
                 durationMs + GetCommunicationLossCycleTimeMs(faultSource) * 2 + 100,
                 gCommunicationLossBoundaryUnexpectedFrameCount,
                 gCommunicationLossBoundaryLastFrameTimestampMs);
    ResetCommunicationLossBoundaryTiming();
    return;
  }

  if(gCommunicationLossBoundaryUnexpectedFrameCount > 0)
  {
    testStepPass("丢失窗口帧监控",
                 "%s停发后观察到%d帧，首帧=%.3f ms，最后帧=%.3f ms；最后帧后静默%d ms后恢复。",
                 messageName,
                 gCommunicationLossBoundaryUnexpectedFrameCount,
                 gCommunicationLossBoundaryFirstUnexpectedFrameTimestampMs,
                 gCommunicationLossBoundaryLastFrameTimestampMs,
                 durationMs);
  }
  else
  {
    testStepPass("丢失窗口帧监控",
                 "%s从最后正常帧到恢复帧之间未检测到报文。", messageName);
  }

  actualLossMs = gCommunicationLossBoundaryRecoveryTimestampMs -
                 gCommunicationLossBoundaryLastFrameTimestampMs;
  if((actualLossMs < (durationMs - kRrcr2BoundaryTimingToleranceMs)) ||
     (actualLossMs > (durationMs + kRrcr2BoundaryTimingToleranceMs)))
  {
    testStepFail("总线时间校验",
                 "%s最后正常帧=%.3f ms，恢复帧=%.3f ms，实测丢失=%.3f ms；目标=%d +/- %.1f ms。",
                 messageName,
                 gCommunicationLossBoundaryLastFrameTimestampMs,
                 gCommunicationLossBoundaryRecoveryTimestampMs,
                 actualLossMs,
                 durationMs,
                 kRrcr2BoundaryTimingToleranceMs);
    return;
  }
  testStepPass("总线时间校验",
               "%s最后正常帧=%.3f ms，恢复帧=%.3f ms，实测丢失=%.3f ms；目标=%d +/- %.1f ms。",
               messageName,
               gCommunicationLossBoundaryLastFrameTimestampMs,
               gCommunicationLossBoundaryRecoveryTimestampMs,
               actualLossMs,
               durationMs,
               kRrcr2BoundaryTimingToleranceMs);

  // 恢复帧发出后仍等待500 ms，让ECU完成故障去抖和DTC状态更新后再读取。
  testWaitForTimeout(kDtcFaultObserveTimeMs);
  if(expectDtc)
    CheckCommunicationLossDtc(expectedDtc);
  else
    CheckCurrentDtcAbsent(expectedDtc);

  testStep("故障恢复",
           "%s已在目标总线时间恢复，IL周期发送已重新启用。", messageName);
}

void Impl_Dtc_SignalInvalid_VehicleSpeed()
