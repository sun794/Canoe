// ===== 左区报文：信号无效、CRC、COUNT、DLC和通讯丢失的控制接口 =====
void GetLeftZoneMessageName(int source, char messageName[])
{
  if(source == 1)
    snprintf(messageName, elcount(messageName), "FLZCU_1 (0x23B)");
  else if(source == 2)
    snprintf(messageName, elcount(messageName), "FLZCU_9 (0x49D)");
  else if(source == 3)
    snprintf(messageName, elcount(messageName), "FRZCU_1 (0x2AB)");
  else if(source == 4)
    snprintf(messageName, elcount(messageName), "RZCU_2 (0x2BB)");
  else
    snprintf(messageName, elcount(messageName), "未知来源%d", source);
}

int GetLeftZoneFaultCycleMs(int source)
{
  if(source == 2)
    return 100;

  if((source >= 1) && (source <= 4))
    return 20;

  return 0;
}

int SetLeftZoneSignalFault(int source, int faultValue)
{
  if(source == 2)
    $CAN1::CGW::FLZCU_9::FLZCU_9_ArmingSts = faultValue;
  else
    return 0;

  return 1;
}

int SetLeftZoneCrcFault(int source, int enabled)
{
  if(source == 1)
    @sysvar::Vehicle_input::Message_CRC::FLZCU_1_0x23B = enabled;
  else if(source == 3)
    @sysvar::Vehicle_input::Message_CRC::FRZCU_1_0x2AB = enabled;
  else if(source == 4)
    @sysvar::Vehicle_input::Message_CRC::RZCU_2_0x2BB = enabled;
  else
    return 0;

  return 1;
}

int SetLeftZoneAliveCounterFault(int source, int enabled)
{
  if(source == 1)
    @sysvar::Vehicle_input::Message_Counter::FLZCU_1_0x23B = enabled;
  else if(source == 3)
    @sysvar::Vehicle_input::Message_Counter::FRZCU_1_0x2AB = enabled;
  else if(source == 4)
    @sysvar::Vehicle_input::Message_Counter::RZCU_2_0x2BB = enabled;
  else
    return 0;

  return 1;
}

void Impl_Dtc_AutomaticSession_Start()
{
  int pwrRet;

  pwrRet = PwrInitializeItechPower();
  DtcFaultControllerInitialize();
  DtcReportCaseTitle("DTC_SESSION_START", "初始化DTC报告和会话日志。");
  InitReportAndLog("DtcFault_report");
  testModuleTitle("DTC故障测试报告");
  StartToLogging();
  if(PwrVoltageFluctuationEnabled() && pwrRet != 0)
  {
    testStepFail("程控电源初始化", "程控电源初始化失败，错误码=%d，压测不可开始。", pwrRet);
  }
  else
  {
    testStepPass("自动初始化",
                 "报告路径：Code\\5.1Test\\ReportAndLog\\<时间戳>\\DtcFault_report.xml/.html；日志路径：LogFiles\\<testcase>.blf。");
  }
}

void Impl_Dtc_AutomaticSession_Stop()
{
  DtcFaultControllerShutdown();
  DtcReportCaseTitle("DTC_SESSION_STOP", "停止DTC会话日志。");
  StopToLogging();
  testStepPass("自动日志", "DTC会话日志已停止。");
}

void Impl_Dtc_LeftZoneSignalInvalid_Run(int source, int faultMode)
{
  char messageName[64];
  if((source != 2) || (faultMode != 1))
  {
    testStepFail("DTC配置", "不支持的左区域来源=%d或故障模式=%d。",
                 source, faultMode);
    return;
  }

  GetLeftZoneMessageName(source, messageName);
  DtcReportCaseTitle("DTC C44481", "FLZCU_9信号无效");
  if(!BeginDtcSignalInvalidCase(kDtcRecoverySourceFlzcu9,
                                 kDtcSignalCriterionFlzcu9ArmingStatus))
    return;

  if(!SetLeftZoneSignalFault(source, 3))
  {
    testStepFail("DTC配置", "左区域来源=%d信号无效注入失败。", source);
    return;
  }

  CompleteDtcSignalInvalidCase(kDtcExpectedCodeLeftZoneSignalInvalid, 100,
                                messageName);
}
void Impl_Dtc_LeftZoneDlc_Run(int source)
{
  int cycleMs;
  int messageId;
  char messageName[64];
  char caseDescription[128];

  cycleMs = GetLeftZoneFaultCycleMs(source);
  if(cycleMs == 0)
  {
    testStepFail("DTC配置", "不支持的来源=%d。", source);
    return;
  }

  if(source == 1)
    messageId = 0x23B;
  else if(source == 2)
    messageId = 0x49D;
  else if(source == 3)
    messageId = 0x2AB;
  else
    messageId = 0x2BB;

  GetLeftZoneMessageName(source, messageName);
  snprintf(caseDescription, elcount(caseDescription),
           "左区域控制器DLC故障：%s", messageName);
  DtcReportCaseTitle("DTC C44481", caseDescription);
  if(!BeginDtcCase(GetDtcRecoverySourceForLeftZone(source)))
    return;

  if(!StartDlcFaultFrameSequence(messageId) ||
     !WaitForDlcFaultFrameSequence(cycleMs, messageName))
    return;

  CheckCurrentDtcAndNoCommunicationLoss(
    kDtcExpectedCodeLeftZoneSignalInvalid, kDtcLeftZoneMessageLoss, messageName);

  testStep("故障恢复", "%s正常DLC=8报文发送已恢复。", messageName);
}





// ===== ONEBOX报文：信号无效、CRC、COUNT、DLC和通讯丢失的控制接口 =====
void GetOneboxMessageName(int source, char messageName[])
{
  if((source == 1) || (source == 3))
    snprintf(messageName, elCount(messageName), "ONEBOX_1 (0x098)");
  else if((source == 2) || (source == 4) || (source == 5))
    snprintf(messageName, elCount(messageName), "ONEBOX_3 (0x22B)");
  else
    snprintf(messageName, elCount(messageName), "未知来源%d", source);
}

int GetOneboxCycleMs(int source)
{
  if((source == 1) || (source == 3))
    return 10;
  if((source == 2) || (source == 4) || (source == 5))
    return 20;

  return 0;
}
int SetOneboxSignalFault(int source, int faultMode)
{
  if(faultMode != 1)
    return 0;

  if(source == 1)
    $CAN1::CGW::ONEBOX_1::ESP1_VehicleSpeedVSOSigValidData = 1;
  else if(source == 2)
    $CAN1::CGW::ONEBOX_3::VehicleStandstill = 2;
  else
  {
    return 0;
  }

  return 1;
}

int ClearOneboxSignalFault(int source)
{
  if(source == 1)
  {
    $CAN1::CGW::ONEBOX_1::ESP1_VehicleSpeedVSOSigValidData = 0;
  }
  else if(source == 2)
  {
    $CAN1::CGW::ONEBOX_3::VehicleStandstill = 0;
  }
  else
  {
    return 0;
  }

  return 1;
}

int SetOneboxCrcFault(int source, int enabled)
{
  if(source == 1)
    @sysvar::Vehicle_input::Message_CRC::ONEBOX_1_0x98_CRC1 = enabled;
  else if(source == 2)
    @sysvar::Vehicle_input::Message_CRC::ONEBOX_3_0x22B_CRC1 = enabled;
  else if(source == 3)
    @sysvar::Vehicle_input::Message_CRC::ONEBOX_1_0x98_CRC2 = enabled;
  else if(source == 4)
    @sysvar::Vehicle_input::Message_CRC::ONEBOX_3_0x22B_CRC2 = enabled;
  else if(source == 5)
    @sysvar::Vehicle_input::Message_CRC::ONEBOX_3_0x22B_CRC4 = enabled;
  else
    return 0;

  return 1;
}
int SetOneboxAliveCounterFault(int source, int enabled)
{
  if(source == 1)
    @sysvar::Vehicle_input::Message_Counter::ONEBOX_1_0x98_RC1 = enabled;
  else if(source == 2)
    @sysvar::Vehicle_input::Message_Counter::ONEBOX_3_0x22B_RC1 = enabled;
  else
    return 0;

  return 1;
}
void Impl_Dtc_OneboxSignalFault_Run(int source, int faultMode)
{
  char messageName[64];
  int recoverySource;
  int criterion;
  int cycleMs;

  recoverySource = GetDtcRecoverySourceForOnebox(source);
  cycleMs = GetOneboxCycleMs(source);
  if((recoverySource == 0) || (cycleMs == 0) || (faultMode != 1))
  {
    testStepFail("DTC配置", "不支持的ONEBOX来源=%d或故障模式=%d。",
                 source, faultMode);
    return;
  }

  if(source == 1)
    criterion = kDtcSignalCriterionOnebox1SpeedValid;
  else if(source == 2)
    criterion = kDtcSignalCriterionOnebox3Standstill;
  else
  {
    testStepFail("DTC配置", "ONEBOX来源=%d不支持信号无效注入。", source);
    return;
  }

  GetOneboxMessageName(source, messageName);
  DtcReportCaseTitle("DTC C41881", "ONEBOX信号无效");
  if(!BeginDtcSignalInvalidCase(recoverySource, criterion))
    return;

  if(!SetOneboxSignalFault(source, faultMode))
  {
    testStepFail("DTC配置", "ONEBOX来源=%d信号无效注入失败。", source);
    return;
  }

  CompleteDtcSignalInvalidCase(kDtcVehicleSpeedSignalInvalid, cycleMs,
                                messageName);
}
void Impl_Dtc_OneboxDlc_Run(int source)
{
  int cycleMs;
  int messageId;
  char messageName[64];
  char caseDescription[128];

  cycleMs = GetOneboxCycleMs(source);
  if(cycleMs == 0)
  {
    testStepFail("DTC配置", "不支持的来源=%d。", source);
    return;
  }

  if(source == 1)
    messageId = 0x098;
  else
    messageId = 0x22B;

  GetOneboxMessageName(source, messageName);
  snprintf(caseDescription, elcount(caseDescription),
           "ONEBOX DLC故障：%s", messageName);
  DtcReportCaseTitle("DTC C41881", caseDescription);
  if(!BeginDtcCase(GetDtcRecoverySourceForOnebox(source)))
    return;

  if(!StartDlcFaultFrameSequence(messageId) ||
     !WaitForDlcFaultFrameSequence(cycleMs, messageName))
    return;

  CheckCurrentDtcAndNoCommunicationLoss(
    kDtcVehicleSpeedSignalInvalid, kDtcOneboxMessageLoss, messageName);

  testStep("故障恢复", "%s正常报文发送已恢复。", messageName);
}





void Impl_Dtc_SasDlc()
{
  char messageName[64];

  DtcReportCaseTitle("DTC C42081", "电动助力转向控制器DLC故障");
  if(!BeginDtcCase(kDtcRecoverySourceSas1))
    return;

  snprintf(messageName, elcount(messageName), "SAS_1 (0x132)");
  if(!StartDlcFaultFrameSequence(0x132) ||
     !WaitForDlcFaultFrameSequence(10, messageName))
    return;

  CheckCurrentDtcAndNoCommunicationLoss(0xC42081, kDtcSasMessageLoss, messageName);

  testStep("故障恢复", "恢复SAS_1正常报文发送。");
}





// ===== ACU报文：信号无效、CRC、COUNT、DLC和通讯丢失的控制接口 =====
void GetAcuMessageName(int source, char messageName[])
{
  if(source == 1)
    snprintf(messageName, elcount(messageName), "ACU_2 (0x031)");
  else if(source == 2)
    snprintf(messageName, elcount(messageName), "ACU_3 (0x021)");
  else
    snprintf(messageName, elcount(messageName), "未知来源%d", source);
}

int SetAcuSignalFault(int source, int faultMode)
{
  if(source == 1)
    $CAN1::CGW::ACU_2::ACU_2_YawrateSigValidData = 2;
  else if(source == 2)
    $CAN1::CGW::ACU_3::ACU_3_LongitudinalAccelerationVD = 2;
  else
  {
    return 0;
  }

  return 1;
}

int ClearAcuSignalFault(int source)
{
  if(source == 1)
  {
    $CAN1::CGW::ACU_2::ACU_2_YawrateSigValidData = 0;
  }
  else if(source == 2)
  {
    $CAN1::CGW::ACU_3::ACU_3_LongitudinalAccelerationVD = 0;
  }
  else
  {
    return 0;
  }

  return 1;
}

int SetAcuCrcFault(int source, int enabled)
{
  if(source == 1)
    @sysvar::Vehicle_input::Message_CRC::ACU_2_0x31 = enabled;
  else if(source == 2)
    @sysvar::Vehicle_input::Message_CRC::ACU_3_0x021 = enabled;
  else
    return 0;

  return 1;
}

int SetAcuAliveCounterFault(int source, int enabled)
{
  if(source == 1)
    @sysvar::Vehicle_input::Message_Counter::ACU_2_0x31 = enabled;
  else if(source == 2)
    @sysvar::Vehicle_input::Message_Counter::ACU_3_0x021 = enabled;
  else
    return 0;

  return 1;
}

int SetCrcBoundaryFault(int crcSource, int enabled)
{
  if(crcSource == 1)
    return SetLeftZoneCrcFault(1, enabled);
  if(crcSource == 2)
    return SetLeftZoneCrcFault(3, enabled);
  if(crcSource == 3)
    return SetLeftZoneCrcFault(4, enabled);
  if(crcSource == 4)
    return SetOneboxCrcFault(1, enabled);
  if(crcSource == 5)
    return SetOneboxCrcFault(2, enabled);
  if(crcSource == 6)
  {
    @sysvar::Vehicle_input::Message_CRC::SAS_1_0x132 = enabled;
    return 1;
  }
  if(crcSource == 7)
    return SetAcuCrcFault(1, enabled);
  if(crcSource == 8)
    return SetAcuCrcFault(2, enabled);
  if(crcSource == 9)
  {
    @sysvar::Vehicle_input::Message_CRC::RRCR_2_0x4F7 = enabled;
    return 1;
  }
  if(crcSource == 10)
    return SetOneboxCrcFault(3, enabled);
  if(crcSource == 11)
    return SetOneboxCrcFault(4, enabled);
  if(crcSource == 12)
    return SetOneboxCrcFault(5, enabled);
  if(crcSource == 13)
  {
    @sysvar::Vehicle_input::Message_CRC::VCU_COM_10_0x38 = enabled;
    return 1;
  }

  return 0;
}
int SetCounterBoundaryFault(int counterSource, int enabled)
{
  if(counterSource == 1)
    return SetLeftZoneAliveCounterFault(1, enabled);
  if(counterSource == 2)
    return SetLeftZoneAliveCounterFault(3, enabled);
  if(counterSource == 3)
    return SetLeftZoneAliveCounterFault(4, enabled);
  if(counterSource == 4)
    return SetOneboxAliveCounterFault(1, enabled);
  if(counterSource == 5)
    return SetOneboxAliveCounterFault(2, enabled);
  if(counterSource == 6)
  {
    @sysvar::Vehicle_input::Message_Counter::SAS_1_0x132 = enabled;
    return 1;
  }
  if(counterSource == 7)
    return SetAcuAliveCounterFault(1, enabled);
  if(counterSource == 8)
    return SetAcuAliveCounterFault(2, enabled);
  if(counterSource == 9)
  {
    @sysvar::Vehicle_input::Message_Counter::RRCR_2_0x4F7 = enabled;
    return 1;
  }
  if(counterSource == 14)
  {
    @sysvar::Vehicle_input::Message_Counter::VCU_COM_10_0x38 = enabled;
    return 1;
  }

  return 0;
}

void GetCrcBoundaryMessageName(int crcSource, char messageName[])
{
  if(crcSource == 1)
    snprintf(messageName, elCount(messageName), "FLZCU_1 (0x23B)");
  else if(crcSource == 2)
    snprintf(messageName, elCount(messageName), "FRZCU_1 (0x2AB)");
  else if(crcSource == 3)
    snprintf(messageName, elCount(messageName), "RZCU_2 (0x2BB)");
  else if(crcSource == 4)
    snprintf(messageName, elCount(messageName), "ONEBOX_1 (0x098) CRC1");
  else if(crcSource == 5)
    snprintf(messageName, elCount(messageName), "ONEBOX_3 (0x22B) CRC1");
  else if(crcSource == 6)
    snprintf(messageName, elCount(messageName), "SAS_1 (0x132)");
  else if(crcSource == 7)
    snprintf(messageName, elCount(messageName), "ACU_2 (0x031)");
  else if(crcSource == 8)
    snprintf(messageName, elCount(messageName), "ACU_3 (0x021)");
  else if(crcSource == 9)
    snprintf(messageName, elCount(messageName), "RRCR_2 (0x4F7)");
  else if(crcSource == 10)
    snprintf(messageName, elCount(messageName), "ONEBOX_1 (0x098) CRC2");
  else if(crcSource == 11)
    snprintf(messageName, elCount(messageName), "ONEBOX_3 (0x22B) CRC2");
  else if(crcSource == 12)
    snprintf(messageName, elCount(messageName), "ONEBOX_3 (0x22B) CRC4");
  else if(crcSource == 13)
    snprintf(messageName, elCount(messageName), "VCU_COM_10 (0x038)");
  else
    snprintf(messageName, elCount(messageName), "未知CRC来源%d", crcSource);
}
dword GetCrcBoundaryDtc(int crcSource)
{
  if((crcSource >= 1) && (crcSource <= 3))
    return kDtcExpectedCodeLeftZoneSignalInvalid;
  if((crcSource >= 4) && (crcSource <= 5))
    return kDtcVehicleSpeedSignalInvalid;
  if((crcSource >= 10) && (crcSource <= 12))
    return kDtcVehicleSpeedSignalInvalid;
  if(crcSource == 6)
    return 0xC42081;
  if((crcSource >= 7) && (crcSource <= 8))
    return 0xC45281;
  if(crcSource == 9)
    return 0xD43681;

  if(crcSource == 13)
    return kDtcVcuNetworkSignalInvalid;

  return 0;
}
int GetCrcBoundaryCycleMs(int crcSource)
{
  if((crcSource >= 1) && (crcSource <= 3))
    return 20;
  if((crcSource == 4) || (crcSource == 10))
    return 10;
  if((crcSource == 5) || (crcSource == 11) || (crcSource == 12))
    return 20;
  if((crcSource >= 6) && (crcSource <= 8))
    return 10;
  if(crcSource == 9)
    return 100;

  if(crcSource == 13)
    return 10;

  return 0;
}
void GetCounterBoundaryMessageName(int counterSource, char messageName[])
{
  if(counterSource == 1)
    snprintf(messageName, elCount(messageName), "FLZCU_1 (0x23B)");
  else if(counterSource == 2)
    snprintf(messageName, elCount(messageName), "FRZCU_1 (0x2AB)");
  else if(counterSource == 3)
    snprintf(messageName, elCount(messageName), "RZCU_2 (0x2BB)");
  else if(counterSource == 4)
    snprintf(messageName, elCount(messageName), "ONEBOX_1 (0x098) RC1");
  else if(counterSource == 5)
    snprintf(messageName, elCount(messageName), "ONEBOX_3 (0x22B) RC1");
  else if(counterSource == 6)
    snprintf(messageName, elCount(messageName), "SAS_1 (0x132)");
  else if(counterSource == 7)
    snprintf(messageName, elCount(messageName), "ACU_2 (0x031)");
  else if(counterSource == 8)
    snprintf(messageName, elCount(messageName), "ACU_3 (0x021)");
  else if(counterSource == 9)
    snprintf(messageName, elCount(messageName), "RRCR_2 (0x4F7)");
  else if(counterSource == 14)
    snprintf(messageName, elCount(messageName), "VCU_COM_10 (0x038)");
  else
    snprintf(messageName, elCount(messageName), "未知COUNT来源%d", counterSource);
}

dword GetCounterBoundaryDtc(int counterSource)
{
  if(counterSource == 14)
    return kDtcVcuNetworkSignalInvalid;
  return GetCrcBoundaryDtc(counterSource);
}

int GetCounterBoundaryCycleMs(int counterSource)
{
  if(counterSource == 14)
    return 10;
  return GetCrcBoundaryCycleMs(counterSource);
}

// ===== CRC阈值通用流程：清DTC -> 精确注入指定数量的连续CRC错误帧 -> 判定 -> 恢复 =====
void Impl_Dtc_CrcCycleBoundary_Run(int crcSource, int errorCycles, int expectDtc)
{
  dword expectedDtc;
  int cycleMs;
  int injectionTimeoutMs;
  char messageName[64];
  char caseDescription[160];

  GetCrcBoundaryMessageName(crcSource, messageName);
  expectedDtc = GetCrcBoundaryDtc(crcSource);
  cycleMs = GetCrcBoundaryCycleMs(crcSource);
  if((expectedDtc == 0) || (cycleMs == 0) ||
     ((errorCycles != 9) && (errorCycles != 10)) ||
     ((expectDtc != 0) && (expectDtc != 1)))
  {
    testStepFail("CRC阈值配置",
                 "不支持的来源=%d、错误周期数=%d或DTC期望=%d。",
                 crcSource, errorCycles, expectDtc);
    return;
  }

  if(!expectDtc)
  {
    testStepWarning("CRC边界用例屏蔽",
                    "CRC负向阈值用例已屏蔽，仅执行10帧用例。");
    return;
  }
  snprintf(caseDescription, elcount(caseDescription),
           "%s CRC错误%d周期：DTC 0x%06X。",
           messageName, errorCycles, expectedDtc);
  DtcReportCaseTitle("DTC CRC周期阈值", caseDescription);
  if(!BeginDtcCase(GetDtcRecoverySourceForCrc(crcSource)))
    return;

  @sysvar::Vehicle_input::Message_CRC::CRC_unchange = 0;
  if(!SetCrcBoundaryFault(crcSource, 0))
  {
    testStepFail("CRC阈值配置",
                 "故障注入前无法恢复%s的CRC计算。",
                 messageName);
    return;
  }

  testWaitForTimeout(100);
  // 按实际接收的CRC错误帧数计数，而非按固定时间估算，确保故障窗口准确。
  gCrcBoundarySource = crcSource;
  gCrcBoundaryTargetCycles = errorCycles;
  gCrcBoundaryObservedCycles = 0;
  gCrcBoundaryComplete = 0;
  gCrcBoundaryFirstFrameTimestampMs = 0;
  gCrcBoundaryUnexpectedValidFrameCount = 0;
  snprintf(gCrcBoundaryMessageName, elcount(gCrcBoundaryMessageName), "%s",
           messageName);
  gCrcBoundaryInjectionStarted = 0;
  gCrcBoundaryActive = 1;

  @sysvar::Vehicle_input::Message_CRC::CRC_unchange = errorCycles;
  if(!SetCrcBoundaryFault(crcSource, 1))
  {
    gCrcBoundaryActive = 0;
    @sysvar::Vehicle_input::Message_CRC::CRC_unchange = 0;
    testStepFail("CRC阈值配置",
                 "无法启用%s的CRC故障。", messageName);
    return;
  }

  testStep("故障注入",
           "%s：CRC错误注入已启用，目标=%d帧。",
           messageName, errorCycles);

  injectionTimeoutMs = (errorCycles * cycleMs) + (cycleMs * 2) + 100;
  // 按实际接收帧计数；等待期间不暂停IL报文，也不改变DBC周期。
  if(!gCrcBoundaryComplete)
    testWaitForTextEvent(gDtcFaultCrcBoundaryCompleteEvent, injectionTimeoutMs);

  if(!gCrcBoundaryComplete)
  {
    gCrcBoundaryActive = 0;
    SetCrcBoundaryFault(crcSource, 0);
    @sysvar::Vehicle_input::Message_CRC::CRC_unchange = 0;
    testStepFail("故障注入",
                 "%s：%d ms内仅确认%d/%d个CRC错误帧。",
                 messageName, injectionTimeoutMs, gCrcBoundaryObservedCycles,
                 errorCycles);
    return;
  }

  // 保持CRC故障直到首次DTC读取完成；IL仍按原DBC周期继续发送报文。
  if(gCrcBoundaryUnexpectedValidFrameCount > 0)
  {
    SetCrcBoundaryFault(crcSource, 0);
    @sysvar::Vehicle_input::Message_CRC::CRC_unchange = 0;
    testStepFail("CRC帧校验",
                 "%s注入期间检测到%d帧CRC正确报文；不能确认连续%d帧CRC错误。",
                 messageName, gCrcBoundaryUnexpectedValidFrameCount, errorCycles);
    return;
  }
  testStep("故障注入",
           "%s：已确认%d个接收报文的CRC/校验和错误。",
           messageName, gCrcBoundaryObservedCycles);
  PrepareDtcReadAfterFaultFrames(messageName);


  if(expectDtc)
  {
    if(!CheckCurrentDtc(expectedDtc))
      return;
  }
  else if(!CheckCurrentDtcAbsent(expectedDtc))
    return;

  SetCrcBoundaryFault(crcSource, 0);
  @sysvar::Vehicle_input::Message_CRC::CRC_unchange = 0;
  testStep("故障恢复", "%s CRC/校验和计算已恢复。",
           messageName);
}

// ===== COUNT阈值通用流程：清DTC -> 精确注入指定数量的连续冻结帧 -> 判定 -> 恢复 =====
void Impl_Dtc_CounterCycleBoundary_Run(int counterSource, int errorCycles,
                                       int expectDtc)
{
  dword expectedDtc;
  int cycleMs;
  int injectionTimeoutMs;
  char messageName[64];
  char caseDescription[160];

  GetCounterBoundaryMessageName(counterSource, messageName);
  expectedDtc = GetCounterBoundaryDtc(counterSource);
  cycleMs = GetCounterBoundaryCycleMs(counterSource);
  if((expectedDtc == 0) || (cycleMs == 0) ||
     ((errorCycles != 9) && (errorCycles != 10)) ||
     ((expectDtc != 0) && (expectDtc != 1)))
  {
    testStepFail("COUNT阈值配置",
                 "不支持的来源=%d、错误周期数=%d或DTC期望=%d。",
                 counterSource, errorCycles, expectDtc);
    return;
  }

  if(!expectDtc)
  {
    testStepWarning("COUNT边界用例屏蔽",
                    "COUNT负向阈值用例已屏蔽，仅执行10帧用例。");
    return;
  }
  snprintf(caseDescription, elcount(caseDescription),
           "%s COUNT冻结%d周期：DTC 0x%06X。",
           messageName, errorCycles, expectedDtc);
  DtcReportCaseTitle("DTC COUNT周期阈值", caseDescription);
  if(!BeginDtcCase(GetDtcRecoverySourceForCounter(counterSource)))
    return;

  if(!SetCounterBoundaryFault(counterSource, 0))
  {
    testStepFail("COUNT阈值配置",
                 "故障注入前无法恢复%s的COUNT。", messageName);
    return;
  }

  gCounterBoundarySource = counterSource;
  gCounterBoundaryBaselineActive = 1;
  gCounterBoundaryCounterValueValid = 0;
  gCounterBoundaryFirstCounter = 0;
  testWaitForTimeout(100);
  gCounterBoundaryBaselineActive = 0;
  gCounterBoundaryTargetCycles = errorCycles;
  gCounterBoundaryObservedCycles = 0;
  gCounterBoundaryComplete = 0;
  gCounterBoundaryFirstFrameTimestampMs = 0.0;
  gCounterBoundaryCurrentCounter = 0;
  gCounterBoundaryUnexpectedChangedFrameCount = 0;
  snprintf(gCounterBoundaryMessageName, elcount(gCounterBoundaryMessageName),
           "%s", messageName);
  gCounterBoundaryActive = 1;
  @sysvar::Vehicle_input::Message_Counter::Counter_unchange = errorCycles;

  if(!SetCounterBoundaryFault(counterSource, 1))
  {
    gCounterBoundaryActive = 0;
    gCounterBoundaryBaselineActive = 0;
    @sysvar::Vehicle_input::Message_Counter::Counter_unchange = 0;
    testStepFail("COUNT阈值配置",
                 "无法启用%s的COUNT故障。", messageName);
    return;
  }

  injectionTimeoutMs = (errorCycles * cycleMs) + (cycleMs * 2) + 100;
  if(!gCounterBoundaryComplete)
    testWaitForTextEvent(gDtcFaultCounterBoundaryCompleteEvent, injectionTimeoutMs);

  if(!gCounterBoundaryComplete)
  {
    gCounterBoundaryActive = 0;
    SetCounterBoundaryFault(counterSource, 0);
    @sysvar::Vehicle_input::Message_Counter::Counter_unchange = 0;
    testStepFail("故障注入",
                 "%s：%d ms内仅确认%d/%d个连续冻结COUNT帧，递增或跳变帧=%d。",
                 messageName, injectionTimeoutMs, gCounterBoundaryObservedCycles,
                 errorCycles, gCounterBoundaryUnexpectedChangedFrameCount);
    return;
  }

  if(gCounterBoundaryUnexpectedChangedFrameCount > 0)
  {
    SetCounterBoundaryFault(counterSource, 0);
    @sysvar::Vehicle_input::Message_Counter::Counter_unchange = 0;
    testStepFail("COUNT帧校验",
                 "%s注入期间检测到%d帧递增或跳变COUNT；不能确认连续%d帧冻结。",
                 messageName, gCounterBoundaryUnexpectedChangedFrameCount,
                 errorCycles);
    return;
  }

  testStep("故障注入",
           "%s：已确认连续%d个接收报文的COUNT冻结。",
           messageName, gCounterBoundaryObservedCycles);
  PrepareDtcReadAfterFaultFrames(messageName);


  if(expectDtc)
  {
    if(!CheckCurrentDtc(expectedDtc))
      return;
  }
  else if(!CheckCurrentDtcAbsent(expectedDtc))
    return;

  SetCounterBoundaryFault(counterSource, 0);
  @sysvar::Vehicle_input::Message_Counter::Counter_unchange = 0;
  testStep("故障恢复", "%s COUNT已恢复。", messageName);
}


// ACU signal-invalid test entry used by DTC_015.
void Impl_Dtc_AcuSignalFault_Run(int source, int faultMode)
{
  char messageName[64];
  int recoverySource;
  int criterion;

  if((source < 1) || (source > 2) || (faultMode != 1))
  {
    testStepFail("DTC配置", "不支持的ACU来源=%d或故障模式=%d。", source, faultMode);
    return;
  }

  recoverySource = GetDtcRecoverySourceForAcu(source);
  if(source == 1)
    criterion = kDtcSignalCriterionAcu2YawValid;
  else
    criterion = kDtcSignalCriterionAcu3LongitudinalValid;

  GetAcuMessageName(source, messageName);
  DtcReportCaseTitle("DTC C45281", "ACU信号无效");
  if(!BeginDtcSignalInvalidCase(recoverySource, criterion))
    return;

  if(!SetAcuSignalFault(source, faultMode))
  {
    testStepFail("DTC配置", "ACU来源=%d信号无效注入失败。", source);
    return;
  }

  CompleteDtcSignalInvalidCase(0xC45281, 10, messageName);
}
void Impl_Dtc_AcuDlc_Run(int source)
{
  char messageName[64];
  int cycleMs;
  int messageId;
  if((source < 1) || (source > 2))
  {
    testStepFail("DTC配置", "不支持的ACU来源=%d。", source);
    return;
  }

  GetAcuMessageName(source, messageName);
  DtcReportCaseTitle("DTC C45281", "ACU DLC故障");
  if(!BeginDtcCase(GetDtcRecoverySourceForAcu(source)))
    return;

  cycleMs = 10;
  messageId = (source == 1) ? 0x031 : 0x021;
  if(!StartDlcFaultFrameSequence(messageId) ||
     !WaitForDlcFaultFrameSequence(cycleMs, messageName))
    return;

  CheckCurrentDtcAndNoCommunicationLoss(0xC45281, kDtcAcuMessageLoss, messageName);
  testStep("故障恢复", "%s正常报文发送已恢复。", messageName);
}

// RRCR DLC test entry used by DTC_022.
void Impl_Dtc_RrcrDlc()
{
  char messageName[64];

  DtcReportCaseTitle("DTC D43681", "RRCR_2 DLC故障");
  if(!BeginDtcCase(kDtcRecoverySourceRrcr2))
    return;
  snprintf(messageName, elcount(messageName), "RRCR_2 (0x4F7)");
  if(!StartDlcFaultFrameSequence(0x4F7) ||
     !WaitForDlcFaultFrameSequence(100, messageName))
    return;

  CheckCurrentDtcAndNoCommunicationLoss(0xD43681, kDtcRrcrMessageLoss, messageName);
  testStep("故障恢复", "RRCR_2正常报文发送已恢复。");
}

// 压力测试公共入口：四个现有压力用例只传入类型、标题和说明。
void Impl_Dtc_PressureTest_Run(int pressureType, char caseTitleText[], char description[])
{
  float voltageLast;
  float voltageMin;
  float voltageMax;
  long voltageSampleCount;

  DtcReportCaseTitle(caseTitleText, description);
  gPressureTestStopRequested = 0;
  if(!DtcFaultControllerStartPressureTest(pressureType))
  {
    testStepFail("压力测试", "压力测试启动失败，通常是程控电源未初始化。请检查端口和启用开关。");
    return;
  }
  testStep("压力测试", "压力测试已启动；按x停止。");

  // Only one pressure test runs at a time. Keep the selected test active until x.
  while(DtcFaultControllerIsPressureTestActive(pressureType) &&
        !gPressureTestStopRequested)
  {
    testWaitForTimeout(100);
  }

  if(PwrVoltageFluctuationEnabled())
  {
    ITECH_GetVoltageStatistics(voltageLast, voltageMin, voltageMax, voltageSampleCount);
    testStep("程控电源电压",
             "最后=%.2fV，最小=%.2fV，最大=%.2fV，记录=%ld次，配置范围=%.2f~%.2fV。",
             voltageLast, voltageMin, voltageMax, voltageSampleCount,
             PWR_VOLTAGE_LOW, PWR_VOLTAGE_HIGH);
  }

  DtcFaultControllerShutdown();
}
// ===== VXT适配入口：函数名必须与DtcFault.vxt中的case保持一致 =====
/* Each testcase calls one implementation and restores all DTC inputs afterward. */


void SetE2eCrcForVcuCom10Recovery()
{
  int i;
  byte crcData[9];

  crcData[0] = 0x68;
  crcData[1] = 0x00;
  for(i = 1; i < 8; i++)
    crcData[i + 1] = gCommunicationLossRecoveryVcuCom10.byte(i);
  gCommunicationLossRecoveryVcuCom10.byte(0) = CalculateRrcr2Crc(crcData);
}
// T1V兼容适配层：保留既有case入口，内部转发到统一实现。
int GetDtcRecoverySourceForCounter(int counterSource)
{
  if(counterSource == 14)
    return kDtcRecoverySourceVcuCom10;

  return GetDtcRecoverySourceForCrc(counterSource);
}

void Impl_Dtc_AliveCounterCycleBoundary_Run(int counterSource,
                                            int errorCycles, int expectDtc)
{
  Impl_Dtc_CounterCycleBoundary_Run(counterSource, errorCycles, expectDtc);
}

void Impl_Dtc_CommunicationLoss_Run(int faultSource, int durationMs)
{
  dword expectedDtc;
  char messageName[64];
  char caseDescription[160];

  expectedDtc = GetCommunicationLossDtc(faultSource);
  GetCommunicationLossMessageName(faultSource, messageName);
  if((expectedDtc == 0) || (durationMs <= 0))
  {
    testStepFail("通讯丢失配置",
                 "不支持的故障来源=%d或持续时间=%d ms。",
                 faultSource, durationMs);
    return;
  }

  snprintf(caseDescription, elcount(caseDescription),
           "%s通讯丢失%d ms：DTC 0x%06X。",
           messageName, durationMs, expectedDtc);
  DtcReportCaseTitle("DTC通讯丢失", caseDescription);
  if(!BeginDtcCase(GetDtcRecoverySourceForCommunicationLoss(faultSource)))
    return;

  if(!SetCommunicationLossFault(faultSource, 1, durationMs))
  {
    testStepFail("通讯丢失配置", "无法停止%s报文发送。", messageName);
    return;
  }

  testStep("故障注入", "停止%s发送，持续%d ms后读取DTC。",
           messageName, durationMs);
  testWaitForTimeout(durationMs);
  testWaitForTimeout(kDtcFaultObserveTimeMs);
  if(!CheckCommunicationLossDtc(expectedDtc))
  {
    SetCommunicationLossFault(faultSource, 0, 0);
    return;
  }

  SetCommunicationLossFault(faultSource, 0, 0);
  testStep("故障恢复", "%s报文发送已恢复。", messageName);
}

void Impl_Dtc_VcuDlc_Run()
{
  char messageName[64];

  DtcReportCaseTitle("DTC C44381", "VCU控制器网络DLC信号无效");
  if(!BeginDtcCase(kDtcRecoverySourceVcuCom10))
    return;
  if(!gLastVcuCom10Valid)
  {
    testStepFail("VCU_COM_10配置",
                 "未接收到正常VCU_COM_10（0x038）报文。");
    return;
  }

  snprintf(messageName, elcount(messageName), "VCU_COM_10 (0x038)");
  if(!StartDlcFaultFrameSequence(0x038) ||
     !WaitForDlcFaultFrameSequence(10, messageName))
    return;

  CheckCurrentDtcAndNoCommunicationLoss(kDtcVcuNetworkSignalInvalid,
                                        kDtcVcuCommunicationLoss, messageName);
  testStep("故障恢复", "VCU_COM_10（0x038）已由公共恢复流程恢复。");
}

void Impl_PressureTest_Run(int pressureType)
{
  char caseTitleText[32];
  char description[64];

  if(pressureType == 1)
  {
    snprintf(caseTitleText, elcount(caseTitleText), "STRESS_001");
    snprintf(description, elcount(description), "电气检查");
  }
  else if(pressureType == 2)
  {
    snprintf(caseTitleText, elcount(caseTitleText), "STRESS_002");
    snprintf(description, elcount(description), "报文周期监控");
  }
  else if(pressureType == 3)
  {
    snprintf(caseTitleText, elcount(caseTitleText), "STRESS_003");
    snprintf(description, elcount(description), "休眠唤醒循环");
  }
  else if(pressureType == 4)
  {
    snprintf(caseTitleText, elcount(caseTitleText), "STRESS_004");
    snprintf(description, elcount(description), "DTC老化");
  }
  else
  {
    testStepFail("压力测试配置", "不支持的压力测试类型=%d。", pressureType);
    return;
  }

  Impl_Dtc_PressureTest_Run(pressureType, caseTitleText, description);
}

// ===== VXT测试用例入口：只负责传入参数，具体业务逻辑位于上方Impl_*函数 =====
testcase Generic_UdsRaw(char requestHex[], char expectedHex[], int addressMode)
{
  byte requestBytes[512];
  byte requestMasks[512];
  byte expectedBytes[512];
  byte expectedMasks[512];
  byte responseBytes[512];
  int requestLength;
  int expectedLength;
  int responseLength;
  int waitResult;
  int index;
  long sendResult;
  diagRequest* request;
  diagResponse request response;

  diagSetTarget("T1V_G_RLCR");
  requestLength = DecodeHexBytes(requestHex, requestBytes, requestMasks);
  if(requestLength <= 0)
  {
    testStepFail("UDS请求", "请求数据无效：%s。", requestHex);
    return;
  }

  expectedLength = DecodeHexBytes(expectedHex, expectedBytes, expectedMasks);
  if(expectedLength < 0)
  {
    testStepFail("期望响应", "期望响应数据无效：%s。", expectedHex);
    return;
  }

  DiagResize(request, requestLength);
  DiagSetPrimitiveData(request, requestBytes, requestLength);

  if(addressMode == 0)
    sendResult = diagsendFunctional(request);
  else
    sendResult = diagSendRequest(request);

  if(sendResult < 0)
  {
    testStepFail("UDS请求", "发送失败，结果=%ld。", sendResult);
    return;
  }

  testWaitForDiagRequestSent(request, 100);

  if(expectedLength == 0)
  {
    waitResult = testWaitForDiagResponse(request, 2000);
    if(waitResult == 0)
      testStepPass("UDS响应", "符合预期，未收到响应。");
    else
      testStepFail("UDS响应", "收到非预期诊断响应。");
    return;
  }

  waitResult = testWaitForDiagResponse(request, 5000);
  if(waitResult != 1)
  {
    testStepFail("UDS响应", "未收到期望响应，等待结果=%d。", waitResult);
    return;
  }

  diagGetLastResponse(request, response);
  responseLength = diagGetPrimitiveData(response, responseBytes, elcount(responseBytes));
  if(responseLength != expectedLength)
  {
    testStepFail("UDS响应", "响应长度不一致，期望=%d，实际=%d。",
                 expectedLength, responseLength);
    return;
  }

  for(index = 0; index < expectedLength; index++)
  {
    if((expectedMasks[index] != 0) && (responseBytes[index] != expectedBytes[index]))
    {
      testStepFail("UDS响应", "第%d字节不一致，期望=0x%02X，实际=0x%02X。",
                   index, expectedBytes[index], responseBytes[index]);
      return;
    }
  }

  testStepPass("UDS响应", "响应符合测试规范。");
}

testcase Manual_UdsCase(char sourceCase[], char reason[])
{
  testStepWarning("人工测试项", "%s：%s", sourceCase, reason);
}

testcase Dtc_CommunicationLoss_Onebox1()
{
  SelectDtcLoggingGroup(1);
  testCaseTitle("DTC_001", "ONEBOX_1（0x098）通讯丢失");

  if(!ClearAllDtcs())
    return;

  testStepPass("已确认清除DTC",
               "已收到最终54肯定响应，开始注入0x098故障。");
  // 0表示ONEBOX_1（0x098）报文。
  // 停止发送报文500ms，用于验证普通通讯丢失DTC。
  @sysvar::Vehicle_input::MSG::ONEBOX_1_0x98 = 0;
  @sysvar::Vehicle_input::Message_MissingTime::ONEBOX_1_0x98 = kDtcFaultInjectDurationMs;
  testWaitForTimeout(100);

  testStep("故障注入", "停止ONEBOX_1（0x098）发送，持续%d ms。",
           kDtcFaultInjectDurationMs);
  @sysvar::Vehicle_input::MSG::ONEBOX_1_0x98 = 1;
  testWaitForTimeout(kDtcFaultInjectDurationMs);
  testStep("故障观察", "报文丢失结束，观察DTC状态%d ms。",
           kDtcFaultObserveTimeMs);
  testWaitForTimeout(kDtcFaultObserveTimeMs);

  ConfigureDtcReadRecovery(kDtcRecoverySourceOnebox1);
  CheckCurrentDtc(kDtcOneboxMessageLoss);

  @sysvar::Vehicle_input::MSG::ONEBOX_1_0x98 = 0;
  @sysvar::Vehicle_input::Message_MissingTime::ONEBOX_1_0x98 = 0;
  testStep("故障恢复", "ONEBOX_1（0x098）报文发送已恢复。");
}

