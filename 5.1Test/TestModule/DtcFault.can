/*@!Encoding:936*/
includes
{
  #include "DiagnosticRawServices.cin"
  #include "ReportAndLog.cin"
  #include "merged_mode_controller.cin"
}

// 公共配置、故障注入状态和最近有效报文缓存。
// 后续恢复帧基于缓存报文生成，以保持原报文布局、计数器和CRC关系。
variables
{
  // 默认0x098通讯丢失注入时长；仅用于未传入独立时长参数的默认流程。
  const dword kDtcFaultInjectDurationMs = 500;
  const dword kDtcFaultObserveTimeMs = 500;
  const int kDtcNormalCrcFaultFrameCount = 10;
  const int kDtcInvalidFrameCount = 10;
  const int kDtcDlcFaultValue = 7;
  // 对齐K01A：清DTC收到54后等待500 ms，再开始故障注入。
  const dword kDtcClearCompleteWaitMs = 500;

  // 每个DTC用例开始前，连续收到5帧关联正常报文，确认报文基准稳定。
  const int kDtcCaseBaselineFrameTargetCount = 5;

  // 故障恢复后连续收到3帧正常报文，再读取DTC恢复状态。
  const int kDtcRecoveryFrameTargetCount = 3;
  // 首次恢复状态仍为09时，额外等待1帧正常报文后复读。
  const int kDtcPostFaultRecoveryRetryFrameTargetCount = 1;

  const int kDtcFaultPendingStatus = 0x01;

  const int kDtcFaultStatus = 0x09;

  const int kDtcRecoveredStatus = 0x08;
  const dword kFlzcu9SignalFaultObserveTimeMs = 1000; // 0x49D周期100ms，信号无效持续10个周期
  // 默认DTC结果判定等待；故障态读取后的恢复流程会显式跳过。
  const dword kDtcResultJudgeDelayMs = 300;
  const dword kDtcDiagnosticSettleTimeMs = 500;
  const dword kDtcClearRetryDelayMs = 500;
  const int kDtcClearRetryCount = 3;
  const float kRrcr2BoundaryTimingToleranceMs = 2.0;
  const int kCommunicationLossStabilizationFrameCount = 5;
  char gDtcFaultCommLossStabilizedEvent[40] =
    "DtcFault_CommLossStabilized";
  char gDtcFaultCommLossInjectionStartedEvent[48] =
    "DtcFault_CommLossInjectionStarted";
  char gDtcFaultCommLossRecoverySentEvent[44] =
    "DtcFault_CommLossRecoverySent";
  char gDtcFaultRrcr2InjectionStartedEvent[46] =
    "DtcFault_Rrcr2InjectionStarted";
  char gDtcFaultRrcr2RecoverySentEvent[42] =
