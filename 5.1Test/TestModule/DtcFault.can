  char gDtcFaultDlcFrameSequenceCompleteEvent[48] =
    "DtcFault_DlcFrameSequenceComplete";  char gDtcFaultCrcBoundaryCompleteEvent[48] =

    "DtcFault_CrcBoundaryComplete";

  char gDtcFaultCounterBoundaryCompleteEvent[48] =

    "DtcFault_CounterBoundaryComplete";

  char gDtcFaultSignalInvalidCompleteEvent[48] =

    "DtcFault_SignalInvalidComplete";

  char gDtcRecoveryFrameCompleteEvent[48] =

    "DtcFault_RecoveryFrames";
char gDtcReportDisplayTitle[256];
  char gDtcLoggingGroupName[160];
  const dword kDtcExpectedCodeLeftZoneSignalInvalid = 0xC44481;
  const dword kDtcOneboxMessageLoss = 0xC12987;
  const dword kDtcVehicleSpeedSignalInvalid = 0xC41881;
  const dword kDtcSasMessageLoss = 0xC13187;
  const dword kDtcAcuMessageLoss = 0xC15187;
  const dword kDtcRrcrMessageLoss = 0xD16987;
  const dword kDtcLeftZoneMessageLoss = 0xC14187;
  const dword kDtcVcuCommunicationLoss = 0xC14087;
  const dword kDtcVcuNetworkSignalInvalid = 0xC44381;  const int kDtcRecoverySourceFlzcu1 = 1;

