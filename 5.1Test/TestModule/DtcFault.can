  int gCounterBoundaryObservedCycles;
  int gCounterBoundaryComplete;
  char gCounterBoundaryMessageName[64];
  float gCounterBoundaryFirstFrameTimestampMs;
  byte gCounterBoundaryCurrentCounter;
  byte gCounterBoundaryFirstCounter;
  int gCounterBoundaryUnexpectedChangedFrameCount;
  byte gPressureTestStopRequested = 0;
}

// 按X正常结束当前压力测试；测试用例返回后再停止测量即可避免强制终止。
on key 'x'
{
  if(DtcFaultControllerStopPressureTest())
  {
    gPressureTestStopRequested = 1;
  }
}

// ===== 报文监控与故障帧边界控制 =====
void ObserveCrcBoundaryFrame(int crcSource, int isCrcValid)
{
  if((!gCrcBoundaryActive) || (gCrcBoundarySource != crcSource))
    return;

  // CRC不可用时不计数；注入窗口内混入正常CRC帧则不能视为连续错误。
  if(isCrcValid < 0)
    return;
  if(isCrcValid)
  {
    // The IL switch can take effect one cycle later. Ignore normal frames
    // before the first observed CRC error, then require no valid gaps.
    if(!gCrcBoundaryInjectionStarted)
      return;
    gCrcBoundaryUnexpectedValidFrameCount++;
    return;
  }

  gCrcBoundaryInjectionStarted = 1;
  gCrcBoundaryObservedCycles++;
  if(gCrcBoundaryObservedCycles == 1)
  {
    gCrcBoundaryFirstFrameTimestampMs = timeNowFloat() / 100.0;
    testStep("故障注入",
             "%s：第一帧CRC/校验和错误，测量时间戳=%.3f ms。",
             gCrcBoundaryMessageName, gCrcBoundaryFirstFrameTimestampMs);
  }

  if(gCrcBoundaryObservedCycles < gCrcBoundaryTargetCycles)
    return;


  testStep("故障注入",
           "%s已按原周期发送并确认%d帧CRC/校验和错误。",
           gCrcBoundaryMessageName, gCrcBoundaryObservedCycles);
  gCrcBoundaryActive = 0;
  gCrcBoundaryComplete = 1;
  TestSupplyTextEvent(gDtcFaultCrcBoundaryCompleteEvent);
}
// COUNT边界用例同样按实际接收帧数计数，避免用固定时间估算造成多发或少发。
void ObserveCounterBoundaryFrame(int counterSource)
{
  byte currentCounter;

  if(gCounterBoundarySource != counterSource)
    return;

  currentCounter = gCounterBoundaryCurrentCounter & 0x0F;
  if(gCounterBoundaryBaselineActive)
  {
    gCounterBoundaryFirstCounter = currentCounter;
    gCounterBoundaryCounterValueValid = 1;
    return;
  }

  if(!gCounterBoundaryActive)
    return;

  if(!gCounterBoundaryCounterValueValid)
  {
    gCounterBoundaryFirstCounter = currentCounter;
    gCounterBoundaryCounterValueValid = 1;
    return;
  }

  if(gCounterBoundaryObservedCycles == 0)
  {
    if(currentCounter != gCounterBoundaryFirstCounter)
    {
      // Skip the first increment from the normal baseline; count only repeated values.
      gCounterBoundaryFirstCounter = currentCounter;
      return;
    }
  }
  else if(currentCounter != gCounterBoundaryFirstCounter)
  {
    // COUNT阈值用例要求连续冻结；发现递增或跳变帧时不纳入错误帧计数。
    gCounterBoundaryUnexpectedChangedFrameCount++;
    return;
  }

  gCounterBoundaryObservedCycles++;
  if(gCounterBoundaryObservedCycles == 1)
  {
    gCounterBoundaryFirstFrameTimestampMs = timeNowFloat() / 100.0;
    testStep("故障注入",
             "%s：第一帧COUNT错误，测量时间戳=%.3f ms。",
             gCounterBoundaryMessageName, gCounterBoundaryFirstFrameTimestampMs);
  }

  if(gCounterBoundaryObservedCycles < gCounterBoundaryTargetCycles)
    return;


  testStep("故障注入",
           "%s已按原周期发送并确认连续%d帧COUNT冻结。",
           gCounterBoundaryMessageName, gCounterBoundaryObservedCycles);
  gCounterBoundaryActive = 0;
  gCounterBoundaryComplete = 1;
  TestSupplyTextEvent(gDtcFaultCounterBoundaryCompleteEvent);
}

void ObserveCommunicationLossStabilizationFrame(int faultSource)
{
  float timestampMs;

  if((!gCommunicationLossStabilizationActive) ||
     (gCommunicationLossStabilizationSource != faultSource))
    return;

  timestampMs = timeNowFloat() / 100.0;
  if(gCommunicationLossStabilizationFrameCount > 0)
    gCommunicationLossObservedCycleMs =
      timestampMs - gCommunicationLossPreviousTimestampMs;

  gCommunicationLossPreviousTimestampMs = timestampMs;
  gCommunicationLossStabilizationFrameCount++;
  if(gCommunicationLossStabilizationFrameCount >=
     kCommunicationLossStabilizationFrameCount)
  {
    gCommunicationLossStabilizationActive = 0;
    gCommunicationLossStabilizationReady = 1;
    TestSupplyTextEvent(gDtcFaultCommLossStabilizedEvent);
  }
}

void ObserveCommunicationLossBoundaryFrameDuringLoss(int faultSource)
{
  float frameTimestampMs;

  if((!gCommunicationLossBoundaryInjectionActive) ||
     (gCommunicationLossBoundarySource != faultSource))
    return;

  frameTimestampMs = timeNowFloat() / 100.0;
  gCommunicationLossBoundaryUnexpectedFrameCount++;
  if(gCommunicationLossBoundaryUnexpectedFrameCount == 1)
    gCommunicationLossBoundaryFirstUnexpectedFrameTimestampMs = frameTimestampMs;

  // A frame can already be queued when the stop request takes effect.
  // Re-anchor the loss window to the last frame actually seen on the bus.
  gCommunicationLossBoundaryLastFrameTimestampMs = frameTimestampMs;
  setTimer(gCommunicationLossRecoveryTimer,
           gCommunicationLossBoundaryRequestedDurationMs);
}

void ObserveRrcr2BoundaryFrameDuringLoss()
{
  if(!gRrcr2BoundaryInjectionActive)
    return;

  gRrcr2BoundaryUnexpectedFrameCount++;
  if(gRrcr2BoundaryUnexpectedFrameCount == 1)
    gRrcr2BoundaryFirstUnexpectedFrameTimestampMs = timeNowFloat() / 100.0;
}
void ObserveDtcRecoveryFrame(int recoverySource, int isFrameNormal)
{
  if((!gDtcRecoveryFrameMonitorActive) ||
     (gDtcRecoveryFrameSource != recoverySource))
    return;
  if(!isFrameNormal)
  {
    gDtcRecoveryFrameCount = 0;
    return;
  }
  gDtcRecoveryFrameCount++;
  if(gDtcRecoveryFrameCount >= gDtcRecoveryFrameTargetCount)
  {
    gDtcRecoveryFrameMonitorActive = 0;
    TestSupplyTextEvent(gDtcRecoveryFrameCompleteEvent);
  }
}

void ObserveDtcSignalInvalidFrame(int recoverySource, int isSignalInvalid)
{
  if((!gDtcSignalInvalidFrameMonitorActive) ||
     (gDtcSignalInvalidFrameSource != recoverySource))
    return;
  if(!isSignalInvalid)
  {
    gDtcSignalInvalidFrameCount = 0;
    return;
  }
  gDtcSignalInvalidFrameCount++;
  if(gDtcSignalInvalidFrameCount >= kDtcInvalidFrameCount)
  {
    gDtcSignalInvalidFrameMonitorActive = 0;
    TestSupplyTextEvent(gDtcFaultSignalInvalidCompleteEvent);
  }
}

void StartDtcSignalInvalidFrameMonitor(int recoverySource, int criterion)
{
  gDtcSignalInvalidFrameMonitorActive = 1;
  gDtcSignalInvalidFrameSource = recoverySource;
  gDtcSignalInvalidCriterion = criterion;
  gDtcSignalInvalidFrameCount = 0;
}

// 信号无效帧由接收回调计数；此处只等待达到目标帧数的文本事件，再统一判定超时或通过。
int WaitForDtcSignalInvalidFrames(int cycleMs, char messageName[])
{
  int timeoutMs;

  timeoutMs = (cycleMs * (kDtcInvalidFrameCount + 2)) + 100;
  testWaitForTextEvent(gDtcFaultSignalInvalidCompleteEvent, timeoutMs);
  gDtcSignalInvalidFrameMonitorActive = 0;
  if(gDtcSignalInvalidFrameCount < kDtcInvalidFrameCount)
  {
    testStepFail("故障注入", "%s在%d ms内收到%d/%d帧无效报文。",
                 messageName, gDtcSignalInvalidFrameCount,
                 kDtcInvalidFrameCount, timeoutMs);
    return 0;
  }

  testStepPass("故障注入", "%s已收到%d帧无效报文。",
               messageName, gDtcSignalInvalidFrameCount);
  return 1;
}

// 所有信号无效用例共用：基线正常、54后等待500 ms，再开始连续10帧异常确认。
int BeginDtcSignalInvalidCase(int recoverySource, int criterion)
{
  if(!BeginDtcCase(recoverySource))
    return 0;

  StartDtcSignalInvalidFrameMonitor(recoverySource, criterion);
  return 1;
}

void PrepareDtcReadAfterFaultFrames(char messageName[])
{
  testStep("DTC读取等待", "%s第10帧故障报文已确认，立即读取DTC。",
           messageName);
}
// 连续10帧故障后立即读取故障态DTC；读取完成后恢复，收到3帧正常报文再复读。
int CompleteDtcSignalInvalidCase(dword expectedDtc, int cycleMs,
                                 char messageName[])
{
  if(!WaitForDtcSignalInvalidFrames(cycleMs, messageName))
    return 0;

  PrepareDtcReadAfterFaultFrames(messageName);
  return CheckCurrentDtc(expectedDtc);
}
// 报文接收回调：先复制完整数据并重算CRC，只把确认无效的帧交给边界计数器。
// ===== 报文接收回调：缓存最新正常帧，并驱动CRC、COUNT、通讯丢失、恢复和信号无效监控 =====
on message FL_DA_CANFD_RLCR::FLZCU_1
{
  byte frameData[64];
  int i;
  int payloadLength;

  ObserveDlcFaultFrame(0x23B, this.dlc);
  gLastFlzcu1 = this;
  gLastFlzcu1Valid = 1;
  payloadLength = DtcFaultGetPayloadLength(this.dlc);
  if(payloadLength > 64) payloadLength = 64;
  for(i = 0; i < payloadLength; i++)
    frameData[i] = this.byte(i);

  ObserveCommunicationLossBoundaryFrameDuringLoss(5);
  TryStartCommunicationLossBoundary(5);
  ObserveCommunicationLossStabilizationFrame(5);
  ObserveDtcCrcFrame(frameData, payloadLength, 1, 0, 0x36);
  gCounterBoundaryCurrentCounter = this.byte(1);
  ObserveCounterBoundaryFrame(1);
  ObserveDtcRecoveryFrame(kDtcRecoverySourceFlzcu1,
    (payloadLength == 8) && DtcFaultGetCrcState(frameData, payloadLength, 0, 0x36));
}

// 0x49D signal-invalid and DLC recovery monitor.
on message FL_DA_CANFD_RLCR::FLZCU_9
{
  ObserveDlcFaultFrame(0x49D, this.dlc);
  ObserveDtcRecoveryFrame(kDtcRecoverySourceFlzcu9,
    (this.dlc == 8) && (this.FLZCU_9_ArmingSts == 0));
  ObserveDtcSignalInvalidFrame(kDtcRecoverySourceFlzcu9,
    (gDtcSignalInvalidCriterion == kDtcSignalCriterionFlzcu9ArmingStatus) &&
    (this.FLZCU_9_ArmingSts == 3));
}

on message FL_DA_CANFD_RLCR::FRZCU_1
{
  byte frameData[64];
  int i;
  int payloadLength;

  ObserveDlcFaultFrame(0x2AB, this.dlc);
  payloadLength = DtcFaultGetPayloadLength(this.dlc);
  if(payloadLength > 64) payloadLength = 64;
  for(i = 0; i < payloadLength; i++)
    frameData[i] = this.byte(i);
  ObserveDtcCrcFrame(frameData, payloadLength, 2, 0, 0x3A);
  gCounterBoundaryCurrentCounter = this.byte(1);
  ObserveCounterBoundaryFrame(2);
  ObserveDtcRecoveryFrame(kDtcRecoverySourceFrzcu1,
    (payloadLength == 8) && DtcFaultGetCrcState(frameData, payloadLength, 0, 0x3A));
}

on message FL_DA_CANFD_RLCR::RZCU_2
{
  byte frameData[64];
  int i;
  int payloadLength;

  ObserveDlcFaultFrame(0x2BB, this.dlc);
  payloadLength = DtcFaultGetPayloadLength(this.dlc);
  if(payloadLength > 64) payloadLength = 64;
  for(i = 0; i < payloadLength; i++)
    frameData[i] = this.byte(i);
  ObserveDtcCrcFrame(frameData, payloadLength, 3, 0, 0x3B);
  gCounterBoundaryCurrentCounter = this.byte(1);
  ObserveCounterBoundaryFrame(3);
  ObserveDtcRecoveryFrame(kDtcRecoverySourceRzcu2,
    (payloadLength == 8) && DtcFaultGetCrcState(frameData, payloadLength, 0, 0x3B));
}

on message FL_DA_CANFD_RLCR::ONEBOX_1
{
  byte frameData[64];
  int i;
  int payloadLength;
  int crc1State;
  int signalInvalid;

  ObserveDlcFaultFrame(0x098, this.dlc);
  gLastOnebox1 = this;
  gLastOnebox1Valid = 1;
  payloadLength = DtcFaultGetPayloadLength(this.dlc);
  if(payloadLength > 64) payloadLength = 64;
  for(i = 0; i < payloadLength; i++)
    frameData[i] = this.byte(i);

  crc1State = DtcFaultGetCrcState(frameData, payloadLength, 0, 0x49);
  ObserveCommunicationLossBoundaryFrameDuringLoss(0);
  TryStartCommunicationLossBoundary(0);
  ObserveCommunicationLossStabilizationFrame(0);
  ObserveCrcBoundaryFrame(4, crc1State);
  ObserveDtcCrcFrame(frameData, payloadLength, 10, 8, 0x4A);
  gCounterBoundaryCurrentCounter = this.byte(1);
  ObserveCounterBoundaryFrame(4);
  ObserveDtcRecoveryFrame(kDtcRecoverySourceOnebox1,
    (payloadLength == 24) &&
    DtcFaultGetCrcState(frameData, payloadLength, 0, 0x49) &&
    DtcFaultGetCrcState(frameData, payloadLength, 8, 0x4A));
  signalInvalid = 0;
  if(gDtcSignalInvalidCriterion == kDtcSignalCriterionOnebox1SpeedValid)
    signalInvalid = (this.ESP1_VehicleSpeedVSOSigValidData == 1);
  else if(gDtcSignalInvalidCriterion == kDtcSignalCriterionOnebox1SpeedRaw)
    signalInvalid = (this.ABS_ESP_1_VehicleSpeedVSOSig >= 511.9);
  ObserveDtcSignalInvalidFrame(kDtcRecoverySourceOnebox1, signalInvalid);
}

on message FL_DA_CANFD_RLCR::ONEBOX_3
{
  byte frameData[64];
  int i;
  int payloadLength;
  int signalInvalid;

  ObserveDlcFaultFrame(0x22B, this.dlc);
  payloadLength = DtcFaultGetPayloadLength(this.dlc);
  if(payloadLength > 64) payloadLength = 64;
  for(i = 0; i < payloadLength; i++)
    frameData[i] = this.byte(i);

  ObserveDtcCrcFrame(frameData, payloadLength, 5, 0, 0x4D);
  ObserveDtcCrcFrame(frameData, payloadLength, 11, 8, 0x4E);
  ObserveDtcCrcFrame(frameData, payloadLength, 12, 24, 0x50);
  gCounterBoundaryCurrentCounter = this.byte(1);
  ObserveCounterBoundaryFrame(5);
  ObserveDtcRecoveryFrame(kDtcRecoverySourceOnebox3,
    (payloadLength == 48) &&
    DtcFaultGetCrcState(frameData, payloadLength, 0, 0x4D) &&
    DtcFaultGetCrcState(frameData, payloadLength, 8, 0x4E) &&
    DtcFaultGetCrcState(frameData, payloadLength, 24, 0x50));
  signalInvalid = 0;
  if(gDtcSignalInvalidCriterion == kDtcSignalCriterionOnebox3Standstill)
    signalInvalid = (this.VehicleStandstill == 2);
  ObserveDtcSignalInvalidFrame(kDtcRecoverySourceOnebox3, signalInvalid);
}

on message FL_DA_CANFD_RLCR::SAS_1
{
  byte frameData[64];
  int i;
  int payloadLength;
  int signalInvalid;

  ObserveDlcFaultFrame(0x132, this.dlc);
  gLastSas1 = this;
  gLastSas1Valid = 1;
  payloadLength = DtcFaultGetPayloadLength(this.dlc);
  if(payloadLength > 64) payloadLength = 64;
  for(i = 0; i < payloadLength; i++)
    frameData[i] = this.byte(i);

  ObserveCommunicationLossBoundaryFrameDuringLoss(1);
  TryStartCommunicationLossBoundary(1);
  ObserveCommunicationLossStabilizationFrame(1);
  ObserveDtcCrcFrame(frameData, payloadLength, 6, 0, 0x35);
  gCounterBoundaryCurrentCounter = this.byte(1);
  ObserveCounterBoundaryFrame(6);
  ObserveDtcRecoveryFrame(kDtcRecoverySourceSas1,
    (payloadLength == 8) && DtcFaultGetCrcState(frameData, payloadLength, 0, 0x35));
  signalInvalid = 0;
  if(gDtcSignalInvalidCriterion == kDtcSignalCriterionSasAngleRaw)
    signalInvalid = (this.SAM_1_SteeringAngle >= 2047.9);
  else if(gDtcSignalInvalidCriterion == kDtcSignalCriterionSasAngleValid)
    signalInvalid = (this.SAM_1_SteeringAngleVD == 1);
  else if(gDtcSignalInvalidCriterion == kDtcSignalCriterionSasAngleSpeedValid)
    signalInvalid = (this.SAM_1_SteeringAngleSpeedVD == 1);
  ObserveDtcSignalInvalidFrame(kDtcRecoverySourceSas1, signalInvalid);
}

on message FL_DA_CANFD_RLCR::ACU_2
{
  byte frameData[64];
  int i;
  int payloadLength;
  int signalInvalid;

  ObserveDlcFaultFrame(0x031, this.dlc);
  payloadLength = DtcFaultGetPayloadLength(this.dlc);
  if(payloadLength > 64) payloadLength = 64;
  for(i = 0; i < payloadLength; i++)
    frameData[i] = this.byte(i);
  ObserveDtcRecoveryFrame(kDtcRecoverySourceAcu2,
    (payloadLength == 8) && DtcFaultGetCrcState(frameData, payloadLength, 0, 0x01));
  ObserveDtcCrcFrame(frameData, payloadLength, 7, 0, 0x01);
  gCounterBoundaryCurrentCounter = this.byte(1);
  ObserveCounterBoundaryFrame(7);
  signalInvalid = 0;
  if(gDtcSignalInvalidCriterion == kDtcSignalCriterionAcu2LateralRaw)
    signalInvalid = (this.ACU_2_LateralAcceleration >= 63.5);
  else if(gDtcSignalInvalidCriterion == kDtcSignalCriterionAcu2YawRaw)
    signalInvalid = (this.ACU_2_YawRate >= 475.3);
  else if(gDtcSignalInvalidCriterion == kDtcSignalCriterionAcu2YawValid)
    signalInvalid = (this.ACU_2_YawrateSigValidData == 2);
  ObserveDtcSignalInvalidFrame(kDtcRecoverySourceAcu2, signalInvalid);
}
on message FL_DA_CANFD_RLCR::ACU_3
{
  byte frameData[64];
  int i;
  int payloadLength;
  int signalInvalid;

  ObserveDlcFaultFrame(0x021, this.dlc);
  gLastAcu3 = this;
  gLastAcu3Valid = 1;
  payloadLength = DtcFaultGetPayloadLength(this.dlc);
  if(payloadLength > 64) payloadLength = 64;
  for(i = 0; i < payloadLength; i++)
    frameData[i] = this.byte(i);

  ObserveDtcRecoveryFrame(kDtcRecoverySourceAcu3,
    (payloadLength == 8) && DtcFaultGetCrcState(frameData, payloadLength, 0, 0x02));
  ObserveCommunicationLossBoundaryFrameDuringLoss(2);
  TryStartCommunicationLossBoundary(2);
  ObserveCommunicationLossStabilizationFrame(2);
  ObserveDtcCrcFrame(frameData, payloadLength, 8, 0, 0x02);
  gCounterBoundaryCurrentCounter = this.byte(1);
  ObserveCounterBoundaryFrame(8);
  signalInvalid = 0;
  if(gDtcSignalInvalidCriterion == kDtcSignalCriterionAcu3LongitudinalRaw)
    signalInvalid = (this.ACU_3_LongitudinalAcceleration >= 63.5);
  else if(gDtcSignalInvalidCriterion == kDtcSignalCriterionAcu3LongitudinalValid)
    signalInvalid = (this.ACU_3_LongitudinalAccelerationVD == 2);
  ObserveDtcSignalInvalidFrame(kDtcRecoverySourceAcu3, signalInvalid);
}
on message FL_DA_CANFD_RLCR::ICC_COM_8
{
  ObserveDtcRecoveryFrame(kDtcRecoverySourceIccCom8, this.dlc == 8);
  gLastIccCom8 = this;
  gLastIccCom8Valid = 1;
  ObserveCommunicationLossBoundaryFrameDuringLoss(4);
  TryStartCommunicationLossBoundary(4);
  ObserveCommunicationLossStabilizationFrame(4);
}
// 0x4F7是通讯丢失边界用例的特殊报文：收到最后正常帧时启动丢失定时器，
// 以该帧时间戳为零点计算实际丢失时长。
on message FL_DA_CANFD_RLCR::VCU_COM_10
{
  byte frameData[64];
  int i;
  int payloadLength;
  int crcState;

  ObserveDlcFaultFrame(0x038, this.dlc);
  gLastVcuCom10 = this;
  gLastVcuCom10Valid = 1;
  payloadLength = DtcFaultGetPayloadLength(this.dlc);
  if(payloadLength > 64) payloadLength = 64;
  for(i = 0; i < payloadLength; i++)
    frameData[i] = this.byte(i);

  crcState = DtcFaultGetCrcState(frameData, payloadLength, 0, 0x68);
  ObserveDtcRecoveryFrame(kDtcRecoverySourceVcuCom10,
                          (payloadLength == 16) && (crcState == 1));
  ObserveCommunicationLossBoundaryFrameDuringLoss(6);
  TryStartCommunicationLossBoundary(6);
  ObserveCommunicationLossStabilizationFrame(6);
  ObserveDtcCrcFrame(frameData, payloadLength, 13, 0, 0x68);
  gCounterBoundaryCurrentCounter = this.byte(1);
  ObserveCounterBoundaryFrame(14);
}
on message FL_DA_CANFD_RLCR::RRCR_2
{
  byte frameData[64];
  int i;
  int payloadLength;

  ObserveDlcFaultFrame(0x4F7, this.dlc);
  gLastRRCR2 = this;
  gLastRRCR2Valid = 1;
  gLastRRCR2TimestampMs = timeNowFloat() / 100.0;
  payloadLength = DtcFaultGetPayloadLength(this.dlc);
  if(payloadLength > 64) payloadLength = 64;
  for(i = 0; i < payloadLength; i++)
    frameData[i] = this.byte(i);

  // RRCR_2有专用接收回调，因此单独送入休眠唤醒监控。
  SrRecordTargetMessage(this.ID, this.dlc);
  ObserveRrcr2BoundaryFrameDuringLoss();
  ObserveCommunicationLossStabilizationFrame(3);

  if(gRrcr2BoundaryArm)
  {
    gRrcr2BoundaryArm = 0;
    gRrcr2BoundaryInjectionActive = 1;
    gRrcr2BoundaryLastFrameTimestampMs = gLastRRCR2TimestampMs;
    gRrcr2BoundaryRecoveryFrameSent = 0;
    gRrcr2BoundaryUnexpectedFrameCount = 0;
    gRrcr2BoundaryFirstUnexpectedFrameTimestampMs = 0.0;

    // 保持IL源关闭，直到手动恢复帧发送。
    @sysvar::Vehicle_input::Message_MissingTime::RRCR_2_0x4F7 =
      gRrcr2BoundaryRequestedDurationMs + 1000;
    @sysvar::Vehicle_input::MSG::RRCR_2_0x4F7 = 1;
    setTimer(gRrcr2BoundaryRecoveryTimer, gRrcr2BoundaryRequestedDurationMs);

    testStep("总线时间基准",
             "0x4F7最后正常帧时间戳=%.3f ms；目标丢失=%d ms。",
             gRrcr2BoundaryLastFrameTimestampMs,
             gRrcr2BoundaryRequestedDurationMs);
    TestSupplyTextEvent(gDtcFaultRrcr2InjectionStartedEvent);
  }

  ObserveDtcCrcFrame(frameData, payloadLength, 9, 0, 0x47);
  gCounterBoundaryCurrentCounter = this.byte(1);
  ObserveCounterBoundaryFrame(9);
  ObserveDtcRecoveryFrame(kDtcRecoverySourceRrcr2,
    (payloadLength == 8) && DtcFaultGetCrcState(frameData, payloadLength, 0, 0x47));
}
// ===== E2E CRC计算与手动恢复帧 =====
// 手动恢复帧复用此E2E CRC算法，保证恢复帧不额外引入CRC故障。
byte CalculateRrcr2Crc(byte buffer[])
{
  byte checksum;
  int i;
  int j;

  checksum = 0x00;
  for(i = 0; i < 9; i++)
  {
    checksum = checksum ^ buffer[i];
    for(j = 0; j < 8; j++)
    {
      if(checksum & 0x80)
        checksum = (checksum << 1) ^ 0x1D;
      else
        checksum = checksum << 1;
    }
  }

  return checksum;
}

// CAN FD DLC转实际数据长度，供CRC字段可用性判断。
int DtcFaultGetPayloadLength(int dlcVal)
{
  if(dlcVal <= 8) return dlcVal;
  if(dlcVal == 9) return 12;
  if(dlcVal == 10) return 16;
  if(dlcVal == 11) return 20;
  if(dlcVal == 12) return 24;
  if(dlcVal == 13) return 32;
  if(dlcVal == 14) return 48;
  if(dlcVal == 15) return 64;
  return dlcVal;
}

// 统一CRC输入范围：DataID两个字节 + CRC字段之外的7个字节。
byte DtcFaultCalculateSegmentCrc(byte frameData[], int segmentOffset, byte dataId)
{
  byte crcData[9];
  int i;

  crcData[0] = dataId;
  crcData[1] = 0x00;
  for(i = 0; i < 7; i++)
    crcData[i + 2] = frameData[segmentOffset + 1 + i];

  return CalculateRrcr2Crc(crcData);
}

// 返回1=CRC正确，0=CRC错误，-1=该CRC段数据不完整，不能确认。
int DtcFaultGetCrcState(byte frameData[], int payloadLength,
                        int segmentOffset, byte dataId)
{
  if(payloadLength < (segmentOffset + 8))
    return -1;

  if(frameData[segmentOffset] ==
     DtcFaultCalculateSegmentCrc(frameData, segmentOffset, dataId))
    return 1;

  return 0;
}

void ObserveDtcCrcFrame(byte frameData[], int payloadLength, int crcSource,
                        int segmentOffset, byte dataId)
{
  int crcState;

  crcState = DtcFaultGetCrcState(frameData, payloadLength,
                                 segmentOffset, dataId);
  if(crcState >= 0)
    ObserveCrcBoundaryFrame(crcSource, crcState);
}
// 0x4F7丢失窗口到期后仅发送一帧正确恢复帧：COUNT递增、CRC重算，
// 然后把IL计数器同步到该COUNT，防止下一帧计数跳变。
void SendRrcr2BoundaryRecoveryFrame()
{
  int i;
  int nextCounter;
  byte crcData[9];

  gRrcr2BoundaryRecoveryFrame = gLastRRCR2;
  gRrcr2BoundaryRecoveryFrame.dlc = 8;
  nextCounter = (gRrcr2BoundaryRecoveryFrame.byte(1) & 0x0F) + 1;
  if(nextCounter > 14)
    nextCounter = 0;
  gRrcr2BoundaryRecoveryFrame.byte(1) =
    (gRrcr2BoundaryRecoveryFrame.byte(1) & 0xF0) | nextCounter;

  crcData[0] = 0x47;
  crcData[1] = 0x00;
  for(i = 1; i < 8; i++)
    crcData[i + 1] = gRrcr2BoundaryRecoveryFrame.byte(i);
  gRrcr2BoundaryRecoveryFrame.byte(0) = CalculateRrcr2Crc(crcData);

  gRrcr2BoundaryRecoveryTimestampMs = timeNowFloat() / 100.0;
  gRrcr2BoundaryRecoveryFrameSent = 1;
  gRrcr2BoundaryInjectionActive = 0;
  output(gRrcr2BoundaryRecoveryFrame);

  // 将IL的下一帧计数器同步到手动恢复帧，避免恢复后COUNT跳变。
  $CAN1::CGW::RRCR_2::RRCR_2_RollgCntr1 = nextCounter;
  @sysvar::Vehicle_input::MSG::RRCR_2_0x4F7 = 0;
  @sysvar::Vehicle_input::Message_MissingTime::RRCR_2_0x4F7 = 0;
  TestSupplyTextEvent(gDtcFaultRrcr2RecoverySentEvent);
}

// 该定时器从最后一帧正常0x4F7开始计时，到期即发送恢复帧。
on timer gRrcr2BoundaryRecoveryTimer
{
  if(gRrcr2BoundaryInjectionActive && gLastRRCR2Valid)
    SendRrcr2BoundaryRecoveryFrame();
}

// 用例退出或异常时统一取消0x4F7定时器并恢复IL发送控制，避免影响下一条用例。
void ResetRrcr2BoundaryTiming()
{
  cancelTimer(gRrcr2BoundaryRecoveryTimer);
  gRrcr2BoundaryArm = 0;
  gRrcr2BoundaryInjectionActive = 0;
  gRrcr2BoundaryRecoveryFrameSent = 0;
  gRrcr2BoundaryRequestedDurationMs = 0;
  gRrcr2BoundaryUnexpectedFrameCount = 0;
  gRrcr2BoundaryFirstUnexpectedFrameTimestampMs = 0.0;
  @sysvar::Vehicle_input::MSG::RRCR_2_0x4F7 = 0;
  @sysvar::Vehicle_input::Message_MissingTime::RRCR_2_0x4F7 = 0;
}

// Alive Counter有效范围为0~14，达到14后回绕到0。
int GetNextAliveCounter(byte counterByte)
{
  int nextCounter;

  nextCounter = (counterByte & 0x0F) + 1;
  if(nextCounter > 14)
    nextCounter = 0;
  return nextCounter;
}
void SetE2eCrcForOnebox1Recovery()
{
  int i;
  byte crcData[9];

  crcData[0] = 0x49;
  crcData[1] = 0x00;
  for(i = 1; i < 8; i++)
    crcData[i + 1] = gCommunicationLossRecoveryOnebox1.byte(i);
  gCommunicationLossRecoveryOnebox1.byte(0) = CalculateRrcr2Crc(crcData);

  crcData[0] = 0x4A;
  crcData[1] = 0x00;
  for(i = 1; i < 8; i++)
    crcData[i + 1] = gCommunicationLossRecoveryOnebox1.byte(i + 8);
  gCommunicationLossRecoveryOnebox1.byte(8) = CalculateRrcr2Crc(crcData);
}

void SetE2eCrcForSas1Recovery()
{
  int i;
  byte crcData[9];

  crcData[0] = 0x35;
  crcData[1] = 0x00;
  for(i = 1; i < 8; i++)
    crcData[i + 1] = gCommunicationLossRecoverySas1.byte(i);
  gCommunicationLossRecoverySas1.byte(0) = CalculateRrcr2Crc(crcData);
}

void SetE2eCrcForAcu3Recovery()
{
  int i;
  byte crcData[9];

  crcData[0] = 0x02;
  crcData[1] = 0x00;
  for(i = 1; i < 8; i++)
    crcData[i + 1] = gCommunicationLossRecoveryAcu3.byte(i);
  gCommunicationLossRecoveryAcu3.byte(0) = CalculateRrcr2Crc(crcData);
}

void SetE2eCrcForFlzcu1Recovery()
{
  int i;
  byte crcData[9];

  crcData[0] = 0x36;
  crcData[1] = 0x00;
  for(i = 1; i < 8; i++)
    crcData[i + 1] = gCommunicationLossRecoveryFlzcu1.byte(i);
  gCommunicationLossRecoveryFlzcu1.byte(0) = CalculateRrcr2Crc(crcData);
}

// ===== 通讯丢失阈值：以最后一帧正常报文为时间零点，到点发送一帧正确恢复报文 =====
int HasCommunicationLossBoundarySourceFrame(int faultSource)
{
  if(faultSource == 0)
    return gLastOnebox1Valid;
  if(faultSource == 1)
    return gLastSas1Valid;
  if(faultSource == 2)
    return gLastAcu3Valid;
  if(faultSource == 4)
    return gLastIccCom8Valid;
  if(faultSource == 5)
    return gLastFlzcu1Valid;

  if(faultSource == 6)
    return gLastVcuCom10Valid;

  return 0;
}

void ResetCommunicationLossBoundarySourceFrame(int faultSource)
{
  if(faultSource == 0)
    gLastOnebox1Valid = 0;
  else if(faultSource == 1)
    gLastSas1Valid = 0;
  else if(faultSource == 2)
    gLastAcu3Valid = 0;
  else if(faultSource == 4)
    gLastIccCom8Valid = 0;
  else if(faultSource == 5)
    gLastFlzcu1Valid = 0;
  else if(faultSource == 6)
    gLastVcuCom10Valid = 0;
}

// 通讯丢失通过关闭对应仿真源实现；durationMs 比目标丢失时间多预留1秒，
// 防止IL自动恢复报文早于脚本发送的恢复帧。
int SetCommunicationLossBoundaryFault(int faultSource, int enabled, int durationMs)
{
  if(faultSource == 0)
  {
    @sysvar::Vehicle_input::Message_MissingTime::ONEBOX_1_0x98 = durationMs;
    @sysvar::Vehicle_input::MSG::ONEBOX_1_0x98 = enabled;
  }
  else if(faultSource == 1)
  {
    @sysvar::Vehicle_input::Message_MissingTime::SAS_1_0x132 = durationMs;
    @sysvar::Vehicle_input::MSG::SAS_1_0x132 = enabled;
  }
  else if(faultSource == 2)
  {
    @sysvar::Vehicle_input::Message_MissingTime::ACU_3_0x021 = durationMs;
    @sysvar::Vehicle_input::MSG::ACU_3_0x021 = enabled;
  }
  else if(faultSource == 4)
  {
    @sysvar::Vehicle_input::Message_MissingTime::ICC_COM_8_0x510 = durationMs;
    @sysvar::Vehicle_input::MSG::ICC_COM_8_0x510 = enabled;
  }
  else if(faultSource == 5)
  {
    @sysvar::Vehicle_input::Message_MissingTime::FLZCU_1_0x23B = durationMs;
    @sysvar::Vehicle_input::MSG::FLZCU_1_0x23B = enabled;
  }
  else if(faultSource == 6)
  {
    @sysvar::Vehicle_input::Message_MissingTime::VCU_COM_10_0x38 = durationMs;
    @sysvar::Vehicle_input::MSG::VCU_COM_10_0x38 = enabled;
  }
  else
  {
    return 0;
  }

  return 1;
}

// 收到正常报文后请求停发；若仍收到后续帧，则从最后实际收到帧重新计算丢失时间。
void TryStartCommunicationLossBoundary(int faultSource)
{
  char messageId[8];

  if((!gCommunicationLossBoundaryArm) ||
     (gCommunicationLossBoundarySource != faultSource))
    return;

  gCommunicationLossBoundaryArm = 0;
  gCommunicationLossBoundaryInjectionActive = 1;
  gCommunicationLossBoundaryRecoveryFrameSent = 0;
  gCommunicationLossBoundaryUnexpectedFrameCount = 0;
  gCommunicationLossBoundaryFirstUnexpectedFrameTimestampMs = 0.0;
  gCommunicationLossBoundaryLastFrameTimestampMs = timeNowFloat() / 100.0;
  SetCommunicationLossBoundaryFault(faultSource, 1,
                                    gCommunicationLossBoundaryRequestedDurationMs + 1000);
  setTimer(gCommunicationLossRecoveryTimer,
           gCommunicationLossBoundaryRequestedDurationMs);

  if(faultSource == 0)
    snprintf(messageId, elcount(messageId), "0x098");
  else if(faultSource == 1)
    snprintf(messageId, elcount(messageId), "0x132");
  else if(faultSource == 2)
    snprintf(messageId, elcount(messageId), "0x021");
  else if(faultSource == 4)
    snprintf(messageId, elcount(messageId), "0x510");
  else if(faultSource == 5)
    snprintf(messageId, elcount(messageId), "0x23B");
  else
    snprintf(messageId, elcount(messageId), "0x038");

  testStep("总线时间基准",
           "%s最后正常帧时间戳=%.3f ms；目标丢失=%d ms。",
           messageId,
           gCommunicationLossBoundaryLastFrameTimestampMs,
           gCommunicationLossBoundaryRequestedDurationMs);
  TestSupplyTextEvent(gDtcFaultCommLossInjectionStartedEvent);
}

// 目标丢失时间到达后，手动发送一帧计数器和CRC正确的恢复帧，
// 再恢复仿真源，避免恢复首帧被判为新的CRC或COUNT故障。
void SendCommunicationLossBoundaryRecoveryFrame()
{
  int nextCounter1;
  int nextCounter2;

  gCommunicationLossBoundaryRecoveryTimestampMs = timeNowFloat() / 100.0;
  gCommunicationLossBoundaryInjectionActive = 0;
  if(gCommunicationLossBoundarySource == 0)
  {
    gCommunicationLossRecoveryOnebox1 = gLastOnebox1;
    // Keep the received CAN FD DLC (12 for a 24-byte payload).
    nextCounter1 = GetNextAliveCounter(gCommunicationLossRecoveryOnebox1.byte(1));
    nextCounter2 = GetNextAliveCounter(gCommunicationLossRecoveryOnebox1.byte(9));
    gCommunicationLossRecoveryOnebox1.byte(1) =
      (gCommunicationLossRecoveryOnebox1.byte(1) & 0xF0) | nextCounter1;
    gCommunicationLossRecoveryOnebox1.byte(9) =
      (gCommunicationLossRecoveryOnebox1.byte(9) & 0xF0) | nextCounter2;
    SetE2eCrcForOnebox1Recovery();
    output(gCommunicationLossRecoveryOnebox1);
    $CAN1::CGW::ONEBOX_1::ONEBOX_1_RollgCntr1 = nextCounter1;
    $CAN1::CGW::ONEBOX_1::ONEBOX_1_RollgCntr2 = nextCounter2;
  }
  else if(gCommunicationLossBoundarySource == 1)
  {
    gCommunicationLossRecoverySas1 = gLastSas1;
    gCommunicationLossRecoverySas1.dlc = 8;
    nextCounter1 = GetNextAliveCounter(gCommunicationLossRecoverySas1.byte(1));
    gCommunicationLossRecoverySas1.byte(1) =
      (gCommunicationLossRecoverySas1.byte(1) & 0xF0) | nextCounter1;
    SetE2eCrcForSas1Recovery();
    output(gCommunicationLossRecoverySas1);
    $CAN1::CGW::SAS_1::SAM_1_RollgCntr = nextCounter1;
  }
  else if(gCommunicationLossBoundarySource == 2)
  {
    gCommunicationLossRecoveryAcu3 = gLastAcu3;
    gCommunicationLossRecoveryAcu3.dlc = 8;
    nextCounter1 = GetNextAliveCounter(gCommunicationLossRecoveryAcu3.byte(1));
    gCommunicationLossRecoveryAcu3.byte(1) =
      (gCommunicationLossRecoveryAcu3.byte(1) & 0xF0) | nextCounter1;
    SetE2eCrcForAcu3Recovery();
    output(gCommunicationLossRecoveryAcu3);
    $CAN1::CGW::ACU_3::ACU_3_RollgCntr1 = nextCounter1;
  }
  else if(gCommunicationLossBoundarySource == 4)
  {
    gCommunicationLossRecoveryIccCom8 = gLastIccCom8;
    gCommunicationLossRecoveryIccCom8.dlc = 8;
    output(gCommunicationLossRecoveryIccCom8);
  }
  else if(gCommunicationLossBoundarySource == 5)
  {
    gCommunicationLossRecoveryFlzcu1 = gLastFlzcu1;
    gCommunicationLossRecoveryFlzcu1.dlc = 8;
    nextCounter1 = GetNextAliveCounter(gCommunicationLossRecoveryFlzcu1.byte(1));
    gCommunicationLossRecoveryFlzcu1.byte(1) =
      (gCommunicationLossRecoveryFlzcu1.byte(1) & 0xF0) | nextCounter1;
    SetE2eCrcForFlzcu1Recovery();
    output(gCommunicationLossRecoveryFlzcu1);
    $CAN1::CGW::FLZCU_1::FLZCU_1_RollgCntr = nextCounter1;
  }

  else if(gCommunicationLossBoundarySource == 6)
  {
    gCommunicationLossRecoveryVcuCom10 = gLastVcuCom10;
    nextCounter1 = GetNextAliveCounter(gCommunicationLossRecoveryVcuCom10.byte(1));
    gCommunicationLossRecoveryVcuCom10.byte(1) =
      (gCommunicationLossRecoveryVcuCom10.byte(1) & 0xF0) | nextCounter1;
    SetE2eCrcForVcuCom10Recovery();
    output(gCommunicationLossRecoveryVcuCom10);
    $CAN1::CGW::VCU_COM_10::VCU_10_RollgCntr = nextCounter1;
  }

  SetCommunicationLossBoundaryFault(gCommunicationLossBoundarySource, 0, 0);
  gCommunicationLossBoundaryRecoveryFrameSent = 1;
  TestSupplyTextEvent(gDtcFaultCommLossRecoverySentEvent);
}

on timer gCommunicationLossRecoveryTimer
{
  if(gCommunicationLossBoundaryInjectionActive &&
     HasCommunicationLossBoundarySourceFrame(gCommunicationLossBoundarySource))
    SendCommunicationLossBoundaryRecoveryFrame();
}

void ResetCommunicationLossBoundaryTiming()
{
  cancelTimer(gCommunicationLossRecoveryTimer);
  if((gCommunicationLossBoundarySource >= 0) &&
     (gCommunicationLossBoundarySource != 3))
    SetCommunicationLossBoundaryFault(gCommunicationLossBoundarySource, 0, 0);

  gCommunicationLossBoundaryArm = 0;
  gCommunicationLossBoundaryInjectionActive = 0;
  gCommunicationLossBoundaryRecoveryFrameSent = 0;
  gCommunicationLossBoundarySource = -1;
  gCommunicationLossBoundaryRequestedDurationMs = 0;
  gCommunicationLossBoundaryUnexpectedFrameCount = 0;
  gCommunicationLossBoundaryFirstUnexpectedFrameTimestampMs = 0.0;
}

long SetDlcFaultMessageLength(int messageId)
{
  if(messageId == 0x23B)
    return TestSetMsgDlc(FL_DA_CANFD_RLCR::FLZCU_1,
                                     kDtcDlcFaultValue);
  if(messageId == 0x49D)
    return TestSetMsgDlc(FL_DA_CANFD_RLCR::FLZCU_9,
                                     kDtcDlcFaultValue);
  if(messageId == 0x2AB)
    return TestSetMsgDlc(FL_DA_CANFD_RLCR::FRZCU_1,
                                     kDtcDlcFaultValue);
  if(messageId == 0x2BB)
    return TestSetMsgDlc(FL_DA_CANFD_RLCR::RZCU_2,
                                     kDtcDlcFaultValue);
  if(messageId == 0x098)
    return TestSetMsgDlc(FL_DA_CANFD_RLCR::ONEBOX_1,
                                     kDtcDlcFaultValue);
  if(messageId == 0x22B)
    return TestSetMsgDlc(FL_DA_CANFD_RLCR::ONEBOX_3,
                                     kDtcDlcFaultValue);
  if(messageId == 0x132)
    return TestSetMsgDlc(FL_DA_CANFD_RLCR::SAS_1,
                                     kDtcDlcFaultValue);
  if(messageId == 0x031)
    return TestSetMsgDlc(FL_DA_CANFD_RLCR::ACU_2,
                                     kDtcDlcFaultValue);
  if(messageId == 0x021)
    return TestSetMsgDlc(FL_DA_CANFD_RLCR::ACU_3,
                                     kDtcDlcFaultValue);
  if(messageId == 0x4F7)
    return TestSetMsgDlc(FL_DA_CANFD_RLCR::RRCR_2,
                                     kDtcDlcFaultValue);
  if(messageId == 0x038)
    return TestSetMsgDlc(FL_DA_CANFD_RLCR::VCU_COM_10,
                                     kDtcDlcFaultValue);

  return -100;
}

long ResetDlcFaultMessageLength(int messageId)
{
  if(messageId == 0x23B)
    return TestResetMsgDlc(FL_DA_CANFD_RLCR::FLZCU_1);
  if(messageId == 0x49D)
    return TestResetMsgDlc(FL_DA_CANFD_RLCR::FLZCU_9);
  if(messageId == 0x2AB)
    return TestResetMsgDlc(FL_DA_CANFD_RLCR::FRZCU_1);
  if(messageId == 0x2BB)
    return TestResetMsgDlc(FL_DA_CANFD_RLCR::RZCU_2);
  if(messageId == 0x098)
    return TestResetMsgDlc(FL_DA_CANFD_RLCR::ONEBOX_1);
  if(messageId == 0x22B)
    return TestResetMsgDlc(FL_DA_CANFD_RLCR::ONEBOX_3);
  if(messageId == 0x132)
    return TestResetMsgDlc(FL_DA_CANFD_RLCR::SAS_1);
  if(messageId == 0x031)
    return TestResetMsgDlc(FL_DA_CANFD_RLCR::ACU_2);
  if(messageId == 0x021)
    return TestResetMsgDlc(FL_DA_CANFD_RLCR::ACU_3);
  if(messageId == 0x4F7)
    return TestResetMsgDlc(FL_DA_CANFD_RLCR::RRCR_2);
  if(messageId == 0x038)
    return TestResetMsgDlc(FL_DA_CANFD_RLCR::VCU_COM_10);

  return -100;
}

void ResetDlcFaultFrameSequence()
{
  int retry;
  long resetResult;

  gDlcFaultFrameSequenceActive = 0;
  resetResult = 0;
  if(gDlcFaultFrameSequenceMessageId != 0)
  {
    resetResult = ResetDlcFaultMessageLength(
      gDlcFaultFrameSequenceMessageId);
    for(retry = 0; (resetResult == -1) && (retry < 10); retry++)
    {
      testWaitForTimeout(1);
      resetResult = ResetDlcFaultMessageLength(
        gDlcFaultFrameSequenceMessageId);
    }
  }

  gDlcFaultFrameSequenceResetResult = resetResult;
  if(resetResult == 0)
    gDlcFaultFrameSequenceMessageId = 0;
  gDlcFaultFrameSequenceObservedCount = 0;
  gDlcFaultFrameSequenceComplete = 0;
}

void ObserveDlcFaultFrame(int messageId, int receivedDlc)
{
  if((!gDlcFaultFrameSequenceActive) ||
     (gDlcFaultFrameSequenceMessageId != messageId) ||
     (receivedDlc != kDtcDlcFaultValue))
    return;

  gDlcFaultFrameSequenceObservedCount++;
  if(gDlcFaultFrameSequenceObservedCount < kDtcInvalidFrameCount)
    return;


  gDlcFaultFrameSequenceActive = 0;
  gDlcFaultFrameSequenceComplete = 1;
  TestSupplyTextEvent(gDtcFaultDlcFrameSequenceCompleteEvent);
}

int StartDlcFaultFrameSequence(int messageId)
{
  long setResult;

  ResetDlcFaultFrameSequence();
  if(gDlcFaultFrameSequenceResetResult != 0)
  {
    testStepFail("DLC故障清理",
                 "上一条DLC故障的原始DLC恢复失败，结果=%ld。",
                 gDlcFaultFrameSequenceResetResult);
    return 0;
  }

  gDlcFaultFrameSequenceMessageId = messageId;
  gDlcFaultFrameSequenceObservedCount = 0;
  gDlcFaultFrameSequenceComplete = 0;
  gDlcFaultFrameSequenceActive = 1;
  setResult = SetDlcFaultMessageLength(messageId);
  if(setResult != 0)
  {
    gDlcFaultFrameSequenceActive = 0;
    ResetDlcFaultFrameSequence();
    testStepFail("DLC故障注入",
                 "报文0x%03X的DLC覆盖失败，结果=%ld。",
                 messageId, setResult);
    return 0;
  }

  return 1;
}

int WaitForDlcFaultFrameSequence(int cycleMs, char messageName[])
{
  int timeoutMs;
  int observedCount;

  timeoutMs = (cycleMs * (kDtcInvalidFrameCount + 2)) + 100;
  if(!gDlcFaultFrameSequenceComplete)
    testWaitForTextEvent(gDtcFaultDlcFrameSequenceCompleteEvent, timeoutMs);

  if(gDlcFaultFrameSequenceObservedCount < kDtcInvalidFrameCount)
  {
    observedCount = gDlcFaultFrameSequenceObservedCount;
    gDlcFaultFrameSequenceActive = 0;
    ResetDlcFaultFrameSequence();
    if(gDlcFaultFrameSequenceResetResult != 0)
      testStepFail("DLC故障恢复", "%s超时后恢复原DLC失败，结果=%ld。",
                   messageName, gDlcFaultFrameSequenceResetResult);
    testStepFail("DLC故障注入",
                 "%s在%d ms内仅收到%d/%d帧DLC=7报文。",
                 messageName, timeoutMs, observedCount,
                 kDtcInvalidFrameCount);
    return 0;
  }

  testStepPass("故障注入", "%s已按原周期收到10帧DLC=7报文。",
               messageName);
  return 1;
}

// ===== 诊断请求、原始报文准备与用例清理 =====
// 统一把诊断服务返回值转换为测试步骤结果，避免各用例重复处理。
void ReportDiagResult(char stepName[], enum DiagResult actualResult)
{
  if(actualResult == DiagOK)
  {
    testStepPass(stepName, "诊断响应为肯定响应。");
  }
  else
  {
    testStepFail(stepName, "诊断请求失败，结果=%d。", actualResult);
  }
}

enum DiagResult EnterDefaultSession(enum AddressMode addressMode)
{
  enum DiagResult result;

  result = Service10_SessionControl(addressMode, DefaultSession, SuppressBitOff);
  ReportDiagResult("进入默认会话", result);
  return result;
}

enum DiagResult EnterExtendedSession(enum AddressMode addressMode)
{
  enum DiagResult result;

  result = Service10_SessionControl(addressMode, ExtendedSession, SuppressBitOff);
  ReportDiagResult("进入扩展会话", result);
  return result;
}

int HexNibble(char character)
{
  if((character >= '0') && (character <= '9'))
    return character - '0';

  if((character >= 'A') && (character <= 'F'))
    return character - 'A' + 10;

  if((character >= 'a') && (character <= 'f'))
    return character - 'a' + 10;

  return -1;
}

// 将手工UDS用例的十六进制字符串解析为字节；掩码数组用于支持通配匹配。
int DecodeHexBytes(char hexText[], byte bytes[], byte masks[])
{
  int textIndex;
  int byteCount;
  int highNibble;
  int lowNibble;

  textIndex = 0;
  byteCount = 0;

  while(hexText[textIndex] != 0)
  {
    while((hexText[textIndex] == ' ') || (hexText[textIndex] == '\t'))
      textIndex++;

    if(hexText[textIndex] == 0)
      break;

    if((hexText[textIndex] == 'x') || (hexText[textIndex] == 'X'))
    {
      if((hexText[textIndex + 1] != 'x') && (hexText[textIndex + 1] != 'X'))
        return -1;

      bytes[byteCount] = 0;
      masks[byteCount] = 0;
      byteCount++;
      textIndex += 2;
      continue;
    }

    highNibble = HexNibble(hexText[textIndex]);
    lowNibble = HexNibble(hexText[textIndex + 1]);
    if((highNibble < 0) || (lowNibble < 0))
      return -1;

    bytes[byteCount] = (highNibble << 4) | lowNibble;
    masks[byteCount] = 0xFF;
    byteCount++;
    textIndex += 2;
  }

  return byteCount;
}





// 0x27解锁：读取Seed后调用工程DLL计算Key，再发送Key请求，不在脚本中固化算法。
enum DiagResult UnlockWithProjectDll(byte seedSubFunction, dword dllSecurityLevel)
{
  byte seed[64];
  byte keyBytes[64];
  byte index;
  dword keyLength;
  int seedLength;
  char variant[1];
  char option[1];
  enum DiagResult result;

  variant[0] = 0;
  option[0] = 0;
  diagSetTarget("T1V_G_RLCR");
  result = Service27_SecurityAccessSeed(PhysicalAddress, seedSubFunction, seed, elcount(seed));
  if(result != DiagOK)
    return result;

  seedLength = DiagRxDataLen - 2;
  if((seedLength <= 0) || (seedLength > elcount(seed)))
  {
    testStepFail("安全访问种子", "种子长度无效：%d。", seedLength);
    return DiagGeneralError;
  }

  for(index = 0; index < seedLength; index++)
    seed[index] = DiagRxData[index + 2];

  keyLength = 0;
  DiagGenerateKeyFromSeed(seed, seedLength, dllSecurityLevel, variant, option,
                          keyBytes, elcount(keyBytes), keyLength);
  if((keyLength <= 0) || (keyLength > elcount(keyBytes)))
  {
    testStepFail("安全访问密钥", "DLL未返回有效密钥，长度=%d。", keyLength);
    return DiagGeneralError;
  }

  return Service27_SecurityAccessKey(PhysicalAddress, seedSubFunction, keyBytes, keyLength);
}

