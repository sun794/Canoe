testcase NM_TC14_NetworkWakeupResponse()
{
  InitReportAndLog("NM_Test_report");
  StartToLogging();
  float firstFrameMs;
  dword wakeupTimestamp;

  testCaseTitle("T1V-C-NM-TC14", "网络唤醒响应时间");
  NmEnterPbsm();
  StartDutObservation();
  wakeupTimestamp = timeNow();
  NmStartPduSimulation(kNmPduSimulationCycleMs);
  testWaitForTimeout(kWakeupAllFramesLimitMs + 100);
  NmStopPduSimulation();
  StopDutObservation();

  if(gDutFirstFrameTimestamp == 0)
  {
    testStepFail("唤醒首帧", "NM 唤醒后未观测到 DUT 报文。");
    StopToLogging();
    return;
  }

  firstFrameMs = NmElapsedMs(wakeupTimestamp, gDutFirstFrameTimestamp);
  if(firstFrameMs > kWakeupFirstFrameLimitMs)
    testStepFail("唤醒首帧", "DUT 首帧响应=%.1f ms；限制=%d ms。",
                 firstFrameMs, kWakeupFirstFrameLimitMs);
  else
    testStepPass("唤醒首帧", "DUT 首帧响应=%.1f ms。", firstFrameMs);

  CheckNmAndAppsPresent("唤醒后的全部周期报文");
  CheckDutNmState("网络唤醒 RMS 0x63F 状态位", 0, 1, 0, 0, 0, 0, 0);
  if((gDutFirstNmTimestamp == 0) ||
     (gDutFirstApp1Timestamp == 0) ||
     (gDutFirstApp2Timestamp == 0) ||
     (NmElapsedMs(wakeupTimestamp, gDutFirstNmTimestamp) > kWakeupAllFramesLimitMs) ||
     (NmElapsedMs(wakeupTimestamp, gDutFirstApp1Timestamp) > kWakeupAllFramesLimitMs) ||
     (NmElapsedMs(wakeupTimestamp, gDutFirstApp2Timestamp) > kWakeupAllFramesLimitMs))
  {
    testStepFail("唤醒报文时限",
                 "NMm_RLCR、RLCR_1 和 RLCR_2 均须在 %d ms 内出现。",
                 kWakeupAllFramesLimitMs);
  }
  else
  {
    testStepPass("唤醒报文时限",
                 "NMm_RLCR、RLCR_1 和 RLCR_2 均已在 %d ms 内出现。",
                 kWakeupAllFramesLimitMs);
  }
  StopToLogging();
}

testcase NM_TC15_InvalidWakeupRejected()
{
  InitReportAndLog("NM_Test_report");
