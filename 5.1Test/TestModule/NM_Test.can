  testStep("PBSM 唤醒抑制", "依次发送诊断保持报文和 PowerMode=ON。");

  StartDutObservation();
  NmSendTesterPresentFrame();
  testWaitForTimeout(kInvalidWakeupObservationMs);
  NmStartPowerModeSimulation(kPowerModeOn);
  testWaitForTimeout(kInvalidWakeupObservationMs);
  StopDutObservation();

  if(GetDutOutputCount() != 0)
    testStepFail("PBSM 唤醒抑制",
                 "PBSM 下诊断或 PowerMode ON 意外唤醒了 DUT。");
  else
    testStepPass("PBSM 唤醒抑制",
                 "PBSM 下发送诊断保持报文和 PowerMode=ON 后，未检测到 DUT 报文输出。");

  NmRestoreSleepStimulus();
  StopToLogging();
}

