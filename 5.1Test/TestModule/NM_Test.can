testcase NM_TC23_RmrHandling()
{
  InitReportAndLog("NM_Test_report");
  StartToLogging();
  testCaseTitle("T1V-C-NM-TC23", "RMR=1处理");

  if((kNmPduRmrByteIndex < 0) || (kNmPduRmrMask == 0))
  {
    testStepWarning("需要人工配置",
                    "执行 TC23 前，请依据已发布的 NM_PDU 定义配置 kNmPduRmrByteIndex 和 kNmPduRmrMask。");
    StopToLogging();
    return;
  }

  NmEnterPbsm();
  gNmPduRmrEnabled = 1;
  StartDutObservation();
  NmSendTwoPduFrames();
  testWaitForTimeout(kRmsDurationMs + 500);
  StopDutObservation();
  gNmPduRmrEnabled = 0;

  if(GetDutOutputCount() != 0)
    testStepFail("RMR 处理", "发送 RMR=1 后 DUT 进入了 RMS。");
  else
    testStepPass("RMR 处理", "发送 RMR=1 后未检测到 DUT 报文输出。");
  StopToLogging();
}

