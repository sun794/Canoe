  testCaseTitle("T1V-C-NM-TC18", "PowerMode ON网络保持");
  NmEnterPbsm();
  NmStartPowerModeSimulationWithCycle(kPowerModeOff, kPowerModeKeepAliveCycleMs);
  StartDutObservation();
  nmWakeupTimestamp = timeNow();
  NmSendTwoPduFrames();
  testWaitForTimeout(kRmsStimulusDelayMs);
  powerModeOnTimestamp = timeNow();
  NmSetPowerMode(kPowerModeOn);
  CheckRmsStimulusTiming("PowerMode ON 保持 RMS 时限", nmWakeupTimestamp, powerModeOnTimestamp);
  testWaitForTimeout(4000);
  StopDutObservation();
  CheckNmAndAppsPresent("PowerMode 网络保持报文输出");
  CheckDutNmCycle("PowerMode 网络保持 NM 周期", 4);
  CheckDutNmState("PowerMode 保持 NOS 0x63F 状态位", 0, 1, 0, 0, 1, 0, 0);
  NmRestoreSleepStimulus();
  StopToLogging();
}

testcase NM_TC19_Dow210SecondHold()
{
  InitReportAndLog("NM_Test_report");
  StartToLogging();
  dword powerModeOffTimestamp;

  testCaseTitle("T1V-C-NM-TC19", "DOW 210秒保持后进入总线休眠");
  NmEnterPbsm();
  NmStartPowerModeSimulation(kPowerModeOn);
  NmStartPduSimulation(kNmPduSimulationCycleMs);
  testWaitForTimeout(300);

  StartDutObservation();
  powerModeOffTimestamp = timeNow();
  NmSetPowerMode(kPowerModeOff);
  testWaitForTimeout(kNmStateObservationMs);
  StopDutObservation();
  CheckDutNmState("DOW RMS 0x63F 状态位", 0, 1, 0, 0, 0, 0, 1);

  StartDutObservation();
  testWaitForTimeout(kRmsDurationMs + 300);
  StopDutObservation();
  CheckDutNmState("DOW NOS 0x63F 状态位", 0, 1, 0, 0, 0, 0, 1);

  StartDutObservation();
  testStep("DOW 保持", "PowerMode ON->OFF 后观测 0x63F 保持 %d ms。", kDowHoldDurationMs);
  testWaitForTimeout(kDowHoldDurationMs - kRmsDurationMs - 300 + kDowHoldToleranceMs);
  StopDutObservation();
  CheckDutNmCycle("DOW 保持 NM 周期", 200);
  CheckDutNmState("DOW 保持阶段 0x63F 状态位", 0, 1, 0, 0, 0, 0, 1);
  CheckDutNmHoldDuration("DOW 0x63F 保持时长", powerModeOffTimestamp, kDowHoldDurationMs);

  NmStopPduSimulation();
  testWaitForTimeout(kRssToPbsmDurationMs + 300);
  CheckNoDutOutput("DOW 后总线休眠结果", 800);
  StopToLogging();
}
testcase NM_TC20_NmUserData()
{
  InitReportAndLog("NM_Test_report");
  StartToLogging();
  testCaseTitle("T1V-C-NM-TC20", "0x63F用户数据状态位");
  NmEnterPbsm();
  NmStartPowerModeSimulation(kPowerModeOff);

  StartDutObservation();
  NmSendTwoPduFrames();
  testWaitForTimeout(800);
  StopDutObservation();
  CheckDutNmState("RMS 用户数据", 0, 1, 0, 0, 0, 0, 0);

  StartDutObservation();
  NmSendTesterPresentFrame();
  testWaitForTimeout(800);
  StopDutObservation();
  CheckDutNmState("NOS 诊断用户数据", 0, 1, 0, 0, 0, 1, 0);

  StartDutObservation();
  NmSetPowerMode(kPowerModeOn);
  testWaitForTimeout(800);
  StopDutObservation();
  CheckDutNmState("PowerMode RMS 用户数据", 0, 1, 0, 0, 1, 0, 0);

  StartDutObservation();
  testWaitForTimeout(kRmsDurationMs + 300);
  StopDutObservation();
  CheckDutNmState("PowerMode NOS 用户数据", 0, 1, 0, 0, 1, 0, 0);

  StartDutObservation();
  NmSetPowerMode(kPowerModeOff);
  testWaitForTimeout(800);
  StopDutObservation();
  CheckDutNmState("DOW RMS 用户数据", 0, 1, 0, 0, 0, 0, 1);

  StartDutObservation();
  testWaitForTimeout(kRmsDurationMs + 300);
  StopDutObservation();
  CheckDutNmState("DOW NOS 用户数据", 0, 1, 0, 0, 0, 0, 1);
  NmRestoreSleepStimulus();
  StopToLogging();
}

