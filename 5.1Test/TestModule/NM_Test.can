testcase NM_TC06_NosToRssByDow()
{
  InitReportAndLog("NM_Test_report");
  StartToLogging();
  dword powerModeOffTimestamp;

  testCaseTitle("T1V-C-NM-TC6", "NOS到RSS: DOW 210秒保持");
  NmEnterPbsm();
  NmStartPowerModeSimulation(kPowerModeOn);
  NmStartPduSimulation(kNmPduSimulationCycleMs);
  testWaitForTimeout(300);

  StartDutObservation();
  powerModeOffTimestamp = timeNow();
  NmSetPowerMode(kPowerModeOff);
  testWaitForTimeout(kNmStateObservationMs);
  StopDutObservation();
  CheckDutNmState("DOW RMS 0x63F 状态位", 0, 1, 0, 0, 0, 0, 1);

  StartDutObservation();
  testWaitForTimeout(kRmsDurationMs + 300);
  StopDutObservation();
  CheckDutNmState("DOW NOS 0x63F 状态位", 0, 1, 0, 0, 0, 0, 1);

  StartDutObservation();
  testStep("DOW 保持", "PowerMode ON->OFF 后观测 0x63F 保持 %d ms。", kDowHoldDurationMs);
  testWaitForTimeout(kDowHoldDurationMs - kRmsDurationMs - 300 + kDowHoldToleranceMs);
  StopDutObservation();
  CheckDutNmCycle("DOW 保持 NM 周期", 200);
  CheckDutNmState("DOW 保持阶段 0x63F 状态位", 0, 1, 0, 0, 0, 0, 1);
  CheckDutNmHoldDuration("DOW 0x63F 保持时长", powerModeOffTimestamp, kDowHoldDurationMs);

  NmStopPduSimulation();
  StartDutObservation();
  testWaitForTimeout(kDutNmCycleMs + 200);
  StopDutObservation();
  CheckNmStoppedAppContinues("DOW RSS 结果");
  StopToLogging();
}
testcase NM_TC07_RmsTimeoutDiagHold()
{
  InitReportAndLog("NM_Test_report");
  StartToLogging();
  dword nmStartTimestamp;
  float firstNmElapsedMs;

  testCaseTitle("T1V-C-NM-TC7-1", "RMS超时后诊断保持");
  NmEnterPbsm();

  StartDutObservation();
  testStep("NM 唤醒发送",
           "周期发送 0x601（周期 %d ms）唤醒雷达；检测到首帧 0x63F 后立即停止。",
           kTc7NmPduSimulationCycleMs);
  nmStartTimestamp = timeNow();
  NmStartPduSimulation(kTc7NmPduSimulationCycleMs);
  if(!WaitForFirstDutNmFrame(kWakeupAllFramesLimitMs))
  {
    NmStopPduSimulation();
    StopDutObservation();
    testStepFail("RMS 进入",
                 "周期发送 0x601 后 %d ms 内未检测到 0x63F。",
                 kWakeupAllFramesLimitMs);
    StopToLogging();
    return;
  }

  NmStopPduSimulation();
  firstNmElapsedMs = NmElapsedMs(nmStartTimestamp, gDutFirstNmTimestamp);
  testStepPass("停止 0x601",
               "检测到首帧 0x63F，响应时间=%.1f ms；0x601 仅作为唤醒源，现已停止。",
               firstNmElapsedMs);

  testStep("RMS 阶段",
           "停止 0x601 后观察 RMS %d ms，确认 0x63F 持续发送。",
           kRmsDurationMs);
  testWaitForTimeout(kRmsDurationMs);
  StopDutObservation();
  CheckFirstDutFrameIsNm("RMS 首帧响应");
  CheckDutNmCycle("RMS NM 周期", 4);
  CheckDutNmSpan("RMS 0x63F 持续时长", kRmsDurationMs);
  CheckDutNmState("RMS 0x63F 标志位", 0, 1, 0, 0, 0, 0, 0);

  StartDutObservation();
  testStep("RMS 超时 RSS",
           "RMS 超时后观察 %d ms；不应发送 0x63F，0x447/0x450 应继续发送。",
           kNmStateObservationMs);
  testWaitForTimeout(kNmStateObservationMs);
  StopDutObservation();
  CheckNmStoppedAppContinues("RMS 超时后报文输出");

  StartDutObservation();
  testStep("诊断保持",
           "RSS 状态发送 0x3E 00，诊断保持 %d ms；延长 %d ms 采集第 7 帧 0x63F。",
           kDiagnosticHoldDurationMs, kDiagnosticHoldCaptureMarginMs);
  NmSendTesterPresentFrame();
  testWaitForTimeout(kDiagnosticHoldDurationMs + kDiagnosticHoldCaptureMarginMs);
  StopDutObservation();
  CheckNmAndAppsPresent("诊断保持报文输出");
  CheckDutNmCycle("诊断保持 NM 周期", 7);
  CheckDutNmState("诊断保持 0x63F 标志位", 0, 0, 0, 0, 0, 1, 0);

  StartDutObservation();
  testStep("诊断超时 RSS",
           "诊断保持超时后观察 %d ms；不应发送 0x63F，0x447/0x450 应继续发送。",
           kNmStateObservationMs);
  testWaitForTimeout(kNmStateObservationMs);
  StopDutObservation();
  CheckNmStoppedAppContinues("诊断超时后报文输出");
  StopToLogging();
}

