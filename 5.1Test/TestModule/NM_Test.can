}

testcase NM_TC09_RssToPbsm()
{
  InitReportAndLog("NM_Test_report");
  StartToLogging();
  dword nmStartTimestamp;
  dword rmsLastNmTimestamp;
  dword rssLastAppTimestamp;
  float firstNmElapsedMs;

  testCaseTitle("T1V-C-NM-TC9", "RSS到PBSM: 0x601触发后自然休眠");
  NmStopAllStimuli();
  testStepPass("发送源预置",
               "已停止本脚本控制的全部发送源；本用例不发送 0x49D。");

  StartDutObservation();
  testStep("NM 周期发送",
           "周期发送 0x601（周期 %d ms），检测到雷达进入 RMS 后立即停止发送。",
           kNmPduSimulationCycleMs);
  nmStartTimestamp = timeNow();
  NmStartPduSimulation(kNmPduSimulationCycleMs);
  if(!WaitForFirstDutNmFrame(kWakeupAllFramesLimitMs))
  {
    NmStopPduSimulation();
    StopDutObservation();
    testStepFail("RMS 进入", "周期发送 0x601 后 %d ms 内未检测到 0x63F。",
                 kWakeupAllFramesLimitMs);
    StopToLogging();
    return;
  }

  NmStopPduSimulation();
  firstNmElapsedMs = NmElapsedMs(nmStartTimestamp, gDutFirstNmTimestamp);
  testStepPass("停止 0x601",
               "检测到首帧 0x63F，响应时间=%.1f ms；已停止周期发送 0x601。",
               firstNmElapsedMs);

  testStep("RMS 阶段",
           "停止 0x601 后观察约 %d ms；0x63F 应持续发送。",
           kRmsDurationMs);
  testWaitForTimeout(kRmsDurationMs);
  StopDutObservation();
  CheckFirstDutFrameIsNm("RMS 首帧响应");
  CheckDutNmCycle("RMS NM 周期", 4);
  CheckDutNmSpan("RMS 0x63F 持续时长", kRmsDurationMs);
  CheckDutNmState("RMS NM 0x63F 状态位", 0, 1, 0, 0, 0, 0, 0);
  rmsLastNmTimestamp = gDutLastNmTimestamp;

  StartDutObservation();
  testStep("RSS 阶段",
           "RMS 超时后观察约 %d ms；0x63F 应停止，0x447/0x450 应继续发送。",
           kRssToPbsmDurationMs);
  testWaitForTimeout(kRssToPbsmDurationMs);
  StopDutObservation();
  CheckNmStoppedAppContinues("RSS 报文输出");
  rssLastAppTimestamp = gDutLastAppTimestamp;
  CheckNmToAppTailByTimestamp("RSS 到 PBSM 时序",
                              rmsLastNmTimestamp,
                              rssLastAppTimestamp);

  CheckNoDutOutput("PBSM 状态确认", 600);
  StopToLogging();
}

