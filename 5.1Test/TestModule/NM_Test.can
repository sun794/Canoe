  else
    testStepPass("无效唤醒拒绝", "发送两帧 0x%03X 后未检测到 DUT 报文输出。", kInvalidWakeupCanId);
  StopToLogging();
}

testcase NM_TC16_ValidWakeupAfterInvalid()
{
  InitReportAndLog("NM_Test_report");
  StartToLogging();
  testCaseTitle("T1V-C-NM-TC16", "无效事件后有效NM唤醒");
  NmEnterPbsm();
  StartDutObservation();
  NmSendTwoInvalidWakeupFrames();
  testWaitForTimeout(kInvalidWakeupObservationMs);
  StopDutObservation();
  if(GetDutOutputCount() != 0)
    testStepFail("无效唤醒阶段", "有效 NM 唤醒前已出现 DUT 报文输出。");
  else
    testStepPass("无效唤醒阶段", "无效报文后 DUT 保持休眠。");

  StartDutObservation();
  NmSendPduFrame();
  testWaitForTimeout(kRmsDurationMs + 500);
  StopDutObservation();
  CheckFirstDutFrameIsNm("有效唤醒首帧响应");
  CheckDutNmCycle("有效唤醒 RMS NM 周期", 4);
  CheckDutNmState("有效唤醒 RMS 0x63F 状态位", 0, 1, 0, 0, 0, 0, 0);
  StopToLogging();
}

testcase NM_TC17_DiagnosticNetworkKeepAlive()
{
  InitReportAndLog("NM_Test_report");
