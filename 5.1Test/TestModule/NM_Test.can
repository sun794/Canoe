testcase NM_TC11_PbsmToRmsByNm()
{
  InitReportAndLog("NM_Test_report");
  StartToLogging();
  testCaseTitle("T1V-C-NM-TC11", "PBSM到RMS: 两帧0x601唤醒");
  NmEnterPbsm();
  StartDutObservation();
  NmSendTwoPduFrames();
  testWaitForTimeout(kRmsDurationMs + 500);
  StopDutObservation();
  CheckFirstDutFrameIsNm("首帧响应");
  CheckDutNmCycle("PBSM 唤醒 NM 周期", 4);
  CheckDutNmSpan("PBSM 唤醒 NM 首末帧间隔", kRmsDurationMs);
  CheckDutNmState("PBSM 唤醒 RMS 0x63F 状态位", 0, 1, 0, 0, 0, 0, 0);
  StopToLogging();
}

testcase NM_TC12_PbsmDiagAndPowerModeNoWake()
{
  InitReportAndLog("NM_Test_report");
  StartToLogging();
  testCaseTitle("T1V-C-NM-TC12", "PBSM下诊断和PowerMode ON不唤醒");
