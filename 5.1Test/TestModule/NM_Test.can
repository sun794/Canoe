  CheckDutNmCycle("诊断网络保持 NM 周期", 4);
  CheckDutNmState("诊断保持 NOS 0x63F 状态位", 0, 1, 0, 0, 0, 1, 0);
  StopToLogging();
}

testcase NM_TC18_PowerModeNetworkKeepAlive()
{
  InitReportAndLog("NM_Test_report");
