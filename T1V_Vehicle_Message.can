//以下部分实现counter 进行0~14的累加

byte E2E_Counter(byte data[],byte c_pos)
{
    int Counter;       
    Counter = data[c_pos] & 0x0F;
    Counter++;
    if(Counter > 14)
      Counter = Counter - 15;
    Counter = (data[c_pos] & 0xF0)+ Counter;
    return  Counter;
}

//奇瑞 Checksum 算法
byte E2E_CRC8(byte buffer[], byte length)
{ 
  byte checksum,i,j;
  byte CRC8_Poly = 0x1D;
  checksum = 0x00;
  CRC8_Poly = 0x1D;
  for(i=0; i<length; i++)
  {
    checksum = checksum ^ buffer[i];
    for( j=0; j<8; j++ )
    {
      if(checksum & 0x80)
      {
        checksum = ((checksum << 1) ^ CRC8_Poly); 
      }
      else
      {
        checksum = (checksum << 1);
      }
    }
  }
  checksum = checksum ^ 0x00;
  return checksum;
}

word ssh_crc16_cheery(byte buffer[], byte length)
{
  word wCRCin;
  word wCPoly=0x1021;
  dword i,j;
  byte wChar = 0; 
  j=0;
  wCRCin=gc_dwCRC16InitValue;
  
  while(length--) 
  {
    wChar =buffer[j++]; 
    wCRCin ^= (wChar << 8); 
    for(i = 0; i < 8; i++) 
    { 
      if(wCRCin & 0x8000) 
      { 
        wCRCin = (wCRCin << 1) ^ wCPoly; 
      } 
      else 
      { 
        wCRCin = wCRCin << 1; 
      } 
    } 
  }
  wCRCin=wCRCin ^ 0x0000;
  return wCRCin;
}

//以下代码是检查雷达外发的CRC是否正确
on message RLCR_1
{
  int i;
  byte MSG_RawData[64];
  MSG_RawData[0]=0x44;
  MSG_RawData[1]=0x00;
  for (i = 0; i < 8; i++)
  {
    MSG_RawData[i+2] = this.byte(i+1);   
  }
  @sysvar::Vehicle_input::Message_CRC::RLCR_1_0x447 = E2E_CRC8(MSG_RawData,9);
  if (this.byte(0) == (@sysvar::Vehicle_input::Message_CRC::RLCR_1_0x447))
  {
    @sysvar::Vehicle_input::MSG::RLCR_1_0x447 = 1;
  }
  else 
  {
    @sysvar::Vehicle_input::MSG::RLCR_1_0x447 = 0;
  }
}

on message RLCR_2
{
  int i;
  byte MSG_RawData[64];
  MSG_RawData[0]=0x45;
  MSG_RawData[1]=0x00;
  for (i = 0; i < 8; i++)
  {
    MSG_RawData[i+2] = this.byte(i+1);   
  }
  @sysvar::Vehicle_input::Message_CRC::RLCR_2_0x450 = E2E_CRC8(MSG_RawData,9);
  if (this.byte(0) == (@sysvar::Vehicle_input::Message_CRC::RLCR_2_0x450))
  {
    @sysvar::Vehicle_input::MSG::RLCR_2_0x450 = 1;
  }
  else 
  {
    @sysvar::Vehicle_input::MSG::RLCR_2_0x450 = 0;
  }
}

