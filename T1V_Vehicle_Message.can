////以下是节点控制报文
on sysvar_update sysvar::Vehicle_input::Node::CGW
{
  long node;
  if (@this == 1)
  {
    node = ILControlStop();//停止发送该节点报文
  }
  else
  {
    node = ILControlStart();//开始发送该节点报文
  }
}


on sysvar_update sysvar::Vehicle_input::MSG::RRCR_2_0x4F7
{
  if(@this == 1)
  {
    SetMessageFaultInjectionState(kMessageFaultRRCR2, 1);
    setTimer(RRCR_2_0x4F7,@sysvar::Vehicle_input::Message_MissingTime::RRCR_2_0x4F7);
  }
  else
  {
    SetMessageFaultInjectionState(kMessageFaultRRCR2, 0);
  } 
}


