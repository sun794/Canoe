// Repeated MSG writes must not restart an already-enabled cyclic sender.
void SetMessageFaultInjectionState(int messageSource, int disabled)
{
  if((messageSource < 0) || (messageSource >= elcount(gMessageFaultInjectionDisabled)) ||
     (gMessageFaultInjectionDisabled[messageSource] == disabled))
    return;

  switch(messageSource)
  {
    case kMessageFaultONEBOX1:
      if(disabled) ILFaultInjectionDisableMsg(ONEBOX_1);
      else ILFaultInjectionEnableMsg(ONEBOX_1);
      break;
    case kMessageFaultACU2:
      if(disabled) ILFaultInjectionDisableMsg(ACU_2);
      else ILFaultInjectionEnableMsg(ACU_2);
      break;
    case kMessageFaultACU3:
      if(disabled) ILFaultInjectionDisableMsg(ACU_3);
      else ILFaultInjectionEnableMsg(ACU_3);
      break;
    case kMessageFaultFLZCU1:
      if(disabled) ILFaultInjectionDisableMsg(FLZCU_1);
      else ILFaultInjectionEnableMsg(FLZCU_1);
      break;
    case kMessageFaultFLZCU9:
      if(disabled) ILFaultInjectionDisableMsg(FLZCU_9);
      else ILFaultInjectionEnableMsg(FLZCU_9);
      break;
    case kMessageFaultFRZCU1:
      if(disabled) ILFaultInjectionDisableMsg(FRZCU_1);
      else ILFaultInjectionEnableMsg(FRZCU_1);
      break;
    case kMessageFaultRZCU2:
      if(disabled) ILFaultInjectionDisableMsg(RZCU_2);
      else ILFaultInjectionEnableMsg(RZCU_2);
      break;
    case kMessageFaultICC_COM8:
      if(disabled) ILFaultInjectionDisableMsg(ICC_COM_8);
      else ILFaultInjectionEnableMsg(ICC_COM_8);
      break;
    case kMessageFaultONEBOX3:
      if(disabled) ILFaultInjectionDisableMsg(ONEBOX_3);
      else ILFaultInjectionEnableMsg(ONEBOX_3);
      break;
    case kMessageFaultONEBOX4:
      if(disabled) ILFaultInjectionDisableMsg(ONEBOX_4);
      else ILFaultInjectionEnableMsg(ONEBOX_4);
      break;
    case kMessageFaultSAS1:
      if(disabled) ILFaultInjectionDisableMsg(SAS_1);
      else ILFaultInjectionEnableMsg(SAS_1);
      break;
    case kMessageFaultTMS1:
      if(disabled) ILFaultInjectionDisableMsg(TMS_1);
      else ILFaultInjectionEnableMsg(TMS_1);
      break;
    case kMessageFaultVCU2_G:
      if(disabled) ILFaultInjectionDisableMsg(VCU_2_G);
      else ILFaultInjectionEnableMsg(VCU_2_G);
      break;
    case kMessageFaultVCU_COM10:
      if(disabled) ILFaultInjectionDisableMsg(VCU_COM_10);
      else ILFaultInjectionEnableMsg(VCU_COM_10);
      break;
    case kMessageFaultVCU_ONEBOX11:
      if(disabled) ILFaultInjectionDisableMsg(VCU_ONEBOX_11);
      else ILFaultInjectionEnableMsg(VCU_ONEBOX_11);
      break;
    case kMessageFaultRRCR2:
      if(disabled) ILFaultInjectionDisableMsg(RRCR_2);
      else ILFaultInjectionEnableMsg(RRCR_2);
      break;
  }

  gMessageFaultInjectionDisabled[messageSource] = disabled;
}

// CRC偏移非零时，按配置的帧数发送故障；达到阈值后下一帧恢复正常CRC。
int CompleteCrcFaultCycle(int crcOffset, int crcSource)
{
  if((crcOffset == 0) ||
     (@sysvar::Vehicle_input::Message_CRC::CRC_unchange <= 0))
  {
    gCrcFaultCycleCounter[crcSource] = 0;
    return 0;
  }

  gCrcFaultCycleCounter[crcSource]++;
  if(gCrcFaultCycleCounter[crcSource] >=
     @sysvar::Vehicle_input::Message_CRC::CRC_unchange)
  {
    gCrcFaultCycleCounter[crcSource] = 0;
    return 1;
  }

  return 0;
}


on timer Gettime{
  InitReportAndLog();
}

//在函数内部完成所有操作
void InitReportAndLog()
{
  long tm[9];
  getLocalTime(tm);
  //正确赋值到变量（确保时间在合理范围）
  $CAN1::CGW::ICC_COM_8::CurrentTimeYear = tm[5]+1900; // 年（如2025）
  $CAN1::CGW::ICC_COM_8::CurrentTimeMonth = tm[4]+1; // 月（1-12）
  $CAN1::CGW::ICC_COM_8::CurrentTimeDay = tm[3];    // 日（1-31）
  $CAN1::CGW::ICC_COM_8::CurrentTimeHour = tm[2];   // 时（0-23）
  $CAN1::CGW::ICC_COM_8::CurrentTimeMinute = tm[1]; // 分（0-59）
  $CAN1::CGW::ICC_COM_8::CurrentTimeSecond = tm[0]; // 秒（0-59） 
  setTimer(Gettime,1000);
  //write("%d_%02d_%02d_%02d_%02d_%02d",tm[5]+1900,tm[4]+1,tm[3],tm[2],tm[1],tm[0]);
  
}




on Start
{
  InitReportAndLog();
//  $CAN1::CGW::FLZCU_9::FLZCU_9_PowerMode=2;
  $CAN1::CGW::SAS_1::SAM_1_SteeringAngle=0;
  $CAN1::CGW::ACU_2::ACU_2_YawRate=0;
  $CAN1::CGW::TMS_1::ExternalTemperature_C=20;
  
}

